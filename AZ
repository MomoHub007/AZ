    function RuntimeFix.monarchListen(packets)
        local state = RuntimeFix.Monarch
        if state.Listening then
            return
        end

        local function connect(packet, callback)
            local disconnect = packet:on(function(result)
                if not AutoFarmSession.Cancelled then
                    callback(result)
                end
            end)

            table.insert(AutoFarmSession.Cleanups, function()
                if typeof(disconnect) == "function" then
                    disconnect()
                elseif typeof(disconnect) == "RBXScriptConnection" then
                    disconnect:Disconnect()
                end
            end)
        end

        -- แยก flag เพื่อไม่ต่อ listener ซ้ำหากอีก packet ยังไม่พร้อม
        if not state.AwakenListening then
            connect(packets.evolveCharacterResult, function(result)
                local pending = state.Pending
                if pending
                    and pending.Stage == 1
                    and result.character == "sung_jinwoo"
                then
                    pending.Response = {
                        Success = result.status == "success",
                        Reason = result.status,
                    }
                end
            end)
            state.AwakenListening = true
        end

        if not state.PathListening then
            connect(packets.monarchEvolveResult, function(result)
                local pending = state.Pending
                if pending
                    and pending.Stage > 1
                    and result.stage == pending.Stage
                then
                    pending.Response = {
                        Success = result.success == true,
                        Reason = result.reason,
                    }
                end
            end)
            state.PathListening = true
        end

        state.Listening = true
    end

    function RuntimeFix.monarchClearQueue()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        local timedOut =
            LastLobbyJoinAttemptClock > 0
            and os.clock() - LastLobbyJoinAttemptClock
                >= LOBBY_JOIN_TIMEOUT_SECONDS

        local hasQueue =
            ActiveLobbyQueue ~= nil
            or RuntimeFix.QueueStatus == "inQuque"
            or RuntimeFix.QueueStatus == "teleporting"
            or LocalPlayer:GetAttribute("QueueRoom") ~= nil

        if hasQueue then
            local leaveConfirmed = leaveCurrentLobbyQueue()

            -- การรอ Leave มี yield: ตรวจอีกครั้งก่อนทำต่อ
            if AutoFarmSession.Cancelled
                or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            then
                return false
            end

            if not leaveConfirmed and not timedOut then
                return false
            end

            if not leaveConfirmed then
                warn(string.format(
                    "[LobbyWatchdog] %ds timeout in Lobby"
                        .. " | Leave unconfirmed"
                        .. " | Release local attempt for next room"
                        .. " | Previous room: %s",
                    LOBBY_JOIN_TIMEOUT_SECONDS,
                    tostring(CurrentLobbyRoomNumber)
                ))
            end
        end

        -- ล้างสถานะความพยายามของสคริปต์
        -- ไม่แก้ Attribute หรือ Store ของ Server
        ActiveLobbyQueue = nil
        AutoJoinStarted = false
        LastLobbyJoinAction = nil
        LastLobbyJoinAttemptClock = 0

        RuntimeFix.QueueStatus = "idle"
        RuntimeFix.StartNowRoom = nil
        RuntimeFix.StartNowLastSentAt = nil

        return true
    end

