function AutoFarmSession.ApplyFPSCap()
    if AutoFarmSession.Cancelled then
        return false
    end

    local performance = AZUserSettings.Performance
    local cap

    if type(performance) == "table" then
        cap = performance.FPSCap
    end

    if cap == nil then
        cap = AZDefaults.Performance.FPSCap
    end

    if cap == false then
        return true
    end

    local logger = getfenv().warn

    if type(cap) ~= "number"
        or cap ~= cap
        or cap <= 0
        or cap >= math.huge
        or cap % 1 ~= 0
    then
        if type(logger) == "function" then
            logger("[FPSCap] Use a positive integer or false")
        end
        return false
    end

    if typeof(setfpscap) ~= "function" then
        if type(logger) == "function" then
            logger("[FPSCap] setfpscap is unavailable")
        end
        return false
    end

    local ok, err = pcall(function()
        setfpscap(cap)
    end)

    if type(logger) == "function" then
        if ok then
            logger("[FPSCap] Applied:", cap)
        else
            logger("[FPSCap] Failed:", err)
        end
    end

    return ok
end

