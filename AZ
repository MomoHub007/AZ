    joinHutaoEvoFarm = function(): boolean
        if game.PlaceId ~= AUTO_JOIN_PLACE_ID then
            return false
        end

        if ActiveLobbyQueue then
            print(
                "[AutoEvoHutao] Queue already active -> Skip",
                "| Active:",
                ActiveLobbyQueue
            )
            return false
        end

        if not prepareTeam() then
            return false
        end

        if isHutaoEvolved() then
            print("[AutoEvoHutao] Hutao is already evolved.")
            return false
        end

        if evolveHutaoIfReady() then
            return true
        end

        local status = getHutaoEvoStatus()

        if status.RuntimeTarget then
            local target = status.RuntimeTarget

            if target.Map ~= "hxh" and not RuntimeFix.canFarmRaid() then
                return false
            end

            if target.Map == "spiritedawayraid"
                and not RuntimeFix.ensureBathAccessories()
            then
                return true
            end

            if not queueScriptOnTeleport() then
                return false
            end

            local isStory = target.Map == "hxh"

            ActiveLobbyQueue =
                "HuTao_Runtime_" .. target.Map .. "_" .. target.Chapter

            LastLobbyJoinAction = joinHutaoEvoFarm
            LastLobbyJoinAttemptClock = os.clock()

            RuntimeFix.createQueue({
                gamemode = isStory and "Story" or "Raid",

                map = isStory and "Hxh"
                    or (
                        target.Map == "spiritedawayraid"
                        and "BathTub"
                        or "ShadowGate"
                    ),

                chapter = isStory and target.Chapter or 0,
                floor = 0,
                difficulty = target.Difficulty,
                maxPlayers = 4,
                friendsOnly = false,
                roomNumber = CurrentLobbyRoomNumber,
            })

            return true
        end

        if status.waitingForStorage then
            return true
        end

        -- คืน false เพื่อให้เส้นทาง Story เดิมทำงานต่อ
        if status.missingStage == "Raid_BathTub"
            and not RuntimeFix.canFarmRaid()
