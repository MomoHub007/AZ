local function applyLowGraphicsToInstance(instance)
    if not instance or not instance.Parent then
        return
    end

    if instance:IsA("BasePart") then
        instance.CastShadow = false
        instance.Reflectance = 0

        -- Potato gray materials
        instance.Material = Enum.Material.SmoothPlastic
        instance.Color = POTATO_COLOR

        if instance:IsA("MeshPart") then
            pcall(function()
                instance.RenderFidelity =
                    Enum.RenderFidelity.Performance
            end)

            pcall(function()
                instance.TextureID = ""
            end)
        end

        if instance:IsA("UnionOperation") then
            pcall(function()
                instance.UsePartColor = true
            end)
        end

    elseif instance:IsA("Decal")
        or instance:IsA("Texture")
    then
        instance.Transparency = 1

    elseif instance:IsA("ParticleEmitter")
        or instance:IsA("Trail")
        or instance:IsA("Beam")
        or instance:IsA("Smoke")
        or instance:IsA("Fire")
        or instance:IsA("Sparkles")
    then
        instance.Enabled = false

    elseif instance:IsA("PostEffect")
        or instance:IsA("Highlight")
    then
        if instance:GetAttribute("KaiTunOverlayEffect") ~= true then
            instance.Enabled = false
        end

    elseif instance:IsA("SpecialMesh") then
        pcall(function()
            instance.TextureId = ""
        end)

    elseif instance:IsA("SurfaceAppearance") then
        pcall(function()
            instance.ColorMap = ""
            instance.NormalMap = ""
            instance.MetalnessMap = ""
            instance.RoughnessMap = ""
        end)

    elseif instance:IsA("Atmosphere") then
        pcall(function()
            instance.Density = 0
            instance.Haze = 0
            instance.Glare = 0
        end)

    elseif instance:IsA("Clouds") then
        instance.Enabled = false

    elseif instance:IsA("Sky") then
        instance.CelestialBodiesShown = false
        instance.StarCount = 0
    end
end

local function applyPotatoLighting()
    local Lighting = game:GetService("Lighting")

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.ShadowSoftness = 0
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.ExposureCompensation = 0
    end)

    for _, instance in ipairs(Lighting:GetDescendants()) do
        applyLowGraphicsToInstance(instance)
    end

    local terrain = workspace:FindFirstChildOfClass("Terrain")

    if terrain then
        pcall(function()
            terrain.Decoration = false
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end)
    end
end

local function startFPSBoost()
    if FPSBoostEnabled or AutoFarmSession.Cancelled then
        return
    end

    FPSBoostEnabled = true

    print("[PotatoMode] Starting Ultra Potato Mode...")

    if typeof(setfpscap) == "function" then
        local ok, err = pcall(function()
            setfpscap(POTATO_FPS_CAP)
        end)

        if not ok then
            warn("[PotatoMode] FPS cap failed:", err)
        end
    end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    pcall(function()
        local userGameSettings =
            UserSettings():GetService("UserGameSettings")

        userGameSettings.GraphicsQualityLevel = 1
    end)

    applyPotatoLighting()

    -- Process in batches to reduce startup freezing.
    local descendants = workspace:GetDescendants()
    local batchSize = 250

    for index, instance in ipairs(descendants) do
        if AutoFarmSession.Cancelled or not FPSBoostEnabled then
            return
        end

        applyLowGraphicsToInstance(instance)

        if index % batchSize == 0 then
            task.wait()
        end
    end

    -- Apply potato graphics to new instances.
    FPSBoostConnection =
        workspace.DescendantAdded:Connect(function(instance)
            if not FPSBoostEnabled or AutoFarmSession.Cancelled then
                return
            end

            task.defer(function()
                if FPSBoostEnabled
                    and not AutoFarmSession.Cancelled
                    and instance.Parent
                then
                    applyLowGraphicsToInstance(instance)
                end
            end)
        end)

    PotatoLightingConnection =
        game:GetService("Lighting").DescendantAdded:Connect(
            function(instance)
                if AutoFarmSession.Cancelled
                    or not FPSBoostEnabled
                then
                    return
                end

                task.defer(function()
                    if not AutoFarmSession.Cancelled
                        and FPSBoostEnabled
                        and instance.Parent
                    then
                        applyLowGraphicsToInstance(instance)
                    end
                end)
            end
        )

    print("[PotatoMode] ULTRA POTATO ENABLED")
end

