--==================================================

local function startRetreatHeal()
    if IsHealing or not CurrentTarget then
        return
    end

    if not isEnemyAlive(CurrentTarget) then
        stopHover()
        return
    end

    if not startHover(CurrentTarget, HEAL_RETREAT_HEIGHT, true) then
        return
    end

    IsHealing = true

    print(
        "[AutoFarm] Retreat Heal START | Health:",
        getHealthPercent() .. "%"
    )
end

local function updateRetreatHeal()
    if not IsHealing then
        return false
    end

    if not CurrentTarget or not isEnemyAlive(CurrentTarget) then
        IsHealing = false
        stopHover()
        return false
    end

    local healthPercent = getHealthPercent()

    if healthPercent < HEAL_RESUME_PERCENT then
        return true
    end

    IsHealing = false

    print(
        "[AutoFarm] Retreat Heal END | Health:",
        healthPercent .. "%"
    )

    local target = CurrentTarget

    if target and isEnemyAlive(target) then
        startHover(target, BELOW_DEPTH)
    else
        CurrentTarget = nil
    end

    return false
end

