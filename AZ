function RuntimeFix.startDisconnectRejoin()
    if RuntimeFix.RejoinStarted or AutoFarmSession.Cancelled then
        return
    end

    RuntimeFix.RejoinStarted = true

    local teleportService = game:GetService("TeleportService")
    local guiService = game:GetService("GuiService")
    local coreGui = game:GetService("CoreGui")

    local allowedCodes = {
        [266] = true,
        [277] = true,
        [278] = true,
        [288] = true,
    }

    local maxAttempts = 5
    local requestTimeout = 45

    local state = {
        Active = false,
        Attempts = 0,
        NextAttemptAt = 0,
        Pending = false,
        SentAt = 0,
        Teleporting = false,
        Exhausted = false,
    }

    local function retryDelay()
        return math.min(30, math.max(10, state.Attempts * 10))
    end

    local function readDisconnectCode()
        -- ใช้ API ที่ตรวจพบ โดยรองรับกรณี Executor อ่านไม่ได้
        local ok, result = pcall(function()
            return guiService:GetErrorCode()
        end)

        if ok and typeof(result) == "EnumItem" then
            if allowedCodes[result.Value] then
                return result.Value
            end
        end

        -- Fallback: อ่านเฉพาะ ErrorPrompt ที่เปิดและเป็น Disconnected
        local uiOk, uiCode = pcall(function()
            local function inspectPrompt(prompt)
                if not prompt
                    or not prompt:IsA("Frame")
                    or not prompt.Visible
                then
                    return nil
                end

                local titleFrame = prompt:FindFirstChild("TitleFrame")
                local title = titleFrame
                    and titleFrame:FindFirstChild("ErrorTitle")

                local messageArea = prompt:FindFirstChild("MessageArea")
                local errorFrame = messageArea
                    and messageArea:FindFirstChild("ErrorFrame")
                local message = errorFrame
                    and errorFrame:FindFirstChild("ErrorMessage")

                if not title
                    or not title:IsA("TextLabel")
                    or title.Text ~= "Disconnected"
                    or not message
                    or not message:IsA("TextLabel")
                then
                    return nil
                end

                local code = tonumber(
                    message.Text:match("Error Code:%s*(%d+)")
                )

                return allowedCodes[code] and code or nil
            end

            local promptGui = coreGui:FindFirstChild("RobloxPromptGui")
            local overlay = promptGui
                and promptGui:FindFirstChild("promptOverlay")

            if promptGui
                and promptGui:IsA("ScreenGui")
                and promptGui.Enabled
                and overlay
                and overlay:IsA("Frame")
                and overlay.Visible
            then
                local code = inspectPrompt(
                    overlay:FindFirstChild("ErrorPrompt")
                )

                if code then
                    return code
                end
            end

            local robloxGui = coreGui:FindFirstChild("RobloxGui")

            if robloxGui
                and robloxGui:IsA("ScreenGui")
                and robloxGui.Enabled
            then
                return inspectPrompt(
                    robloxGui:FindFirstChild("ErrorPrompt")
                )
            end

            return nil
        end)

        return uiOk and uiCode or nil
    end

    local teleportConnection =
        LocalPlayer.OnTeleport:Connect(function(teleportState)
            if AutoFarmSession.Cancelled or not state.Active then
                return
            end

            if teleportState == Enum.TeleportState.Started
                or teleportState == Enum.TeleportState.WaitingForServer
                or teleportState == Enum.TeleportState.InProgress
            then
                state.Teleporting = true

            elseif teleportState == Enum.TeleportState.Failed then
                state.Teleporting = false
                state.Pending = false
                state.NextAttemptAt = os.clock() + retryDelay()
            end
        end)

    local failedConnection =
        teleportService.TeleportInitFailed:Connect(
            function(player, result, message, placeId)
                if AutoFarmSession.Cancelled
                    or not state.Active
                    or not state.Pending
                    or player ~= LocalPlayer
                    or placeId ~= AUTO_JOIN_PLACE_ID
                then
                    return
                end

                state.Teleporting = false
                state.Pending = false
                state.NextAttemptAt = os.clock() + retryDelay()

                warn(
                    "[Rejoin] Teleport failed:",
                    result.Name,
                    message
                )
            end
        )

    table.insert(AutoFarmSession.Cleanups, function()
        teleportConnection:Disconnect()
        failedConnection:Disconnect()
        RuntimeFix.RejoinStarted = false
    end)

    task.spawn(function()
        while not AutoFarmSession.Cancelled do
            task.wait(1)

            if AutoFarmSession.Cancelled then
                break
            end

            if not state.Active then
                local code = readDisconnectCode()

                if not code then
                    continue
                end

                state.Active = true
                state.NextAttemptAt = os.clock() + 3

                -- หยุดการเคลื่อนที่และปลด Idle Hold ผ่านระบบเดิม
                StopAutoFarm()

                print("[Rejoin] Disconnect detected | Code:", code)
            end

            -- รอจนสำเร็จหรือมี Event แจ้งล้มเหลว
            if state.Teleporting or state.Exhausted then
                continue
            end

            local now = os.clock()

            if state.Pending then
                if now - state.SentAt < requestTimeout then
                    continue
                end

                state.Pending = false
                state.NextAttemptAt = now + retryDelay()
                warn("[Rejoin] No teleport confirmation; retry scheduled.")
                continue
            end

            if now < state.NextAttemptAt then
                continue
            end

            if state.Attempts >= maxAttempts then
                state.Exhausted = true
                warn("[Rejoin] Attempt limit reached:", maxAttempts)
                continue
            end

            state.Attempts += 1
            state.Pending = true
            state.SentAt = now

            print(
                "[Rejoin] Attempt:",
                state.Attempts,
                "| Lobby:",
                AUTO_JOIN_PLACE_ID
            )

            local ok, teleportError = pcall(function()
                -- Auto Execute เป็นอีกช่องทางโหลดต่อที่คุณเปิดไว้
                queueScriptOnTeleport()
                teleportService:Teleport(AUTO_JOIN_PLACE_ID, LocalPlayer)
            end)

            if not ok then
                state.Pending = false
                state.Teleporting = false
                state.NextAttemptAt = os.clock() + retryDelay()

                warn("[Rejoin] Request error:", teleportError)
            end
        end
    end)
end

