function waitForInitialGameReady()
    print(
        "[Loader] Waiting for",
        game.PlaceId == AUTO_JOIN_PLACE_ID
            and "Lobby"
            or "Stage",
        "data..."
    )

    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    while not AutoFarmSession.Cancelled do
        local ready = false

        local ok = pcall(function()
            if game.PlaceId == AUTO_JOIN_PLACE_ID then
                local lobby = ReplicatedStorage:FindFirstChild("lobby")
                local packetsModule =
                    lobby
                    and lobby:FindFirstChild("packets")

                local global = ReplicatedStorage:FindFirstChild("global")
                local stores =
                    global
                    and global:FindFirstChild("stores")

                local accountNamespace =
                    stores
                    and stores:FindFirstChild("accountNamespace")

                local assets = ReplicatedStorage:FindFirstChild("assets")
                local config =
                    assets
                    and assets:FindFirstChild("config")

                local economyConfig =
                    config
                    and config:FindFirstChild("economyConfig")

                if not packetsModule
                    or not accountNamespace
                    or not economyConfig
                then
                    return
                end

                local packets = require(packetsModule)
                local accountModule = require(accountNamespace)

                if not packets
                    or not packets.rollCharacter
                then
                    return
                end

                local account =
                    accountModule.getLocalPlayerAccount()

                if not account then
                    return
                end

                local data = account:toTable()

                if type(data) ~= "table"
                    or type(data.UnlockedCharacters) ~= "table"
                    or type(data.EquippedCharacterSlots) ~= "table"
                    or type(data.currencies) ~= "table"
                then
                    return
                end

                ready = true
            else
                local character = LocalPlayer.Character
                local root =
                    character
                    and character:FindFirstChild("HumanoidRootPart")
                local humanoid =
                    character
                    and character:FindFirstChildOfClass("Humanoid")
                local world = workspace:FindFirstChild("World")
                local areas =
                    world
                    and world:FindFirstChild("Areas")
                local map =
                    world
                    and world:FindFirstChild("Map")
                local roundHUD =
                    PlayerGui:FindFirstChild("RoundHUD")
                local enemyCount =
                    roundHUD
                    and roundHUD:FindFirstChild("Container")
                    and roundHUD.Container:FindFirstChild("TopPart")
                    and roundHUD.Container.TopPart:FindFirstChild("RemainingFrame")
                    and roundHUD.Container.TopPart.RemainingFrame:FindFirstChild("EnemyCount")
                local hud = PlayerGui:FindFirstChild("HUD")
                local hudRoot =
                    hud
                    and hud:FindFirstChild("HUD")
                local bottomLeft =
                    hudRoot
                    and hudRoot:FindFirstChild("BottomLeftHolder")
                local main =
                    bottomLeft
                    and bottomLeft:FindFirstChild("main")
                local skills =
                    main
                    and main:FindFirstChild("skills")
                local performM1 =
                    ReplicatedStorage:FindFirstChild("performM1")

                if character
                    and root
                    and humanoid
                    and world
                    and areas
                    and map
                    and enemyCount
                    and skills
                    and performM1
                then
                    ready = true
                end
            end
        end)

        if ok and ready then
            print(
                "[Loader]",
                game.PlaceId == AUTO_JOIN_PLACE_ID
                    and "Lobby"
                    or "Stage",
                "READY"
            )
            return true
        end

        task.wait(0.5)
    end

    return false
end

local LobbyAutoJoinWatcherStarted = false

function startLobbyAutoJoinWatcher()
    if game.PlaceId ~= AUTO_JOIN_PLACE_ID
        or LobbyAutoJoinWatcherStarted
        or AutoFarmSession.Cancelled
    then
        return
    end

    LobbyAutoJoinWatcherStarted = true

    task.spawn(function()
        while not AutoFarmSession.Cancelled do
            local listenerOk, listenerError = pcall(function()
                if RuntimeFix.QueueListenerStarted then
                    return
                end

                local packets = RuntimeFix.getPackets()
                local statusPacket = packets.updateClientQuqueStatus

                if not statusPacket
                    or type(statusPacket.on) ~= "function"
                then
                    error("updateClientQuqueStatus unavailable")
                end

                local disconnect = statusPacket:on(function(status)
                    if AutoFarmSession.Cancelled then
                        return
                    end

                    RuntimeFix.QueueStatus = status

                    if status == "idle" then
                        RuntimeFix.QueueIdleRevision += 1
                    end
                end)

                if typeof(disconnect) == "function" then
                    table.insert(AutoFarmSession.Cleanups, disconnect)
                elseif typeof(disconnect) == "RBXScriptConnection" then
                    table.insert(AutoFarmSession.Cleanups, function()
                        disconnect:Disconnect()
                    end)
                end

                RuntimeFix.QueueListenerStarted = true
            end)

            if listenerOk then
                break
            end

            warn("[LobbyWatchdog] Listener unavailable:", listenerError)
            task.wait(2)
        end

        while not AutoFarmSession.Cancelled
            and game.PlaceId == AUTO_JOIN_PLACE_ID
        do
            task.wait(1)

            if AutoFarmSession.Cancelled then
                break
            end

            local startOk, startError = pcall(RuntimeFix.tryStartQueueNow)

            if not startOk then
                warn("[AutoStart] Start Now failed:", startError)
            end

            local jinwooData = RuntimeFix.readAccount()

            if not jinwooData then
                continue
            end

            if RuntimeFix.StoredPending then
                continue
            end

            if RuntimeFix.findOwnedSlot(jinwooData, "sung_jinwoo") then
                RuntimeFix.runMonarch()
                continue
            end

            if RuntimeFix.storageCount(jinwooData, "sung_jinwoo") > 0 then
                continue
            end

            if RuntimeFix.JoinOwner
                or RuntimeFix.Crafting
                or RuntimeFix.PreparingTeam
            then
                continue
            end

            local prepInProgress = AutoRedeemCodesEnabled
                or AutoUnlockSlotsEnabled
                or AutoUpgradeSkillTreeEnabled
                or CustomAutoRollEnabled

            local hasAttempt = LastLobbyJoinAttemptClock > 0
            local timedOut = hasAttempt
                and os.clock() - LastLobbyJoinAttemptClock
                    >= LOBBY_JOIN_TIMEOUT_SECONDS

            if not timedOut
                and (hasAttempt or prepInProgress)
            then
                continue
            end

            if timedOut then
                local previousRoom = CurrentLobbyRoomNumber
                local leaveConfirmed = leaveCurrentLobbyQueue()

                if AutoFarmSession.Cancelled then
                    break
                end

                -- เปลี่ยนห้องแม้คิวเดิมไม่ยืนยันการออก
                local nextRoom = cycleNextRoomNumber()
                LobbyRetryCount += 1

                -- ล้างตัวจำกัดการส่ง Start Now ของรอบเดิม
                RuntimeFix.StartNowRoom = nil
                RuntimeFix.StartNowLastSentAt = nil

                warn(
                    "[LobbyWatchdog] Retry:",
                    LobbyRetryCount,
                    "| Previous room:",
                    previousRoom,
                    "| Next room:",
                    nextRoom,
                    "| Leave confirmed:",
                    leaveConfirmed
                )
            end

            if AutoFarmSession.Cancelled then
                break
            end

            AutoJoinStarted = false
            HutaoEvoFarmStarted = false
            SukunaEvoFarmStarted = false
            ActiveLobbyQueue = nil
            LastLobbyJoinAttemptClock = os.clock()

            local action = LastLobbyJoinAction
                or autoJoinBestAvailableStory

            local ok, result = pcall(action)

            if not ok then
                warn("[LobbyWatchdog] Join failed:", result)
            elseif result == false
                and not ActiveLobbyQueue
                and action ~= autoJoinBestAvailableStory
                and not AutoFarmSession.Cancelled
            then
                local fallbackOk, fallbackError =
                    pcall(autoJoinBestAvailableStory)

                if not fallbackOk then
                    warn(
                        "[LobbyWatchdog] Fallback failed:",
                        fallbackError
                    )
                end
            end
        end

        LobbyAutoJoinWatcherStarted = false
    end)
end

