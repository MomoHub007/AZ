    function RuntimeFix.tryStartQueueNow()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            or not AZEnabled("Lobby", "AutoJoin")
            or not RuntimeFix.QueueListenerStarted
        then
            return false
        end

        if AZEnabled("Lobby", "ClaimBeforeJoin")
            and AZEnabled("Rewards", "AutoClaim")
            and not RuntimeFix.AutoClaimInitialReady
            and not RuntimeFix.AutoClaimJoinReleased
        then
            return false
        end

        if type(RuntimeFix.isTraitReadyForJoin) ~= "function"
            or not RuntimeFix.isTraitReadyForJoin()
        then
            return false
        end

        local status = RuntimeFix.QueueStatus
        local room = LocalPlayer:GetAttribute("QueueRoom")

        if status == "idle" or room == nil then
            RuntimeFix.StartNowRoom = nil
            RuntimeFix.StartNowLastSentAt = nil
            return false
        end

        if status ~= "inQuque"
            or LocalPlayer:GetAttribute("QueueLeader") ~= true
            or not ActiveLobbyQueue
            or RuntimeFix.JoinOwner
            or RuntimeFix.PreparingTeam
            or RuntimeFix.Crafting
            or RuntimeFix.StoredPending
        then
            return false
        end

        if LastLobbyJoinAttemptClock <= 0
            or os.clock() - LastLobbyJoinAttemptClock
                >= LOBBY_JOIN_TIMEOUT_SECONDS
        then
            return false
        end

        if RuntimeFix.StartNowRoom ~= room then
            RuntimeFix.StartNowRoom = room
            RuntimeFix.StartNowLastSentAt = nil
        end

        local now = os.clock()
        local lastSent = RuntimeFix.StartNowLastSentAt

        if lastSent
            and now - lastSent < RuntimeFix.StartNowRetrySeconds
        then
            return false
        end

        local packet = RuntimeFix.getPackets().startQuqueNow

        if not packet or type(packet.fire) ~= "function" then
            error("startQuqueNow packet unavailable")
        end

        RuntimeFix.StartNowLastSentAt = now
        packet:fire()

        print("[AutoStart] Start requested | Room:", room)
        return true
    end

    local function joinShadowGateRaid(): boolean
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        if not RuntimeFix.canFarmRaid() then
            return false
        end

        if RuntimeFix.StoredPending then
            return false
        end

        local jinwooData = RuntimeFix.readAccount()

        if not jinwooData then
            return false
        end

        if RuntimeFix.findOwnedSlot(jinwooData, "sung_jinwoo") then
            return RuntimeFix.runMonarch()
        end

        -- รับตัวที่ค้างใน storage ก่อนเริ่มรอบใหม่
        if RuntimeFix.storageCount(jinwooData, "sung_jinwoo") > 0 then
            return false
        end

        -- มีคำขอ Shadow Gate อยู่แล้ว ให้ watchdog ดูแลต่อ
        if ActiveLobbyQueue == "Raid_ShadowGate" then
            return true
        end

        if ActiveLobbyQueue then
            return false
        end

        local data = getAccountDataForCraft()

        if not data then
            return false
        end

        if not isAccessoryOwned(
            data,
            RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
        )
            or not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            )
        then
            return false
        end

        -- ล็อกก่อน prepareTeam ซึ่งมีการรอ
        ActiveLobbyQueue = "Raid_ShadowGate"
        LastLobbyJoinAction = joinShadowGateRaid
        LastLobbyJoinAttemptClock = os.clock()

        local ok, joinError = pcall(function()
            local lobby = ReplicatedStorage:FindFirstChild("lobby")
            local packetsModule = lobby
                and lobby:FindFirstChild("packets")

            if not packetsModule
                or not packetsModule:IsA("ModuleScript")
            then
                error("ReplicatedStorage.lobby.packets unavailable")
            end

            local packets = require(packetsModule)

            if not packets.createQuque
                or type(packets.createQuque.fire) ~= "function"
            then
                error("createQuque packet unavailable")
            end

            -- ใช้การจัดทีมเดิมของไฟล์
            if not prepareTeam() then
                error("Team equipment not confirmed")
            end

            if AutoFarmSession.Cancelled then
                error("Script session cancelled")
            end

            if ActiveLobbyQueue ~= "Raid_ShadowGate" then
                error("Queue ownership changed")
            end

            if not queueScriptOnTeleport() then
                warn(
                    "[ShadowGate] Script reload after teleport was not queued."
                )
            end

            LastLobbyJoinAttemptClock = os.clock()

            RuntimeFix.createQueue({
                gamemode = "Raid",
                map = "ShadowGate",
                chapter = 0,
                difficulty = RuntimeFix.getStoryDifficulty(4),
                maxPlayers = 1,
                friendsOnly = false,
                roomNumber = CurrentLobbyRoomNumber,
