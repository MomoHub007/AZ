        then
            AutoUnlockSlotsEnabled = false
            warn("[AutoUnlock] Character slot packet API is unavailable.")
            return
        end

        local function getAccountData()
            local success, data = pcall(function()
                local account =
                    accountNamespace.getLocalPlayerAccount()

                if not account then
                    error("LocalPlayer account is unavailable.")
                end

                return account:toTable()
            end)

            if not success then
                return nil, tostring(data)
            end

            return data
        end

        local waitingForResult = false
        local currentSlot = nil
        local currentRequestId = nil
        local actionResult = nil
        local disconnectResult =
            packets.characterSlotActionResult:on(function(result)
                if not waitingForResult
                    or type(result) ~= "table"
                    or result.action ~= "unlock"
                    or result.slot ~= currentSlot
                    or result.requestId ~= currentRequestId
                then
                    return
                end

                actionResult = result
            end)

        print("[AutoUnlock] START | Unlock slots 2-4 when affordable.")

        for slot = 2, 4 do
            if AutoFarmSession.Cancelled then
                break
            end

            local data, accountError = getAccountData()

            if not data then
                warn("[AutoUnlock] Account read failed:", accountError)
                break
            end

            local slotData =
                data.UnlockedCharacters
                and data.UnlockedCharacters["Slot" .. tostring(slot)]

            if type(slotData) ~= "table" then
                warn("[AutoUnlock] Character data missing for Slot", slot)
                break
            end

            if slotData.Unlocked then
                print("[AutoUnlock] Slot", slot, "already unlocked.")
                continue
            end

            local cost =
                economyConfig.characterSlotUnlockCosts
                and economyConfig.characterSlotUnlockCosts[slot]

            if type(cost) ~= "number" then
                warn("[AutoUnlock] Unlock cost missing for Slot", slot)
                break
            end

            local money =
                data.currencies
                and tonumber(data.currencies.money)

            if money == nil then
                warn("[AutoUnlock] Could not read current money.")
                break
            end

            if money < cost then
                print(
                    "[AutoUnlock] Not enough money for Slot",
                    slot,
                    "| Have:",
                    money,
                    "| Cost:",
                    cost
                )
                break
            end

            UnlockCharacterSlotRequestId =
                UnlockCharacterSlotRequestId % 65535 + 1
            currentSlot = slot
            currentRequestId = UnlockCharacterSlotRequestId
            actionResult = nil
            waitingForResult = true

            local requestId = currentRequestId
            local fireOk, fireError = pcall(function()
                packets.unlockCharacterSlot:fire({
                    slot = slot,
                    requestId = requestId,
                })
            end)

            if not fireOk then
                waitingForResult = false
                warn("[AutoUnlock] Request failed for Slot", slot, fireError)
                break
            end

            print(
                "[AutoUnlock] Requested Slot",
                slot,
                "| Cost:",
                cost,
                "| RequestId:",
                requestId
            )

            local deadline = os.clock() + 8
            local unlocked = false

            repeat
                if actionResult and not actionResult.success then
                    break
                end

                task.wait(0.1)

                local latestData, latestError = getAccountData()

                if not latestData then
                    warn(
                        "[AutoUnlock] Could not verify Slot",
                        slot,
                        latestError
                    )
                    break
                end

                local latestSlot =
                    latestData.UnlockedCharacters
                    and latestData.UnlockedCharacters[
                        "Slot" .. tostring(slot)
                    ]

                unlocked =
                    type(latestSlot) == "table"
                    and latestSlot.Unlocked == true
            until unlocked
                or os.clock() >= deadline
                or AutoFarmSession.Cancelled

            waitingForResult = false

            if not unlocked then
                if actionResult and not actionResult.success then
                    warn(
                        "[AutoUnlock] Slot",
                        slot,
                        "unlock rejected:",
                        tostring(actionResult.reason)
                    )
                elseif not AutoFarmSession.Cancelled then
                    warn(
                        "[AutoUnlock] Slot",
                        slot,
                        "unlock was not confirmed; stopping to avoid duplicate requests."
                    )
                end

                break
            end

            print("[AutoUnlock] Unlocked Slot", slot)
            task.wait(0.25)
        end

        waitingForResult = false

        if disconnectResult then
            pcall(disconnectResult)
        end

        AutoUnlockSlotsEnabled = false
        print("[AutoUnlock] Finished.")
    end)
end

function StartAutoUpgradeSkillTree()
    if AutoUpgradeSkillTreeEnabled
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
    then
        return
    end

    AutoUpgradeSkillTreeEnabled = true

    task.spawn(function()
        while AutoUnlockSlotsEnabled
            and not AutoFarmSession.Cancelled
        do
            task.wait(0.1)
        end

        local disconnectResult = nil

        local function finish(message, isWarning)
            if disconnectResult then
                pcall(disconnectResult)
                disconnectResult = nil
            end

            AutoUpgradeSkillTreeEnabled = false

            if isWarning then
                warn("[AutoSkillTree] " .. message)
            else
                print("[AutoSkillTree] " .. message)
            end
        end

        if AutoFarmSession.Cancelled then
            finish("Cancelled because a newer script session started.")
            return
        end

        local accountNamespace
        local skillTreePackets
        local skillTreeConfig
        local characterLevelProgression

        local modulesLoaded, moduleError = pcall(function()
            local replicatedLobby = ReplicatedStorage:WaitForChild("lobby")
            local modules = replicatedLobby:WaitForChild("modules")
            local skillTreeModule = modules:WaitForChild("skillTree")

            accountNamespace = require(
                ReplicatedStorage
                    :WaitForChild("global")
                    :WaitForChild("stores")
                    :WaitForChild("accountNamespace")
            )
            skillTreePackets = require(
                skillTreeModule:WaitForChild("skillTreePackets")
            )
            skillTreeConfig = require(
                ReplicatedStorage
                    :WaitForChild("assets")
                    :WaitForChild("config")
                    :WaitForChild("characterSkillTreeConfig")
            )
            characterLevelProgression = require(
                ReplicatedStorage
                    :WaitForChild("global")
                    :WaitForChild("utils")
                    :WaitForChild("characterLevelProgression")
            )
        end)

        if not modulesLoaded then
            finish("Failed to load modules: " .. tostring(moduleError), true)
            return
        end

        if not skillTreePackets.purchaseCharacterSkill
            or type(skillTreePackets.purchaseCharacterSkill.fire) ~= "function"
            or not skillTreePackets.characterSkillPurchaseResult
            or type(skillTreePackets.characterSkillPurchaseResult.on) ~= "function"
            or type(characterLevelProgression.getAvailableTokens) ~= "function"
        then
            finish("Skill Tree packet or progression API is unavailable.", true)
            return
        end

        local function getAccountData()
            local ok, data = pcall(function()
                local account = accountNamespace.getLocalPlayerAccount()

                if not account then
                    error("LocalPlayer account is unavailable.")
                end

                return account:toTable()
            end)

            if not ok then
                return nil, tostring(data)
            end

            if type(data) ~= "table" then
                return nil, "Account data is unavailable."
            end

            return data
        end

        local purchaseResult = nil
        local pendingBranch = nil
        local pendingTier = nil
        local pendingRequestId = nil
        local pendingCharacter = nil

        local listenerOk, listenerResult = pcall(function()
            return skillTreePackets.characterSkillPurchaseResult:on(function(result)
                if type(result) == "table"
                    and result.requestId == pendingRequestId
                    and result.character == pendingCharacter
                    and result.branch == pendingBranch
                    and result.tier == pendingTier
                then
                    purchaseResult = result
                end
            end)
        end)

        if not listenerOk or type(listenerResult) ~= "function" then
            finish("Could not subscribe to Skill Tree purchase results: " .. tostring(listenerResult), true)
            return
        end

        disconnectResult = listenerResult

        local function upgradeCharacterSkillTree(charId, charDisplayName)
            if AutoFarmSession.Cancelled then return end

            local currentData, err = getAccountData()
            if not currentData then return end

            local isUnlocked = false
            local unlockedCharacters = currentData.UnlockedCharacters
            if type(unlockedCharacters) == "table" then
                for slotNumber = 1, 4 do
                    local slot = unlockedCharacters["Slot" .. slotNumber]
                    if slot and slot.Unlocked == true then
                        local cName = string.lower(tostring(slot.Character or ""))
                        if cName == charId or (charId == "sukuna" and string.find(cName, "cursed king")) or (charId == "hutao" and string.find(cName, "hu tao")) then
                            isUnlocked = true
                            break
                        end
                    end
                end
            end

            if not isUnlocked then
                print(string.format("[AutoSkillTree] %s is not in any slot; skipping.", charDisplayName))
                return
            end

            local characterData = currentData.CharactersData and currentData.CharactersData[charId]
            local progression = characterData and characterData.Progression
            local rawSkills = progression and progression.Skills
            local skillTreeCharacter = skillTreeConfig.characters and skillTreeConfig.characters[charId]

            if type(rawSkills) ~= "table"
                or type(skillTreeCharacter) ~= "table"
                or type(skillTreeCharacter.branches) ~= "table"
                or type(skillTreeConfig.branchOrder) ~= "table"
                or #skillTreeConfig.branchOrder == 0
            then
                print(string.format("[AutoSkillTree] %s Skill Tree configuration unavailable; skipping.", charDisplayName))
                return
            end

            -- Create a working copy of skills table so we don't depend on slow account replication
            local skills = {}
            for k, v in pairs(rawSkills) do
                skills[k] = tonumber(v) or 1
            end

            print(string.format("[AutoSkillTree] START | Character: %s | Branches: ATK, CRIT, DEF, SPD", charDisplayName))

            local nextBranchIndex = 1

            while not AutoFarmSession.Cancelled do
                local tokensOk, availableTokens = pcall(function()
                    return characterLevelProgression.getAvailableTokens(
                        charId,
                        progression.Xp,
                        skills
                    )
                end)

                if not tokensOk or type(availableTokens) ~= "number" or availableTokens <= 0 then
                    print(string.format("[AutoSkillTree] %s has no available Skill Tokens (Remaining: %s).", charDisplayName, tostring(availableTokens)))
                    break
                end

                local nextBranch = nil
                local nextTier = nil
                local selectedBranchIndex = nil
                local branchCount = #skillTreeConfig.branchOrder

                for offset = 0, branchCount - 1 do
                    local branchIndex = (nextBranchIndex + offset - 1) % branchCount + 1
                    local branch = skillTreeConfig.branchOrder[branchIndex]
                    local branchConfig = skillTreeCharacter.branches[branch]
                    local currentTier = math.clamp(math.floor(tonumber(skills[branch]) or 1), 1, 5)
                    local candidateTier = currentTier + 1
                    local tiers = type(branchConfig) == "table" and branchConfig.tiers
                    local tierConfig = type(tiers) == "table" and tiers[candidateTier]
                    local tierCost = tierConfig and tonumber(tierConfig.cost)

                    if tierCost and availableTokens >= tierCost then
                        nextBranch = branch
                        nextTier = candidateTier
                        selectedBranchIndex = branchIndex
                        break
                    end
                end

                if not nextBranch then
                    print(string.format("[AutoSkillTree] Finished; all %s branches maxed or no more affordable tiers.", charDisplayName))
                    break
                end

                PurchaseCharacterSkillRequestId = PurchaseCharacterSkillRequestId % 65535 + 1
                local requestId = PurchaseCharacterSkillRequestId
                pendingBranch = nextBranch
                pendingTier = nextTier
                pendingRequestId = requestId
                pendingCharacter = charId
                purchaseResult = nil

                local fireOk, fireError = pcall(function()
                    skillTreePackets.purchaseCharacterSkill:fire({
                        character = charId,
                        branch = nextBranch,
                        tier = nextTier,
                        requestId = requestId,
                    })
                end)

                if not fireOk then
                    warn(string.format("[AutoSkillTree] Purchase failed for %s %s T%d: %s", charDisplayName, nextBranch, nextTier, tostring(fireError)))
                    break
                end

                print(string.format("[AutoSkillTree] Requested %s %s Tier %d | Cost: %d | RequestId: %d", charDisplayName, nextBranch, nextTier, tierCost or 0, requestId))

                local deadline = os.clock() + 5
                repeat
                    task.wait(0.08)
                until purchaseResult or os.clock() >= deadline or AutoFarmSession.Cancelled

                if AutoFarmSession.Cancelled or not purchaseResult or not purchaseResult.success then
                    if purchaseResult and not purchaseResult.success then
                        warn(string.format("[AutoSkillTree] Purchase rejected: %s", tostring(purchaseResult.reason)))
                    end
                    break
                end

                -- Purchase confirmed by server packet! Update local skills immediately.
                skills[nextBranch] = nextTier
                print(string.format("[AutoSkillTree] Purchased %s %s Tier %d successfully!", charDisplayName, nextBranch, nextTier))

                nextBranchIndex = selectedBranchIndex % branchCount + 1
                task.wait(0.15)
            end
        end

        local data, dataError = getAccountData()
        if not data then
            finish("Cannot read account: " .. tostring(dataError), true)
            return
        end

        local characters = {}
        local seen = {}
        local configs = skillTreeConfig.characters

        -- เก็บทุก Class ในช่องที่ปลดล็อก โดยไม่อัปตัวซ้ำ
        for slotNumber = 1, 4 do
            local slot = type(data.UnlockedCharacters) == "table"
                and data.UnlockedCharacters["Slot" .. slotNumber]

            if type(slot) == "table"
                and slot.Unlocked == true
                and type(slot.Character) == "string"
            then
                local charId = string.lower(slot.Character)

                if charId ~= ""
                    and not seen[charId]
                    and type(configs) == "table"
                    and type(configs[charId]) == "table"
                    and type(data.CharactersData) == "table"
                    and type(data.CharactersData[charId]) == "table"
                then
                    seen[charId] = true
                    table.insert(characters, charId)
                end
            end
        end

        -- ยังให้ Sung Jinwoo อัปก่อน แล้วอัปทุก Class ที่เหลือ
        table.sort(characters, function(a, b)
            if a == "sung_jinwoo" then return true end
            if b == "sung_jinwoo" then return false end
            return a < b
        end)

        for _, charId in ipairs(characters) do
            if AutoFarmSession.Cancelled then break end
            upgradeCharacterSkillTree(charId, charId)
        end

        finish("Auto Upgrade Skill Tree completed.")
    end)
end

