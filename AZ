    local function formatNumber(value)
        local number = tonumber(value)

        if number == nil then
            return "-"
        end

        local str = tostring(math.floor(number))
        return str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    end

