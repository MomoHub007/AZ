    function RuntimeFix.enterQueueRoom(roomNumber, packets)
        local ENTRY_TIMEOUT = 8
        local HEIGHT_OFFSET = 2

        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            error("Queue entry cancelled or outside Lobby")
        end

        local systems = workspace:FindFirstChild("Systems")
        local rooms = systems and systems:FindFirstChild("QuqueRooms")
        local room = rooms and rooms:FindFirstChild(tostring(roomNumber))
        local inside = room and room:FindFirstChild("Inside")
        local hitbox = room and room:FindFirstChild("JoinHitbox")

        if not inside or not inside:IsA("BasePart")
            or not hitbox or not hitbox:IsA("BasePart")
        then
            error("Queue room parts unavailable: " .. tostring(roomNumber))
        end

        local character = LocalPlayer.Character
        local root = character
            and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not root or not root:IsA("BasePart")
            or not humanoid or humanoid.Health <= 0
        then
            error("Alive character/root unavailable for queue entry")
        end

        local windowPacket = packets and packets.toggleQuqueWindow

        if not windowPacket or type(windowPacket.on) ~= "function" then
            error("toggleQuqueWindow packet unavailable")
        end

        local confirmedRoom = nil
        local listening = true

        -- ลงทะเบียนก่อนย้าย เพื่อรับคำยืนยันจาก Server
        local connection = windowPacket:on(function(payload)
            if not listening or AutoFarmSession.Cancelled then
                return
            end

            if type(payload) ~= "table" then
                return
            end

            if payload.open then
                confirmedRoom = tonumber(payload.roomNumber)
            else
                confirmedRoom = nil
            end
        end)

        local cleaned = false

        local function cleanup()
            if cleaned then
                return
            end

            cleaned = true
            listening = false

            if typeof(connection) == "function" then
                pcall(connection)
            elseif typeof(connection) == "RBXScriptConnection" then
                connection:Disconnect()
            end
        end

        if typeof(connection) ~= "function"
            and typeof(connection) ~= "RBXScriptConnection"
        then
            cleanup()
            error("Unsupported toggleQuqueWindow listener handle")
        end

        -- รองรับการหยุด session ระหว่างรอ
        table.insert(AutoFarmSession.Cleanups, cleanup)

        local ok, entryError = pcall(function()
            local function checkCharacter()
                if AutoFarmSession.Cancelled
                    or game.PlaceId ~= AUTO_JOIN_PLACE_ID
                    or LocalPlayer.Character ~= character
                    or not root.Parent
                    or not humanoid.Parent
                    or humanoid.Health <= 0
                    or not inside.Parent
                    or not hitbox.Parent
                then
                    error("Queue entry interrupted")
                end
            end

            local function moveRoot(position)
                checkCharacter()

                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(position) * root.CFrame.Rotation
            end

            local nextRoomCheckAt = 0
            local entryStartedAt = os.clock()

            local function entryConfirmed()
                local registeredRoom =
                    tonumber(LocalPlayer:GetAttribute("QueueRoom"))

                if confirmedRoom == roomNumber
                    or registeredRoom == roomNumber
                then
                    return true
                end

                -- ไม่ลองสร้างแทรกคิวที่ผูกกับผู้เล่นอยู่แล้ว
                if registeredRoom ~= nil
                    or LocalPlayer:GetAttribute("QueueLeader") == true
                    or LocalPlayer:GetAttribute("MatchSearching")
                then
                    return false
                end

                local now = os.clock()

                if now - entryStartedAt < 1
                    or now < nextRoomCheckAt
                then
                    return false
                end

                nextRoomCheckAt = now + 0.5

                if not root.Parent or not hitbox.Parent then
                    return false
                end

                -- ตรวจตำแหน่งตามขนาดและการหมุนของ Hitbox จริง
                local localPosition =
                    hitbox.CFrame:PointToObjectSpace(root.Position)

                local halfSize = hitbox.Size * 0.5

                local insideHitbox =
                    math.abs(localPosition.X) <= halfSize.X
                    and math.abs(localPosition.Y) <= halfSize.Y
                    and math.abs(localPosition.Z) <= halfSize.Z

                if not insideHitbox then
                    return false
                end

                local lobby = ReplicatedStorage:FindFirstChild("lobby")
                local stores = lobby and lobby:FindFirstChild("stores")
                local module = stores
                    and stores:FindFirstChild("ququeRoomStore")

                if not module or not module:IsA("ModuleScript") then
                    return false
                end

                local ok, roomData = pcall(function()
                    local roomNamespace = require(module)
                    local roomStore = roomNamespace.namespace:getStore(
                        "room " .. tostring(roomNumber)
                    )

                    return roomStore:toTable()
                end)

                if not ok or type(roomData) ~= "table" then
                    return false
                end

                if roomData.status ~= "creating" then
                    return false
                end

                warn(
                    "[AutoJoin] Inside creating room; entry event missing"
                        .. " -> attempt CreateQuque once | Room:",
                    roomNumber
                )

                -- อนุญาตให้ createQueue ลองส่งคำขอ
                -- ยังไม่ใช่การยืนยันว่าคิวถูกสร้างแล้ว
                return true
            end

            for attempt = 1, 2 do
                checkCharacter()

                if entryConfirmed() then
                    print("[AutoJoin] Room entry ready; attempting queue creation:", roomNumber)
                    return
                end

                if attempt == 2 then
                    -- ออกนอกขอบเขต Hitbox ตามขนาดและการหมุนจริง
                    -- คงระดับความสูงของตัวละคร
                    local cf = hitbox.CFrame
                    local half = hitbox.Size * 0.5

                    local extentX =
                        math.abs(cf.RightVector.X) * half.X
                        + math.abs(cf.UpVector.X) * half.Y
                        + math.abs(cf.LookVector.X) * half.Z

                    local side =
                        root.Position.X >= hitbox.Position.X and 1 or -1

                    local outsidePosition = Vector3.new(
                        hitbox.Position.X + side * (extentX + 6),
                        root.Position.Y,
                        root.Position.Z
                    )

                    confirmedRoom = nil

                    warn(
                        "[AutoJoin] Entry unconfirmed -> exit and re-enter:",
                        roomNumber
                    )

                    moveRoot(outsidePosition)

                    local outsideDeadline = os.clock() + 0.8
                    repeat
                        checkCharacter()
                        task.wait(0.1)
                    until os.clock() >= outsideDeadline

                    -- หาก Server ยืนยันเข้าคิวระหว่างรอ ไม่ส่งเข้าใหม่
                    if entryConfirmed() then
                        print("[AutoJoin] Room entry ready; attempting queue creation:", roomNumber)
                        return
                    end
                end

                moveRoot(
                    inside.Position + Vector3.new(0, HEIGHT_OFFSET, 0)
                )

                print(
                    "[AutoJoin] Moving into queue room:",
                    roomNumber,
                    "| Entry attempt:", attempt
                )

                local deadline = os.clock() + ENTRY_TIMEOUT

                repeat
                    checkCharacter()

                    if entryConfirmed() then
                        print(
                            "[AutoJoin] Room entry ready; attempting queue creation:",
                            roomNumber
                        )
                        return
                    end

                    task.wait(0.1)
                until os.clock() >= deadline
            end

            error(string.format(
                "Room entry timed out after re-entry"
                    .. " | Requested=%s QueueRoom=%s WindowRoom=%s"
                    .. " | Root=%s",
                tostring(roomNumber),
                tostring(LocalPlayer:GetAttribute("QueueRoom")),
                tostring(confirmedRoom),
                tostring(root.Position)
            ))
        end)

        cleanup()

        if not ok then
            error(entryError, 0)
        end
    end

    function RuntimeFix.createQueue(payload)
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        if type(RuntimeFix.isTraitReadyForJoin) ~= "function"
            or not RuntimeFix.isTraitReadyForJoin()
        then
            error(
                "AutoJoin blocked: Sung Jinwoo Trait not ready"
            )
        end

        if type(payload) ~= "table" then
            error("Queue payload must be a table")
        end

        -- ฟังก์ชันนี้รองรับเส้นทาง Story/Raid ของสคริปต์เดิม
        if payload.gamemode ~= "Story"
            and payload.gamemode ~= "Raid"
            and payload.gamemode ~= "Trials"
        then
            error("Unsupported queue mode: " .. tostring(payload.gamemode))
        end

        local request = {}

        for key, value in pairs(payload) do
            request[key] = value
        end

        if request.gamemode == "Trials" then
            if request.map ~= "Trials" then
                error("Invalid Trials map")
            end

            request.chapter = 0
            request.difficulty = 1
        else
            request.floor = 0

            if request.gamemode == "Raid" then
                request.chapter = 0
                request.difficulty = 4
            end
        end

        local function requireInteger(name, minimum, maximum)
            local value = request[name]

            if type(value) ~= "number"
                or value ~= value
                or value % 1 ~= 0
                or value < minimum
                or value > maximum
            then
                error("Invalid queue field: " .. name)
            end
        end

        if type(request.map) ~= "string" or request.map == "" then
            error("Invalid queue map")
        end

        if type(request.friendsOnly) ~= "boolean" then
            error("Invalid queue friendsOnly")
        end

        requireInteger("chapter", 0, 3)
        if request.gamemode == "Trials" then
            requireInteger("floor", 1, 65535)
        else
            requireInteger("floor", 0, 0)
        end
        requireInteger("difficulty", 1, 4)
        requireInteger("maxPlayers", 1, 6)
        requireInteger("roomNumber", 1, 6)

        local packets = RuntimeFix.getPackets()
        local packet = packets and packets.createQuque

        if not packet or type(packet.fire) ~= "function" then
            error("createQuque packet unavailable")
        end

        -- เข้าเขตห้องและรอ Server ยืนยันก่อนสร้างคิว
        RuntimeFix.enterQueueRoom(request.roomNumber, packets)

        if AutoFarmSession.Cancelled then
            error("Queue creation cancelled")
        end

        if LocalPlayer:GetAttribute("MatchSearching") then
            error("Queue creation blocked: MatchSearching")
        end

        -- enterQueueRoom มีการรอ:
        -- ตรวจใหม่ก่อนส่งคำขอสร้างคิวจริง
        if AutoFarmSession.Cancelled
            or not RuntimeFix.isTraitReadyForJoin()
        then
            error("AutoJoin blocked: Trait state changed")
        end

        -- เริ่มจับเวลาก่อนส่ง เผื่อ fire เกิดข้อผิดพลาด
        -- โดยที่คำขออาจถูกส่งออกไปแล้ว
        RuntimeFix.markQueueRequestSent()

        -- ใช้ serializer ของเกมปัจจุบัน
        packet:fire(request)

        print(string.format(
            "[AutoJoin] Queue requested | %s/%s"
                .. " | Chapter=%d Floor=%d Difficulty=%d"
                .. " | Players=%d Room=%d",
            request.gamemode,
            request.map,
            request.chapter,
            request.floor,
            request.difficulty,
            request.maxPlayers,
            request.roomNumber
        ))

        return true
    end

