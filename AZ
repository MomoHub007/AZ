    function RuntimeFix.equipPostMonarchActive(character)
        local data = RuntimeFix.readAccount()
        local slot = data
            and RuntimeFix.findOwnedSlot(data, character)

        if not slot then
            return false
        end

        local function confirmed(current)
            local equipped = current
                and current.EquippedCharacterSlots

            return type(equipped) == "table"
                and tonumber(equipped.Slot1) == slot
                and current.character == character
        end

        if confirmed(data) then
            return true
        end

        local packets = RuntimeFix.getPackets()
        local packet = packets.equipCharacterSlot

        if not packet or type(packet.fire) ~= "function" then
            error("equipCharacterSlot unavailable")
        end

        EquipCharacterSlotRequestId =
            EquipCharacterSlotRequestId % 65535 + 1

        packet:fire({
            slot = slot,
            gameSlot = 1,
            requestId = EquipCharacterSlotRequestId,
        })

        local deadline = os.clock() + 5

        repeat
            if AutoFarmSession.Cancelled then
                return false
            end

            if confirmed(RuntimeFix.readAccount()) then
                RuntimeFix.postMonarchLog(
                    "Active confirmed: " .. character
                )
                return true
            end

            task.wait(0.1)
        until os.clock() >= deadline

        RuntimeFix.postMonarchLog(
            "Waiting for Active confirmation: " .. character
        )

        return false
    end

