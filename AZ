    -- อ่านอย่างเดียว: เลือกชิ้นที่ยังไม่มีและวัตถุดิบครบ
    function RuntimeFix.getReadyAccessoryCraft(data)
        if type(data) ~= "table"
            or type(data.accessory) ~= "table"
            or type(data.material) ~= "table"
        then
            error("Accessory/material data unavailable")
        end

        local recipes = {}

        for _, name in ipairs({"Crown", "Wings"}) do
            local source = BLAST_ARCHER_CRAFT_REQUIREMENTS[name]
            local materials = {}

            for id, amount in pairs(source.materials) do
                table.insert(materials, {id, amount})
            end

            table.insert(recipes, {
                Id = source.accessoryId,
                Index = source.craftIndex,
                Name = source.name,
                Materials = materials,
            })
        end

        -- ใช้สูตร Capsule Scarf / Sun Glasses จากระบบเดิม
        if type(RuntimeFix.BathCraftRecipes) ~= "table" then
            error("BathCraftRecipes unavailable")
        end

        for _, recipe in ipairs(RuntimeFix.BathCraftRecipes) do
            table.insert(recipes, recipe)
        end

        for _, recipe in ipairs(recipes) do
            if not isAccessoryOwned(data, recipe.Id)
                and hasCraftMaterials(data, recipe.Materials)
            then
                return recipe
            end
        end

        return nil
    end

    -- คราฟต์เฉพาะชิ้นที่พร้อม ไม่ออกไปฟาร์มจากฟังก์ชันนี้
    function RuntimeFix.craftReadyAccessories()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            or RuntimeFix.Crafting
            or ActiveLobbyQueue
            or AutoJoinStarted
        then
            return false
        end

        if os.clock() < (RuntimeFix.ReadyCraftRetryAt or 0) then
            return false
        end

        RuntimeFix.Crafting = true

        local ok, result = pcall(function()
            -- มีทั้งหมดสี่ชิ้น อ่านยอดใหม่หลังคราฟต์ทุกครั้ง
            for _ = 1, 4 do
                if AutoFarmSession.Cancelled then
                    return false
                end

                local data, readError = RuntimeFix.readAccount()

                if not data then
                    error("Craft account unavailable: " .. tostring(readError))
                end

                local recipe = RuntimeFix.getReadyAccessoryCraft(data)

                if not recipe then
                    return true
                end

                print("[AutoCraft] Ready first ->", recipe.Name)

                local crafted = craftAccessoryByIndex(
                    recipe.Index,
                    recipe.Id,
                    recipe.Name,
                    recipe.Materials
                )

                if not crafted then
                    RuntimeFix.ReadyCraftRetryAt = os.clock() + 5
                    warn("[AutoCraft] Waiting for confirmation:", recipe.Name)
                    return false
                end
            end

            return true
        end)

        RuntimeFix.Crafting = false

        if not ok then
            RuntimeFix.ReadyCraftRetryAt = os.clock() + 5
            warn("[AutoCraft] Ready craft failed:", result)
            return false
        end

        return result == true
    end

