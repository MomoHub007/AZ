local function findLowestRaritySlot(): (number?, string?)
    local data = RuntimeFix.readAccount()
    local unlocked = data and data.UnlockedCharacters

    if type(unlocked) ~= "table" then
        return nil, nil
    end

    local protected = {
        sukuna = true,
        miyabi = true,
        cataclysm = true,
        katakuri = true,
        hutao = true,
        sung_jinwoo = true,
    }

    -- เลือกช่องแรกที่ปลดล็อกและแทนที่ได้
    for slotNumber = 1, 4 do
        local slot = unlocked["Slot" .. slotNumber]

        if type(slot) == "table"
            and slot.Unlocked == true
            and type(slot.Character) == "string"
            and slot.Favourite ~= true
            and not protected[slot.Character]
        then
            return slotNumber, slot.Character
        end
    end

    -- ไม่มี fallback ไปช่องที่ป้องกันไว้
    return nil, nil
end

local function handleUnitStorageAutoReplace(): boolean
    if AutoFarmSession.Cancelled
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
    then
        return false
    end

    local data = RuntimeFix.readAccount()

    if not data then
        return false
    end

    local pending = RuntimeFix.StoredPending

    -- ตรวจคำขอเดิมก่อนส่งคำขอใหม่
    if pending then
        local unlocked = data.UnlockedCharacters
        local slot = type(unlocked) == "table"
            and unlocked["Slot" .. pending.slot]

        local placed = type(slot) == "table"
            and slot.Unlocked == true
            and slot.Character == pending.character
            and RuntimeFix.storageCount(data, pending.character)
                < pending.beforeCount

        if placed then
            RuntimeFix.StoredPending = nil

            print(
                "[UnitStorage] Placement CONFIRMED:",
                pending.character,
                "| Inventory Slot:",
                pending.slot
            )

            prepareTeam()
            return true
        end

        if pending.response
            and pending.response.success == false
        then
            warn(
                "[UnitStorage] Server rejected:",
                pending.response.reason
            )

            RuntimeFix.StoredPending = nil
            RuntimeFix.StoredRetryAt = os.clock() + 3
            return false
        end

        if os.clock() >= pending.deadline
            and not pending.warned
        then
            pending.warned = true

            warn(
                "[UnitStorage] Placement not confirmed.",
                "Waiting for the original request; no duplicate sent."
            )
        end

        return false
    end

    if os.clock() < RuntimeFix.StoredRetryAt
        or RuntimeFix.PreparingTeam
        or RuntimeFix.JoinOwner
    then
        return false
    end

    local character = nil

    if RuntimeFix.storageCount(data, "sung_jinwoo") > 0
        and not RuntimeFix.findOwnedSlot(data, "sung_jinwoo")
    then
        character = "sung_jinwoo"
    elseif RuntimeFix.storageCount(data, "hutao") > 0
        and not RuntimeFix.findOwnedSlot(data, "hutao")
    then
        -- เก็บความสามารถรับ Hu Tao ของระบบเดิม
        character = "hutao"
    end

    if not character then
        return false
    end

    local targetSlot = findLowestRaritySlot()

    if not targetSlot then
        if os.clock() >= RuntimeFix.StorageWarningAt then
            RuntimeFix.StorageWarningAt = os.clock() + 10

            warn(
                "[UnitStorage] No safe unlocked slot.",
                "Protected characters will not be replaced."
            )
        end

        return false
    end

    local packets = RuntimeFix.getPackets()

    if not packets.placeStoredUnit
        or type(packets.placeStoredUnit.fire) ~= "function"
    then
        error("placeStoredUnit unavailable")
    end

    -- อ่านข้อมูลใหม่ก่อนส่ง เพื่อป้องกันช่องเปลี่ยนระหว่างทาง
    local latest = RuntimeFix.readAccount()
    local unlocked = latest and latest.UnlockedCharacters
    local target = type(unlocked) == "table"
        and unlocked["Slot" .. targetSlot]

    local protected = {
        sukuna = true,
        miyabi = true,
        hutao = true,
        sung_jinwoo = true,
    }

    if type(target) ~= "table"
        or target.Unlocked ~= true
        or type(target.Character) ~= "string"
        or target.Favourite == true
        or protected[target.Character]
        or RuntimeFix.findOwnedSlot(latest, character)
    then
        return false
    end

    local beforeCount = RuntimeFix.storageCount(latest, character)

    if beforeCount <= 0 or AutoFarmSession.Cancelled then
        return false
    end

    RuntimeFix.StoredRequestId =
        RuntimeFix.StoredRequestId % 65535 + 1

    RuntimeFix.StoredPending = {
        character = character,
        slot = targetSlot,
        requestId = RuntimeFix.StoredRequestId,
        beforeCount = beforeCount,
        deadline = os.clock() + 10,
        response = nil,
        warned = false,
    }

    packets.placeStoredUnit:fire({
        character = character,
        slot = targetSlot,
        requestId = RuntimeFix.StoredRequestId,
    })

    print(
        "[UnitStorage] Request sent:",
        character,
        "| Inventory Slot:",
        targetSlot
    )

    return false
end

function startUnitStorageWatcher()
    if RuntimeFix.StorageWatcherStarted
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        or AutoFarmSession.Cancelled
    then
        return
    end

    RuntimeFix.StorageWatcherStarted = true

    task.spawn(function()
        -- ลงทะเบียนรับผลครั้งเดียวต่อ session
        local listenerReady = false

        while not AutoFarmSession.Cancelled do
            local ok, listenerError = pcall(function()
                local packets = RuntimeFix.getPackets()

                if not packets.storedUnitPlaced
                    or type(packets.storedUnitPlaced.on) ~= "function"
                then
                    error("storedUnitPlaced unavailable")
                end

                local disconnect = packets.storedUnitPlaced:on(
                    function(result)
                        if AutoFarmSession.Cancelled
                            or type(result) ~= "table"
                        then
                            return
                        end

                        local pending = RuntimeFix.StoredPending

                        if pending
                            and result.requestId == pending.requestId
                            and result.character == pending.character
                            and result.slot == pending.slot
                        then
                            pending.response = result
                        end
                    end
                )

                if typeof(disconnect) == "function" then
                    table.insert(AutoFarmSession.Cleanups, disconnect)
                elseif typeof(disconnect) == "RBXScriptConnection" then
                    table.insert(AutoFarmSession.Cleanups, function()
                        disconnect:Disconnect()
                    end)
                end
            end)

            if ok then
                listenerReady = true
                break
            end

            warn("[UnitStorage] Listener failed:", listenerError)
            task.wait(2)
        end

        while listenerReady and not AutoFarmSession.Cancelled do
            local ok, handlerError =
                pcall(handleUnitStorageAutoReplace)

            if not ok then
                warn("[UnitStorage] Handler failed:", handlerError)
            end

            task.wait(0.5)
        end

        RuntimeFix.StorageWatcherStarted = false
    end)
end

