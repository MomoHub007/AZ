                StartAutoUpgradeSkillTree()
            end

            if AZEnabled("Equipment", "BestTitle") then
                StartAutoEquipBestTitle()
            end

            if AZEnabled("Equipment", "BestAccessory") then
                StartAutoEquipBestAccessory()
            end

            if AZEnabled("Equipment", "CraftBlastArcher") then
                StartAutoCraftBlastArcher()
            end

            if AZEnabled("Characters", "AutoRoll") then
                StartCustomAutoRoll()
            end

        end

        task.spawn(function()
            while not AutoFarmSession.Cancelled do
                local roundHUD = PlayerGui:FindFirstChild("RoundHUD")
                local hud = PlayerGui:FindFirstChild("HUD")
                local hudRoot = hud and hud:FindFirstChild("HUD")
                local bottomLeft =
                    hudRoot
                    and hudRoot:FindFirstChild("BottomLeftHolder")

                local main =
                    bottomLeft
                    and bottomLeft:FindFirstChild("main")

                local skillsFolder =
                    main
                    and main:FindFirstChild("skills")

                local world = workspace:FindFirstChild("World")
                local areasFolder =
                    world
                    and world:FindFirstChild("Areas")

                local mapFolder =
                    world
                    and world:FindFirstChild("Map")

                local performM1 =
                    ReplicatedStorage:FindFirstChild("performM1")

                local enemyCountLabel =
                    roundHUD
                    and roundHUD:FindFirstChild("Container")
                    and roundHUD.Container:FindFirstChild("TopPart")
                    and roundHUD.Container.TopPart:FindFirstChild("RemainingFrame")
                    and roundHUD.Container.TopPart.RemainingFrame:FindFirstChild("EnemyCount")

                if enemyCountLabel
                    and areasFolder
                    and mapFolder
                    and performM1
                then
                    EnemyCountLabel = enemyCountLabel
                    SkillsFolder = skillsFolder
                    AreasFolder = areasFolder
                    MapFolder = mapFolder
                    PerformM1 = performM1

                    print("[Loader] Gameplay objects READY")
                    if AZEnabled("Combat", "AutoFarm") then
                        StartAutoFarm()
                    end

                    return
                end

                task.wait(1)
            end
        end)
    end)

