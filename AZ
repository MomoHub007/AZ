    local AutoClaimRewardsStarted = false
    RuntimeFix.AutoClaimInitialReady = false
    RuntimeFix.AutoClaimJoinReleased = false

    function StartAutoClaimRewards()
        local AUTO_CLAIM_SCAN_DELAY = 20
        local AUTO_CLAIM_RESPONSE_TIMEOUT = 7
        local AUTO_CLAIM_RETRY_DELAY = 90

        if AutoClaimRewardsStarted
            or AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return
        end

        AutoClaimRewardsStarted = true

        task.spawn(function()
            local requestCounter = math.random(10000, 60000)
            local nextQuestAttemptAt = 0
            local milestoneRetryAt = {}

            local function nextRequestId()
                requestCounter =
                    requestCounter % 65535 + 1

                return requestCounter
            end

            local function canContinue()
                return not AutoFarmSession.Cancelled
                    and game.PlaceId == AUTO_JOIN_PLACE_ID
            end

            -- ส่งคำขอและรอผลยืนยันจาก Server
            local function sendAndConfirm(
                requestPacket,
                resultPacket,
                payload,
                expectedLevel
            )
                if not requestPacket
                    or type(requestPacket.fire) ~= "function"
                    or not resultPacket
                    or type(resultPacket.on) ~= "function"
                then
                    return false, "Packet API unavailable"
                end

                local requestId = nextRequestId()
                payload.requestId = requestId

                local response = nil
                local active = true

                local okListen, disconnect = pcall(function()
                    return resultPacket:on(function(result)
                        if not active
                            or type(result) ~= "table"
                            or result.requestId ~= requestId
                        then
                            return
                        end

                        if expectedLevel ~= nil
                            and tonumber(result.level) ~= expectedLevel
                        then
                            return
                        end

                        response = result
                    end)
                end)

                if not okListen then
                    warn("[AutoClaim] Listener failed:", disconnect)
                    return false, "Listener failed"
                end

                local function cleanup()
                    active = false

                    if typeof(disconnect) == "function" then
                        pcall(disconnect)
                    elseif typeof(disconnect) == "RBXScriptConnection" then
                        disconnect:Disconnect()
                    end
                end

                if typeof(disconnect) ~= "function"
                    and typeof(disconnect) ~= "RBXScriptConnection"
                then
                    cleanup()
                    return false, "Listener cleanup unavailable"
                end

                if not canContinue() then
                    cleanup()
                    return false, "Cancelled"
                end

                local sent, sendError = pcall(function()
                    requestPacket:fire(payload)
                end)

                if not sent then
                    cleanup()
                    return false, tostring(sendError)
                end

                local deadline =
                    os.clock() + AUTO_CLAIM_RESPONSE_TIMEOUT

                while canContinue()
                    and response == nil
                    and os.clock() < deadline
                do
                    task.wait(0.1)
                end

                cleanup()

                if not canContinue() then
                    return false, "Cancelled"
                end

                if not response then
                    return false, "Response timeout"
                end

                return response.success == true,
                    tostring(response.reason or "")
            end

            local function processClaims(packets, milestoneConfig)
                local data, readError = RuntimeFix.readAccount()

                if not data then
                    warn("[AutoClaim] Account unavailable:", readError)
                    return
                end

                --==========================================
                -- Quest Claim All
                --==========================================

                local quests = data.quests

                if type(quests) == "table"
                    and type(quests.completed) == "table"
                    and type(quests.claimed) == "table"
                then
                    local claimableCount = 0

                    for questId, completed in pairs(quests.completed) do
                        if completed == true
                            and quests.claimed[questId] ~= true
                        then
                            claimableCount += 1
                        end
                    end

                    if claimableCount > 0
                        and os.clock() >= nextQuestAttemptAt
                    then
                        -- ตั้ง Cooldown ก่อนส่ง เพื่อกันคำขอซ้ำ
                        nextQuestAttemptAt =
                            os.clock() + AUTO_CLAIM_RETRY_DELAY

                        print(
                            "[AutoClaim] Quest rewards ready:",
                            claimableCount
                        )

                        local success, reason = sendAndConfirm(
                            packets.claimQuestRewards,
                            packets.questActionResult,
                            {},
                            nil
                        )

                        if success then
                            print(
                                "[AutoClaim] Quest Claim All CONFIRMED"
                            )
                        else
                            warn(
                                "[AutoClaim] Quest Claim All failed:",
                                reason
                            )

                            -- ถ้าระบบตอบกลับผิดพลาด
                            -- หยุดรอบนี้ก่อน ไม่ยิงคำขอต่อทันที
                            return
                        end

                        task.wait(0.3)
                    end
                end

                if not canContinue() then
                    return
                end

                -- อ่านข้อมูลใหม่หลังรับ Quest
                data = RuntimeFix.readAccount()

                if not data then
                    return
                end

                --==========================================
                -- Level Milestones
                --==========================================

                local level, levelError =
                    RuntimeFix.getAccountLevel(data)

                if not level then
                    warn(
                        "[AutoClaim] Cannot read level:",
                        levelError
                    )
                    return
                end

                local claimed = data.claimedLevelMilestones

                if type(claimed) ~= "table"
                    or type(milestoneConfig.order) ~= "table"
                then
                    return
                end

                local availableLevels = {}

                for _, value in ipairs(milestoneConfig.order) do
                    local milestoneLevel = tonumber(value)

                    if milestoneLevel
                        and milestoneLevel >= 1
                        and milestoneLevel <= 65535
                        and milestoneLevel % 1 == 0
                        and milestoneLevel <= level
                        and claimed[tostring(milestoneLevel)] ~= true
                        and os.clock() >= (
                            milestoneRetryAt[milestoneLevel] or 0
                        )
                    then
                        table.insert(
                            availableLevels,
                            milestoneLevel
                        )
                    end
                end

                table.sort(availableLevels)

                for _, milestoneLevel in ipairs(availableLevels) do
                    if not canContinue() then
                        return
                    end

                    milestoneRetryAt[milestoneLevel] =
                        os.clock() + AUTO_CLAIM_RETRY_DELAY

                    print(
                        "[AutoClaim] Claim Milestone:",
                        milestoneLevel
                    )

                    local success, reason = sendAndConfirm(
                        packets.claimLevelMilestone,
                        packets.levelMilestoneClaimed,
                        {
                            level = milestoneLevel,
                        },
                        milestoneLevel
                    )

                    if success then
                        print(
                            "[AutoClaim] Milestone CONFIRMED:",
                            milestoneLevel
                        )
                    else
                        warn(
                            "[AutoClaim] Milestone failed:",
                            milestoneLevel,
                            reason
                        )

                        -- ไม่ส่ง Milestone ถัดไปเมื่อเกิดปัญหา
                        return
                    end

                    task.wait(0.35)
                end

                --==========================================
                -- Verify All Claims Before Auto Join
                --==========================================

                local fresh, verifyError = RuntimeFix.readAccount()

                if not fresh then
                    warn("[AutoClaim] Verify failed:", verifyError)
                    return
                end

                local freshQuests = fresh.quests
                local freshMilestones = fresh.claimedLevelMilestones

                -- ต้องอ่านข้อมูล Quest และ Milestone ได้จริง
                if type(freshQuests) ~= "table"
                    or type(freshQuests.completed) ~= "table"
                    or type(freshQuests.claimed) ~= "table"
                    or type(freshMilestones) ~= "table"
                then
                    warn("[AutoClaim] Account claim state not ready")
                    return
                end

                local remainingQuests = 0

                for questId, completed in pairs(freshQuests.completed) do
                    if completed == true
                        and freshQuests.claimed[questId] ~= true
                    then
                        remainingQuests += 1
                    end
                end

                local currentLevel, levelError =
                    RuntimeFix.getAccountLevel(fresh)

                if currentLevel == nil then
                    warn("[AutoClaim] Level unavailable:", levelError)
                    return
                end

                local remainingMilestones = 0

                for _, value in ipairs(milestoneConfig.order) do
                    local milestoneLevel = tonumber(value)

                    if milestoneLevel
                        and milestoneLevel >= 1
                        and milestoneLevel <= currentLevel
                        and freshMilestones[tostring(milestoneLevel)] ~= true
                    then
                        remainingMilestones += 1
                    end
                end

                if remainingQuests == 0
                    and remainingMilestones == 0
                then
                    if not RuntimeFix.AutoClaimInitialReady then
                        RuntimeFix.AutoClaimInitialReady = true

                        print(
                            "[AutoClaim] ALL REWARDS CONFIRMED"
                                .. " -> AUTO JOIN UNLOCKED"
                        )
                    end
                else
                    print(
                        "[AutoClaim] Waiting | Quests:",
                        remainingQuests,
                        "| Milestones:",
                        remainingMilestones
                    )
                end
            end

            print("[AutoClaim] System Started | Lobby Only")

            while canContinue() do
                local loaded, packets, config = pcall(function()
                    return RuntimeFix.getPackets(),
                        RuntimeFix.requireModule(
                            ReplicatedStorage,
                            {
                                "assets",
                                "config",
                                "levelMilestoneConfig",
                            }
                        )
                end)

                if loaded
                    and type(packets) == "table"
                    and type(config) == "table"
                then
                    local ok, err = pcall(
                        processClaims,
                        packets,
                        config
                    )

                    if not ok then
                        warn("[AutoClaim] Processing error:", err)
                    end
                else
                    warn(
                        "[AutoClaim] Lobby modules unavailable:",
                        packets
                    )
                end

                task.wait(AUTO_CLAIM_SCAN_DELAY)
            end

            AutoClaimRewardsStarted = false
            print("[AutoClaim] System Stopped")
        end)
    end

