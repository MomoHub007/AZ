    function RuntimeFix.monarchStage(data)
        local progress = data.achievements
            and data.achievements.progress
        local stage = tonumber(
            progress and progress["evo.sung_jinwoo"]
        ) or 0

        if stage > 0 then
            return math.clamp(stage, 0, 3)
        end

        local character = data.CharactersData
            and data.CharactersData.sung_jinwoo

        return character
            and character.IsUltimateUnlocked == true
            and 1 or 0
    end

