    end

    if not event:IsA("RemoteEvent") then
        warn("[AutoEvolve] EvolveCharacter is not RemoteEvent")
        return false
    end

    local bytes = {
        115,
        117,
        107,
        117,
        110,
        97,
        6,
    }
    local packet = buffer.create(#bytes)

    for i, value in ipairs(bytes) do
        buffer.writeu8(packet, i - 1, value)
    end

    local fireOk, fireError = pcall(function()
        event:FireServer(packet)
    end)

    if not fireOk then
        warn("[AutoEvolve] Evolve request failed:", fireError)
        return false
    end

    SukunaEvolveTriggered = true

    print("[AutoEvolve] Sukuna Evolution request sent.")
    return true
end

local HutaoEvolveTriggered = false
local HutaoEvoFarmStarted = false
local HutaoEvolveRetryAt = 0

function getHutaoEvoStatus()
    local ok, data, materialConfig = pcall(function()
        local accountNamespace = require(ReplicatedStorage.global.stores.accountNamespace)
        local matConfig = require(ReplicatedStorage.assets.config.materialConfig)
        return accountNamespace.getLocalPlayerAccount():toTable(), matConfig
    end)

    if not ok or type(data) ~= "table" then
        return { isReady = false, missingStage = nil }
    end

    local hutaoData = data.CharactersData and data.CharactersData.hutao
    if hutaoData and hutaoData.IsUltimateUnlocked == true then
        return { isReady = false, isEvolved = true }
    end

    local materials = data.material
    local counts = {
        ["101"] = 0, -- Fine Cloth (need 20)
        ["110"] = 0, -- Magic Pendant (need 8)
        ["113"] = 0, -- Ghost (need 25)
        ["114"] = 0, -- Staff of Homa (need 10)
    }

    if type(materials) == "table" then
        local entries = materials.entries or materials
        for id, amount in pairs(entries) do
            local sId = tostring(id)
            if counts[sId] ~= nil then
                local num = amount
                if type(amount) == "table" then
                    num = amount.Amount or amount.amount or amount.Count or amount.count or amount.Value or amount.value or 0
                end
                counts[sId] = tonumber(num) or 0
            end
        end
    end

    local currencies = data.currencies or {}
    local money = tonumber(currencies.money) or 0
    local gems = tonumber(currencies.gems) or 0

    print(string.format("[AutoEvoHutao] Materials -> Staff of Homa: %d/10 | Ghost: %d/25 | Magic Pendant: %d/8 | Fine Cloth: %d/20 | Money: %d/1M | Gems: %d/10K",
        counts["114"], counts["113"], counts["110"], counts["101"], money, gems
    ))

    local needHoma = counts["114"] < 10
    local needGhost = counts["113"] < 25
    local needPendant = counts["110"] < 8
    local needCloth = counts["101"] < 20
    local needCurrency = (money < 1000000) or (gems < 10000)

    if not needHoma and not needGhost and not needPendant and not needCloth and not needCurrency then
        return { isReady = true, counts = counts }
    end

    -- Priority of stage routing:
    -- 1. Spirited Away Raid (Bathtub) for Staff of Homa & Ghost
    if needHoma or needGhost then
        return { isReady = false, missingStage = "Raid_BathTub" }
    end

    -- 2. Story Hxh Chapter 1 Nightmare for Magic Pendant & Fine Cloth
    if needPendant then
        return { isReady = false, missingStage = "Story_Hxh_Nightmare" }
    end

    -- 3. Fine Cloth fallback (Story Chapter 3)
    if needCloth then
        return { isReady = false, missingStage = "Story_Hxh_Chapter3" }
    end

    return { isReady = false, missingStage = nil, needCurrency = true }
end

