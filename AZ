        currentMaterials["Fine Cloth"],
        "| Eyeball:",
        currentMaterials["Eyeball"],
        "| Cursed Finger:",
        currentMaterials["Cursed Finger"],
        "| Magic Pendant:",
        currentMaterials["Magic Pendant"],
        "| Gems:",
        gems
    )

    for materialName, requiredAmount in pairs(requiredMaterials) do
        local currentAmount = currentMaterials[materialName]

        if currentAmount < requiredAmount then
            print(
                "[AutoEvolve] Not enough",
                materialName,
                "| Have:",
                currentAmount,
                "| Need:",
                requiredAmount
            )

            return false
        end
    end

    if gems < 1750 then
        print(
            "[AutoEvolve] Not enough Gems | Have:",
            gems,
            "| Need: 1750"
        )

        return false
    end

    print("[AutoEvolve] Sukuna materials and Gems COMPLETE")

    local event =
        ReplicatedStorage:FindFirstChild("EvolveCharacter")

