                "[AutoRoll] Sukuna already equipped | Game Slot:",
                equippedSukuna.gameSlot,
                "| Inventory Slot:",
                equippedSukuna.inventorySlot
            )

            return true
        end

        local event =
            ReplicatedStorage:FindFirstChild("EquipCharacterSlot")

        if not event then
            warn("[AutoRoll] ReplicatedStorage.EquipCharacterSlot not found")
            return false
        end

        if not event:IsA("RemoteEvent") then
            warn("[AutoRoll] EquipCharacterSlot is not RemoteEvent")
            return false
        end

        local requestId = EquipCharacterSlotRequestId

        EquipCharacterSlotRequestId += 1

        if EquipCharacterSlotRequestId > 65535 then
            EquipCharacterSlotRequestId = 1
        end

        -- Observed packet layout: {characterSlot, 5, requestIdHigh, requestIdLow}
        local bytes = {
            characterSlotNumber,
            5,
            math.floor(requestId / 256),
            requestId % 256,
        }

        local packet = buffer.create(#bytes)

        for i, value in ipairs(bytes) do
            buffer.writeu8(packet, i - 1, value)
        end

        local fireOk, fireError = pcall(function()
            event:FireServer(packet)
        end)

        if not fireOk then
            warn("[AutoRoll] Equip Sukuna failed:", fireError)
            return false
        end

        print(
            "[AutoRoll] Equip Sukuna | Character Slot:",
            characterSlotNumber,
            "| Equip Packet Slot: 5 | RequestId:",
            requestId
        )

        return true
    end

