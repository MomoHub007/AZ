    local invisibleSequence = NumberSequence.new(1)
    local zeroSize = NumberSequence.new(0)

    local function isVisualContainer(instance)
        local current = instance.Parent

        while current and current ~= workspace do
            if current.Name == "effects"
                or current.Name == "EmittedPartsUsingPart_icle"
                or current.Name == "Part_IclesPooled"
            then
                return true
            end

            current = current.Parent
        end

        return false
    end

    local function removeRecord(instance)
        local record = records[instance]
        if not record then
            return
        end

        records[instance] = nil

        for _, connection in ipairs(record.Connections) do
            connection:Disconnect()
        end
    end

    local function lockProperty(instance, property, value)
        local record = records[instance]

        if not record then
            record = {
                Original = {},
                Forced = {},
                Connections = {},
                Applying = false,
            }

            records[instance] = record

            table.insert(
                record.Connections,
                instance.Destroying:Connect(function()
                    removeRecord(instance)
                end)
            )
        end

        if record.Forced[property] == nil then
            record.Original[property] = instance[property]
            record.Forced[property] = value

            table.insert(
                record.Connections,
                instance:GetPropertyChangedSignal(property):Connect(function()
                    if not running
                        or AutoFarmSession.Cancelled
                        or record.Applying
                        or not instance.Parent
                    then
                        return
                    end

                    record.Applying = true

                    pcall(function()
                        if instance[property] ~= record.Forced[property] then
                            instance[property] = record.Forced[property]
                        end
                    end)

                    record.Applying = false
                end)
            )
        end

        if instance[property] ~= value then
            instance[property] = value
        end
    end

    local function suppress(instance)
        if not running
            or AutoFarmSession.Cancelled
            or not instance
            or not instance.Parent
            or instance:GetAttribute("KaiTunOverlayEffect") == true
        then
            return
        end

        if instance:IsA("ParticleEmitter") then
            lockProperty(instance, "Enabled", false)

            -- Emit() ยังทำงานได้ แต่อนุภาคไม่มีภาพให้แสดง
            lockProperty(instance, "Transparency", invisibleSequence)
            lockProperty(instance, "Size", zeroSize)
            instance:Clear()

        elseif instance:IsA("Trail") then
            lockProperty(instance, "Enabled", false)
            lockProperty(instance, "Transparency", invisibleSequence)
            instance:Clear()

        elseif instance:IsA("Beam") then
            lockProperty(instance, "Enabled", false)
            lockProperty(instance, "Transparency", invisibleSequence)

        elseif instance:IsA("Smoke")
            or instance:IsA("Fire")
            or instance:IsA("Sparkles")
            or instance:IsA("Highlight")
            or instance:IsA("PostEffect")
        then
            lockProperty(instance, "Enabled", false)

        elseif instance:IsA("ScreenGui") then
            -- เฉพาะ Flash ที่รายงานยืนยัน ไม่ปิด HUD หรือ UI สคริปต์
            if instance.Name == "ImpactFx"
                or instance.Name == "SungJinwooImpact"
            then
                lockProperty(instance, "Enabled", false)
            end

        elseif isVisualContainer(instance) then
            if instance:IsA("BasePart") then
                lockProperty(instance, "LocalTransparencyModifier", 1)

            elseif instance:IsA("Decal")
                or instance:IsA("Texture")
            then
                lockProperty(instance, "Transparency", 1)

            elseif instance:IsA("Light") then
                lockProperty(instance, "Enabled", false)
            end
        end
    end

    local function stop()
        running = false

        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)

        -- ตัด Property Listener ทั้งหมดก่อนคืนค่า
        for _, record in pairs(records) do
            for _, connection in ipairs(record.Connections) do
                connection:Disconnect()
            end
        end

        for instance, record in pairs(records) do
            if instance.Parent then
                for property, original in pairs(record.Original) do
                    pcall(function()
                        if instance[property] == record.Forced[property] then
                            instance[property] = original
                        end
                    end)
                end
            end
        end

        table.clear(records)
    end

    table.insert(AutoFarmSession.Cleanups, stop)

    if AZEnabled("Performance", "HideSkillEffects") then
        running = true

        task.spawn(function()
            local player = Players.LocalPlayer

            if not player then
                running = false
                return
            end

            local playerGui = player:WaitForChild("PlayerGui", 10)

            if not running or AutoFarmSession.Cancelled then
                return
            end

            local containers = {
                workspace,
                game:GetService("Lighting"),
            }

            if playerGui then
                table.insert(containers, playerGui)
            end

            -- ผูกก่อนสแกน และซ่อนทันทีเมื่อ Instance เข้าสู่โลก
            for _, container in ipairs(containers) do
                table.insert(
                    connections,
                    container.DescendantAdded:Connect(function(instance)
                        pcall(suppress, instance)
                    end)
                )
            end

            for _, container in ipairs(containers) do
                for index, instance in ipairs(container:GetDescendants()) do
                    if not running or AutoFarmSession.Cancelled then
                        return
                    end

                    pcall(suppress, instance)

                    if index % 250 == 0 then
                        task.wait()
                    end
                end
            end

            -- Property Listener จัดการ Pool/Tween;
            -- ลูปนี้ใช้ตรวจการปิดตัวเลือกเท่านั้น
            while running and not AutoFarmSession.Cancelled do
                if not AZEnabled("Performance", "HideSkillEffects") then
                    stop()
                    return
                end

                task.wait(0.5)
            end
        end)
    end
