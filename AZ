    function RuntimeFix.startAntiAfk()
        if RuntimeFix.AntiAfkStarted
            or AutoFarmSession.Cancelled
            or not LocalPlayer
        then
            return
        end

        local virtualUser = game:GetService("VirtualUser")
        local lastAttemptAt = -math.huge
        local MIN_INTERVAL = 10

        local connection = LocalPlayer.Idled:Connect(function()
            if AutoFarmSession.Cancelled then
                return
            end

            local now = os.clock()

            if now - lastAttemptAt < MIN_INTERVAL then
                return
            end

            local camera = workspace.CurrentCamera

            if not camera then
                return
            end

            lastAttemptAt = now

            local ok, err = pcall(function()
                virtualUser:CaptureController()
                virtualUser:ClickButton2(
                    Vector2.new(0, 0),
                    camera.CFrame
                )
            end)

            if ok then
                print("[AntiAFK] Idle input sent")
            else
                warn("[AntiAFK] Input failed:", err)
            end
        end)

        RuntimeFix.AntiAfkStarted = true

        table.insert(AutoFarmSession.Cleanups, function()
            connection:Disconnect()
            RuntimeFix.AntiAfkStarted = false
        end)

        print("[AntiAFK] Started")
    end

    function RuntimeFix.startAutoStageVote()
        if RuntimeFix.StageVoteStarted
            or AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_LEAVE_PLACE_ID
        then
            return
        end

        RuntimeFix.StageVoteStarted = true

        task.spawn(function()
            local POLL_INTERVAL = 0.25
            local RETRY_INTERVAL = 3

            local runStore = nil
            local nextModuleAttempt = 0
            local nextSendAttempt = 0
            local lastWarningAt = -math.huge
            local lastStatus = nil

            local roundKey = nil
            local confirmed = false
            local attempts = 0

            print("[AutoStageStart] Watcher started")

            while not AutoFarmSession.Cancelled
                and game.PlaceId == AUTO_LEAVE_PLACE_ID
            do
                local ok, err = pcall(function()
                    if not runStore then
                        if os.clock() < nextModuleAttempt then
                            return
                        end

                        nextModuleAttempt = os.clock() + 1

                        local loaded = RuntimeFix.requireModule(
                            ReplicatedStorage,
                            {"game", "stores", "runStore"}
                        )

                        local state = loaded
                            and loaded.store
                            and loaded.store.state

                        if not state
                            or not state.status
                            or type(state.status.get) ~= "function"
                        then
                            error("runStore.state.status unavailable")
                        end

                        runStore = loaded
                    end

                    local status = runStore.store.state.status:get()
                    local voteEndsAt =
                        workspace:GetAttribute("StartVoteEndsAt")

                    local hasVoted =
                        LocalPlayer:GetAttribute("StartVoted") == true

                    if status ~= lastStatus then
                        lastStatus = status
                        print("[AutoStageStart] Status:", status)
                    end

                    -- ใช้เวลาปิดโหวตเป็นตัวระบุรอบ
                    if type(voteEndsAt) == "number"
                        and voteEndsAt ~= roundKey
                    then
                        roundKey = voteEndsAt
                        confirmed = false
                        attempts = 0
                        nextSendAttempt = 0

                        print(
                            "[AutoStageStart] New vote round:",
                            roundKey
                        )
                    end

                    -- ถือว่าสำเร็จเมื่อ Server ยืนยันเท่านั้น
                    if hasVoted then
                        if not confirmed then
                            confirmed = true

                            print(
                                "[AutoStageStart] Vote CONFIRMED",
                                "| Votes:",
                                workspace:GetAttribute("StartVotes"),
                                "/",
                                workspace:GetAttribute("StartVoters")
                            )
                        end

                        return
                    end

                    confirmed = false

                    if status ~= "waiting"
                        or type(voteEndsAt) ~= "number"
                    then
                        return
                    end

                    -- ไม่ส่งเมื่อหมดช่วงโหวตแล้ว
                    if voteEndsAt <= workspace:GetServerTimeNow() then
                        return
                    end

                    if os.clock() < nextSendAttempt then
                        return
                    end

                    local remote =
                        ReplicatedStorage:FindFirstChild("startVote")

                    if not remote or not remote:IsA("RemoteEvent") then
                        error("ReplicatedStorage.startVote unavailable")
                    end

                    if AutoFarmSession.Cancelled then
                        return
                    end

                    -- จำกัดความถี่ แม้ FireServer เกิด error
                    nextSendAttempt = os.clock() + RETRY_INTERVAL
                    attempts += 1

                    remote:FireServer(nil)

                    print(
                        "[AutoStageStart] Vote requested",
                        "| Attempt:", attempts,
                        "| Round:", roundKey
                    )
                end)

                if not ok
                    and os.clock() - lastWarningAt >= 5
                then
                    lastWarningAt = os.clock()
                    warn("[AutoStageStart] Error:", err)
                end

                task.wait(POLL_INTERVAL)
            end

            RuntimeFix.StageVoteStarted = false
        end)
    end

    task.spawn(function()
        RuntimeFix.startAntiAfk()
        startAutoLeaveAfterMatch()
        RuntimeFix.startAutoStageVote()

        AutoFarmSession.ApplyFPSCap()

        if not waitForInitialGameReady() then
            return
        end

        if AZEnabled("Performance", "FPSBoost") then
            startFPSBoost()
        end

        print("[Loader] Starting Anime Zero systems...")

        if game.PlaceId == AUTO_JOIN_PLACE_ID then

            -- รับรางวัลก่อน ถ้าผู้ใช้เปิดระบบ
            if AZEnabled("Rewards", "AutoClaim") then
                StartAutoClaimRewards()
            else
