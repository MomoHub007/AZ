            or RuntimeFix.PreparingTeam
            or RuntimeFix.Crafting
            or RuntimeFix.StoredPending
            or os.clock() < HutaoEvolveRetryAt
        then
            return false
        end

        local status = getHutaoEvoStatus()

        if not status or not status.isReady then
            return false
        end

        HutaoEvolveTriggered = true
        RuntimeFix.PreparingTeam = true

        local ok, confirmed = pcall(function()
            if not RuntimeFix.monarchClearQueue() then
                warn("[AutoEvoHutao] Cannot clear lobby queue.")
                return false
            end

            -- gameSlot 1 คือ Active Character
