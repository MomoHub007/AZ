    function RuntimeFix.parseRuntimeMaterials(text)
        assert(type(text) == "string", "Material recipe must be a string")

        local materials = {}

        if text:match("^%s*$") then
            return materials
        end

        for item in (text .. "|"):gmatch("(.-)|") do
            local id, rawAmount =
                item:match("^%s*(%d+)%s*,%s*(%d+)%s*$")

            local amount = tonumber(rawAmount)

            assert(
                id and amount and amount > 0,
                "Invalid material recipe: " .. item
            )

            materials[id] = (materials[id] or 0) + amount
        end

        return materials
    end

    function RuntimeFix.runtimeEvolution(characterId, displayName)
        local entry =
            RuntimeFix.runtimeConfig("evolutionConfig")[characterId]

        assert(
            type(entry) == "table",
            "Evolution config missing: " .. characterId
        )

        assert(
            type(entry.currencies) == "table",
            "Evolution currencies missing: " .. characterId
        )

        local recipe = {
            Character = characterId,
            Name = displayName or characterId,
            Materials = RuntimeFix.parseRuntimeMaterials(entry.ultimate),
            Money = 0,
            Gems = 0,
        }

        for _, cost in ipairs(entry.currencies) do
            assert(
                type(cost) == "table"
                    and type(cost.amount) == "number"
                    and cost.amount >= 0,
                "Invalid evolution currency cost"
            )

            if cost.currency == "money" then
                recipe.Money += cost.amount
            elseif cost.currency == "gems" then
                recipe.Gems += cost.amount
            else
                error(
                    "Unsupported evolution currency: "
                        .. tostring(cost.currency)
                )
            end
        end

        return recipe
    end

    function RuntimeFix.runtimeMonarchRecipes()
        local stages =
            RuntimeFix.runtimeConfig("MonarchPathConfig").Stages

        assert(
            type(stages) == "table" and #stages > 0,
            "Monarch stages unavailable"
        )

        local recipes = {}

        for index, stage in ipairs(stages) do
            assert(type(stage) == "table", "Invalid Monarch stage")

            if stage.Awaken == true then
                recipes[index] = RuntimeFix.runtimeEvolution(
                    "sung_jinwoo",
                    stage.Name
                )
            else
                local currencies = stage.Currencies

                assert(
                    type(currencies) == "table",
                    "Monarch currencies unavailable"
                )

                for key, amount in pairs(currencies) do
                    assert(
                        (key == "money" or key == "gems")
                            and type(amount) == "number"
                            and amount >= 0,
                        "Unsupported Monarch currency"
                    )
                end

                recipes[index] = {
                    Materials = RuntimeFix.parseRuntimeMaterials(
                        stage.Materials
                    ),
                    Money = currencies.money or 0,
                    Gems = currencies.gems or 0,
                }
            end
        end

        return recipes
    end

    function RuntimeFix.runtimeIgrisRecipes()
        local tree =
            RuntimeFix.runtimeConfig("MonarchPathConfig").IgrisTree

        assert(
            type(tree) == "table"
                and type(tree.Order) == "table"
                and type(tree.Nodes) == "table",
            "Igris tree unavailable"
        )

        local recipes = {}
        local order = {}

        for _, nodeKey in ipairs(tree.Order) do
            local node = tree.Nodes[nodeKey]

            assert(
                type(node) == "table"
                    and type(node.Levels) == "table"
                    and #node.Levels > 0,
                "Igris levels unavailable: " .. tostring(nodeKey)
            )

            assert(
                recipes[nodeKey] == nil,
                "Duplicate Igris node: " .. tostring(nodeKey)
            )

            recipes[nodeKey] = {}
            table.insert(order, nodeKey)

            for level, entry in ipairs(node.Levels) do
                assert(
                    type(entry.Money) == "number" and entry.Money >= 0,
                    "Invalid Igris money cost"
                )

                recipes[nodeKey][level] = {
                    Money = entry.Money,
                    Materials = RuntimeFix.parseRuntimeMaterials(
                        entry.Materials
                    ),
                }
            end
        end

        return recipes, order
    end

    function RuntimeFix.runtimeAccessory(name)
        RuntimeFix.RuntimeAccessories =
            RuntimeFix.RuntimeAccessories or {}

        if RuntimeFix.RuntimeAccessories[name] then
            return RuntimeFix.RuntimeAccessories[name]
        end

        local accessoryConfig =
            RuntimeFix.runtimeConfig("accessoryConfig")

        local craftConfig =
            RuntimeFix.runtimeConfig("accessoryCraftConfig")

        local accessoryId
        local craftKey
        local craftEntry

        for id, entry in pairs(accessoryConfig) do
            if type(entry) == "table" and entry.Name == name then
                assert(
                    accessoryId == nil,
                    "Ambiguous accessory name: " .. name
                )

                accessoryId = tostring(id)
            end
        end

        assert(accessoryId, "Accessory not found: " .. name)

        for key, entry in pairs(craftConfig) do
            if type(entry) == "table"
                and tostring(entry.CarftID) == accessoryId
            then
                assert(
                    craftKey == nil,
                    "Ambiguous craft recipe: " .. name
                )

                craftKey = tostring(key)
                craftEntry = entry
            end
        end

        assert(craftKey, "Craft recipe not found: " .. name)

        local materials =
            RuntimeFix.parseRuntimeMaterials(craftEntry.Misc)

        local materialList = {}

        for id, amount in pairs(materials) do
            table.insert(materialList, {id, amount})
        end

        table.sort(materialList, function(a, b)
            return a[1] < b[1]
        end)

        local recipe = {
            Id = accessoryId,
            Index = craftKey,
            Name = name,
            Materials = materialList,

            -- รองรับฟังก์ชันเดิมที่ใช้ชื่อฟิลด์ตัวเล็ก
            accessoryId = accessoryId,
            craftIndex = craftKey,
            name = name,
            materials = materials,
        }

        RuntimeFix.RuntimeAccessories[name] = recipe
        return recipe
    end

