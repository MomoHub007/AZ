local function getAccountDataForCraft()
    local data, readError = RuntimeFix.readAccount()

    if not data then
        warn("[AutoCraft] Cannot read account:", readError)
    end

    return data
end

local function isAccessoryOwned(data, accessoryId)
    if type(data) ~= "table"
        or type(data.accessory) ~= "table"
    then
        return false
    end

    return
        (tonumber(data.accessory[tostring(accessoryId)]) or 0)
        >= 1
end

local function getMaterialAmount(data, materialId)
    if type(data) ~= "table"
        or type(data.material) ~= "table"
    then
        return 0
    end

    return tonumber(
        data.material[tostring(materialId)]
    ) or 0
end

local function hasCraftMaterials(data, recipe)
    for _, requirement in ipairs(recipe) do
        local materialId =
            tostring(requirement[1])

        local requiredAmount =
            tonumber(requirement[2]) or 0

        local currentAmount =
            getMaterialAmount(
                data,
                materialId
            )

        if currentAmount < requiredAmount then
            return false, materialId, currentAmount, requiredAmount
        end
    end

    return true
end

local function waitForAccessoryOwned(accessoryId, timeout)
    local deadline =
        os.clock() + (timeout or 5)

    repeat
        local data =
            getAccountDataForCraft()

        if data
            and isAccessoryOwned(
                data,
                accessoryId
            )
        then
            return true
        end

        task.wait(0.2)
    until os.clock() >= deadline
        or AutoFarmSession.Cancelled

    return false
end

local function craftAccessoryByIndex(
    craftIndex,
    accessoryId,
    accessoryName,
    recipe
)
    local data =
        getAccountDataForCraft()

    if not data then
        return false
    end

    -- มีของอยู่แล้ว -> ไม่คราฟซ้ำ
    if isAccessoryOwned(
        data,
        accessoryId
    )
    then
        print(
            "[AutoCraft]",
            accessoryName,
            "already owned -> Skip"
        )

        return true
    end

    local enough,
        missingId,
        currentAmount,
        requiredAmount =
        hasCraftMaterials(
            data,
            recipe
        )

    if not enough then
        warn(
            "[AutoCraft] Not enough material for",
            accessoryName,
            "| Material:",
            missingId,
            "| Have:",
            currentAmount,
            "| Need:",
            requiredAmount
        )

        return false
    end

    local packets

    local loaded, loadError =
        pcall(function()
            packets = RuntimeFix.getPackets()
        end)

    if not loaded
        or not packets
        or not packets.craftAccessory
        or type(
            packets.craftAccessory.fire
        ) ~= "function"
    then
        warn(
            "[AutoCraft] craftAccessory packet unavailable:",
            loadError
        )

        return false
    end

    print(
        "[AutoCraft] Crafting ->",
        accessoryName,
        "| Craft Index:",
        craftIndex
    )

    local fireOk, fireError =
        pcall(function()
            packets.craftAccessory:fire(
                tostring(craftIndex)
            )
        end)

    if not fireOk then
        warn(
            "[AutoCraft] Craft request failed:",
            accessoryName,
            fireError
        )

        return false
    end

    -- รอ server replication
    local crafted =
        waitForAccessoryOwned(
            accessoryId,
            5
        )

    if not crafted then
        warn(
            "[AutoCraft] Craft sent but accessory was not verified:",
            accessoryName,
            "| Accessory ID:",
            accessoryId
        )

        return false
    end

    print(
        "[AutoCraft] SUCCESS ->",
        accessoryName
    )

    return true
end

