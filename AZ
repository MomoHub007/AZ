    function RuntimeFix.runTrialsEvolution()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        local state = RuntimeFix.TrialsEvolution
        local data = RuntimeFix.readAccount()

        if not data
            or not RuntimeFix.trialsReady(data)
            or not RuntimeFix.findOwnedSlot(data, "rin")
            or not RuntimeFix.findOwnedSlot(data, "frieren")
        then
            return false
        end

        local pending = state.Pending

        if pending then
            local character = data.CharactersData
                and data.CharactersData[pending.Character]

            if type(character) == "table"
                and character.IsUltimateUnlocked == true
            then
                print(
                    "[TrialsEvo] CONFIRMED:",
                    pending.Character
                )
                state.Pending = nil
                state.ActiveForEvo = nil
            elseif pending.Response
                and not pending.Response.Success
            then
                warn(
                    "[TrialsEvo] Rejected:",
                    pending.Character,
                    pending.Response.Reason
                )
                state.Pending = nil
                state.ActiveForEvo = nil
                state.RetryAt = os.clock() + 5
                return false
            else
                if not pending.Warned
                    and os.clock() - pending.SentAt >= 15
                then
                    pending.Warned = true
                    warn(
                        "[TrialsEvo] Waiting for Account confirmation:",
                        pending.Character,
                        "| No duplicate request"
                    )
                end
                return false
            end
        end

        if os.clock() < state.RetryAt then
            return false
        end

        local plan = RuntimeFix.getTrialsEvolutionPlan(data)

        if not plan then
            state.ActiveForEvo = nil
            return RuntimeFix.runCompletedShadowGate()
        end

        if not plan.Target then
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            local packets = RuntimeFix.getPackets()
            local packet = packets.evolveCharacter

            if not packet or type(packet.fire) ~= "function" then
                error("evolveCharacter unavailable")
            end

            RuntimeFix.listenTrialsEvolution(packets)

            -- ป้องกัน prepareTeam งานอื่นสลับ Active กลับระหว่าง Evo
            state.ActiveForEvo = plan.Recipe.Character

            if not prepareTeam()
                or not RuntimeFix.equipPostMonarchActive(
                    plan.Recipe.Character
                )
            then
                state.ActiveForEvo = nil
                state.RetryAt = os.clock() + 5
                return false
            end

            local fresh = RuntimeFix.readAccount()
            local freshPlan = fresh
                and RuntimeFix.getTrialsEvolutionPlan(fresh)

            if AutoFarmSession.Cancelled
                or not freshPlan
                or freshPlan.Target
                or freshPlan.Recipe.Character ~= plan.Recipe.Character
                or fresh.character ~= plan.Recipe.Character
            then
                state.ActiveForEvo = nil
                return false
            end

            state.Pending = {
                Character = plan.Recipe.Character,
                SentAt = os.clock(),
                Response = nil,
                Warned = false,
            }

            packet:fire(plan.Recipe.Character)

            print("[TrialsEvo] Requested:", plan.Recipe.Character)
            return true
        end

        state.ActiveForEvo = nil

        local target = plan.Target
        local queueKey = "TrialsEvo_" .. plan.Recipe.Character
            .. "_" .. target.Map
            .. "_" .. tostring(target.Chapter)

        if ActiveLobbyQueue == queueKey
            and LastLobbyJoinAttemptClock > 0
            and os.clock() - LastLobbyJoinAttemptClock
                < LOBBY_JOIN_TIMEOUT_SECONDS
        then
            return true
        end

        local retrying = ActiveLobbyQueue == queueKey

        if not RuntimeFix.monarchClearQueue() then
            return false
        end

        if retrying then
            cycleNextRoomNumber()
        end

        if not prepareTeam()
            or AutoFarmSession.Cancelled
            or not queueScriptOnTeleport()
        then
            return false
        end

        ActiveLobbyQueue = queueKey
        LastLobbyJoinAttemptClock = os.clock()
        LastLobbyJoinAction = RuntimeFix.runMonarch

        local isStory = target.Map == "hxh"

        RuntimeFix.createQueue({
            gamemode = isStory and "Story" or "Raid",
            map = isStory and "Hxh"
                    or (
                        target.Map == "spiritedawayraid"
                        and "BathTub"
                        or "ShadowGate"
                    ),
            chapter = isStory and target.Chapter or 0,
            floor = 0,
            difficulty = 4,
            maxPlayers = 1,
            friendsOnly = false,
            roomNumber = CurrentLobbyRoomNumber,
        })

        RuntimeFix.igrisLog(string.format(
            "%s | %s Chapter %d Nightmare",
            plan.Reason, target.Map, target.Chapter
        ))

        return true
    end

