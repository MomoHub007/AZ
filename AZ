    local function findLowestRaritySlot(): (number?, string?)
        local data = RuntimeFix.readAccount()
        local unlocked = data and data.UnlockedCharacters

        if type(unlocked) ~= "table" then
            return nil, nil
        end

        local protected = {
            sukuna = true,
            miyabi = true,
            cataclysm = true,
            katakuri = true,
            hutao = true,
            sung_jinwoo = true,
            frieren = true,
            rin = true,
            ye_shunguang = true,
        }

        -- เลือกช่องแรกที่ปลดล็อกและแทนที่ได้
        for slotNumber = 1, RuntimeFix.getInventorySlotCount() do
            local slot = unlocked["Slot" .. slotNumber]

            if type(slot) == "table"
                and slot.Unlocked == true
                and type(slot.Character) == "string"
                and slot.Favourite ~= true
                and not protected[slot.Character]
            then
                return slotNumber, slot.Character
            end
        end

        -- ไม่มี fallback ไปช่องที่ป้องกันไว้
        return nil, nil
    end

    local function handleUnitStorageAutoReplace(): boolean
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        local data = RuntimeFix.readAccount()

        if not data then
            return false
        end

        -- Evo ครบแล้ว ไม่ให้การรอรับตัวจาก Storage บล็อก Auto Join
        if RuntimeFix.trialsEvolutionComplete(data) then
            RuntimeFix.StoredPending = nil
            return true
        end

        local pending = RuntimeFix.StoredPending

        -- ตรวจคำขอเดิมก่อนส่งคำขอใหม่
        if pending then
            local unlocked = data.UnlockedCharacters
            local slot = type(unlocked) == "table"
                and unlocked["Slot" .. pending.slot]

            local placed = type(slot) == "table"
                and slot.Unlocked == true
                and slot.Character == pending.character
                and RuntimeFix.storageCount(data, pending.character)
                    < pending.beforeCount

            if placed then
                RuntimeFix.StoredPending = nil

                print(
                    "[UnitStorage] Placement CONFIRMED:",
                    pending.character,
                    "| Inventory Slot:",
                    pending.slot
                )

                prepareTeam()
                return true
            end

            if pending.response
                and pending.response.success == false
            then
                warn(
                    "[UnitStorage] Server rejected:",
                    pending.response.reason
                )

                RuntimeFix.StoredPending = nil
                RuntimeFix.StoredRetryAt = os.clock() + 3
                return false
            end

            if os.clock() >= pending.deadline
                and not pending.warned
            then
                pending.warned = true

                warn(
                    "[UnitStorage] Placement not confirmed.",
                    "Waiting for the original request; no duplicate sent."
                )
            end

            return false
        end

        if os.clock() < RuntimeFix.StoredRetryAt
            or RuntimeFix.PreparingTeam
            or RuntimeFix.JoinOwner
        then
            return false
        end

        local character = nil

        if RuntimeFix.storageCount(data, "sung_jinwoo") > 0
            and not RuntimeFix.findOwnedSlot(data, "sung_jinwoo")
        then
            character = "sung_jinwoo"
        elseif RuntimeFix.storageCount(data, "hutao") > 0
            and not RuntimeFix.findOwnedSlot(data, "hutao")
        then
            character = "hutao"
        elseif RuntimeFix.monarchStage(data) >= 3 then
            local plan = RuntimeFix.getPostMonarchPlan(data)

            if plan and plan.NeedsStorage then
                character = plan.Recipe.Character
            end
        end

        if not character and RuntimeFix.trialsReady(data) then
            local task, needsStorage = RuntimeFix.getTrialsTask(data)

            if task and needsStorage then
                character = task.Character
            end
        end

        if not character then
            return false
        end

        local isTrialsCharacter =
            character == "frieren"
            or character == "rin"
            or character == "ye_shunguang"

        local targetSlot

        if isTrialsCharacter then
            targetSlot = RuntimeFix.selectTrialsSlot(data)
        else
            targetSlot = findLowestRaritySlot()
        end

        if not targetSlot then
            if os.clock() >= RuntimeFix.StorageWarningAt then
                RuntimeFix.StorageWarningAt = os.clock() + 10

                warn(
                    "[UnitStorage] No safe unlocked slot.",
                    "Protected characters will not be replaced."
                )
            end

            return false
        end

        local packets = RuntimeFix.getPackets()

        if not packets.placeStoredUnit
            or type(packets.placeStoredUnit.fire) ~= "function"
        then
            error("placeStoredUnit unavailable")
        end

        -- อ่านข้อมูลใหม่ก่อนส่ง เพื่อป้องกันช่องเปลี่ยนระหว่างทาง
        local latest = RuntimeFix.readAccount()
        local unlocked = latest and latest.UnlockedCharacters
        local target = type(unlocked) == "table"
            and unlocked["Slot" .. targetSlot]

        local protected = {
            sukuna = true,
            miyabi = true,
            cataclysm = true,
            katakuri = true,
            hutao = true,
            sung_jinwoo = true,
            ye_shunguang = true,
        }

        if isTrialsCharacter then
            protected = {
                sung_jinwoo = true,
                hutao = true,
                frieren = true,
                rin = true,
                ye_shunguang = true,
            }

            -- ตรวจช่อง Rarity ต่ำสุดใหม่ก่อนส่งคำขอ
            if not latest
                or RuntimeFix.selectTrialsSlot(latest) ~= targetSlot
            then
                return false
            end
        end

        if type(target) ~= "table"
            or target.Unlocked ~= true
            or type(target.Character) ~= "string"
            or target.Favourite == true
            or protected[target.Character]
            or RuntimeFix.findOwnedSlot(latest, character)
        then
            return false
        end

        local beforeCount = RuntimeFix.storageCount(latest, character)

        if beforeCount <= 0 or AutoFarmSession.Cancelled then
            return false
        end

        RuntimeFix.StoredRequestId =
            RuntimeFix.StoredRequestId % 65535 + 1

        RuntimeFix.StoredPending = {
            character = character,
            slot = targetSlot,
            requestId = RuntimeFix.StoredRequestId,
            beforeCount = beforeCount,
            deadline = os.clock() + 10,
            response = nil,
            warned = false,
        }

        packets.placeStoredUnit:fire({
            character = character,
            slot = targetSlot,
            requestId = RuntimeFix.StoredRequestId,
        })

        print(
            "[UnitStorage] Request sent:",
            character,
            "| Inventory Slot:",
            targetSlot
        )

        return false
    end

    function startUnitStorageWatcher()
        if RuntimeFix.StorageWatcherStarted
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            or AutoFarmSession.Cancelled
        then
            return
        end

        RuntimeFix.StorageWatcherStarted = true

        task.spawn(function()
            -- ลงทะเบียนรับผลครั้งเดียวต่อ session
            local listenerReady = false

            while not AutoFarmSession.Cancelled do
                local ok, listenerError = pcall(function()
                    local packets = RuntimeFix.getPackets()

                    if not packets.storedUnitPlaced
                        or type(packets.storedUnitPlaced.on) ~= "function"
                    then
                        error("storedUnitPlaced unavailable")
                    end

                    local disconnect = packets.storedUnitPlaced:on(
                        function(result)
                            if AutoFarmSession.Cancelled
                                or type(result) ~= "table"
                            then
                                return
                            end

                            local pending = RuntimeFix.StoredPending

                            if pending
                                and result.requestId == pending.requestId
                                and result.character == pending.character
                                and result.slot == pending.slot
                            then
                                pending.response = result
                            end
                        end
                    )

                    if typeof(disconnect) == "function" then
                        table.insert(AutoFarmSession.Cleanups, disconnect)
                    elseif typeof(disconnect) == "RBXScriptConnection" then
                        table.insert(AutoFarmSession.Cleanups, function()
                            disconnect:Disconnect()
                        end)
                    end
                end)

                if ok then
                    listenerReady = true
                    break
                end

                warn("[UnitStorage] Listener failed:", listenerError)
                task.wait(2)
            end

            while listenerReady and not AutoFarmSession.Cancelled do
                local ok, handlerError =
                    pcall(handleUnitStorageAutoReplace)

                if not ok then
                    warn("[UnitStorage] Handler failed:", handlerError)
                end

                task.wait(0.5)
            end

            RuntimeFix.StorageWatcherStarted = false
        end)
    end

    function evolveSukunaIfReady()
        local progressionData = RuntimeFix.readAccount()

        if not progressionData
            or RuntimeFix.monarchStage(progressionData) < 3
        then
            return false
        end
        local craftData = getAccountDataForCraft()

        if not craftData
            or not isAccessoryOwned(
                craftData,
                RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
            )
            or not isAccessoryOwned(
                craftData,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            )
        then
            print("[AutoEvolve] Waiting for Crown + Wings.")
            return false
        end

        if SukunaEvolveTriggered then
            return false
        end

        local ok, data, materialConfig = pcall(function()
            local accountNamespace =
                require(
                    ReplicatedStorage
                        :WaitForChild("global")
                        :WaitForChild("stores")
                        :WaitForChild("accountNamespace")
                )

            local config =
                require(
                    ReplicatedStorage
                        :WaitForChild("assets")
                        :WaitForChild("config")
                        :WaitForChild("materialConfig")
                )

            local account =
                accountNamespace.getLocalPlayerAccount()

            if not account then
                error("LocalPlayer account unavailable")
            end

            return account:toTable(), config
        end)

        if not ok then
            warn("[AutoEvolve] Failed to read material data:", data)
            return false
        end

        if type(data) ~= "table"
            or type(materialConfig) ~= "table"
        then
            warn("[AutoEvolve] Invalid account/material data.")
            return false
        end

        local sukunaData =
            data.CharactersData
            and data.CharactersData.sukuna

        if sukunaData and sukunaData.IsUltimateUnlocked == true then
            SukunaEvolveTriggered = true
            print("[AutoEvolve] Sukuna is already evolved.")
            return true
        end

        local materials = data.material

        if type(materials) ~= "table" then
            print("[AutoEvolve] No material data.")
            return false
        end

        local recipe =
            RuntimeFix.runtimeEvolution("sukuna", "Sukuna")

        for id, required in pairs(recipe.Materials) do
            if getMaterialAmount(data, id) < required then
                return false
            end
        end

        local currencies = data.currencies

        if type(currencies) ~= "table" then
            return false
        end

        local money = tonumber(currencies.money)
        local gems = tonumber(currencies.gems)

        if not money
            or not gems
            or money < recipe.Money
            or gems < recipe.Gems
        then
            return false
        end

        if not RuntimeFix.equipPostMonarchActive("sukuna") then
            return false
        end

        local fresh = RuntimeFix.readAccount()

        if not fresh or fresh.character ~= "sukuna" then
            return false
        end

        for id, required in pairs(recipe.Materials) do
            if getMaterialAmount(fresh, id) < required then
                return false
            end
        end

        local funds = fresh.currencies

        if not funds
            or (tonumber(funds.money) or 0) < recipe.Money
            or (tonumber(funds.gems) or 0) < recipe.Gems
        then
            return false
        end

        local packets = RuntimeFix.getPackets()

        assert(
            packets.evolveCharacter
                and type(packets.evolveCharacter.fire) == "function",
            "evolveCharacter packet unavailable"
        )

        local fireOk, fireError = pcall(function()
            packets.evolveCharacter:fire("sukuna")
        end)

        if not fireOk then
            warn("[AutoEvolve] Evolve request failed:", fireError)
            return false
        end

        SukunaEvolveTriggered = true

        print("[AutoEvolve] Sukuna Evolution request sent.")
        return true
    end

    local HutaoEvolveTriggered = false
    local HutaoEvoFarmStarted = false
    local HutaoEvolveRetryAt = 0

    function getHutaoEvoStatus()
        local data = RuntimeFix.readAccount()

        if not data then
            return {isReady = false}
        end

        if not RuntimeFix.findOwnedSlot(data, "hutao") then
            if RuntimeFix.storageCount(data, "hutao") > 0 then
                return {
                    isReady = false,
                    waitingForStorage = true,
                }
            end

            return {
                isReady = false,
                acquiringCharacter = true,
                missingStage = "Raid_BathTub",

                RuntimeTarget = {
                    Map = "spiritedawayraid",
                    Chapter = 1,
                    Difficulty = 4,
                },
            }
        end

        local character =
            data.CharactersData and data.CharactersData.hutao

        if type(character) == "table"
            and character.IsUltimateUnlocked == true
        then
            return {
                isReady = false,
                isEvolved = true,
            }
        end

        local recipe =
            RuntimeFix.runtimeEvolution("hutao", "Hu Tao")

        local missing = {}
        local counts = {}

        for id, required in pairs(recipe.Materials) do
            local amount = getMaterialAmount(data, id)

            counts[id] = amount

            if amount < required then
                missing[id] = true
            end
        end

        local currencies = data.currencies

        assert(
            type(currencies) == "table",
            "Hu Tao currencies unavailable"
        )

        local money = tonumber(currencies.money)
        local gems = tonumber(currencies.gems)

        assert(money and gems, "Hu Tao money/gems unavailable")

        local needCurrency =
            money < recipe.Money or gems < recipe.Gems

        local target =
            RuntimeFix.runtimeMaterialTarget(missing, 4)

        if not target and needCurrency then
            target = {
                Map = "spiritedawayraid",
                Chapter = 1,
                Difficulty = 4,
            }
        end

        return {
            isReady = target == nil,
            counts = counts,
            Recipe = recipe,
            needCurrency = needCurrency,
            RuntimeTarget = target,
            missingStage = target and "RuntimeMaterial" or nil,
        }
    end

    function fireEvolveHutao(): boolean
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        if isHutaoEvolved() then
