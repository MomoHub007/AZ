    local function getTitleBuffValues(titleData)
        local buffs = {
            ["Damage"] = 0,
            ["HP"] = 0,
            ["Walk Speed"] = 0,
            ["Cooldown Reduction"] = 0,
            ["Drop Rate"] = 0,
            ["Exp"] = 0,
            ["Coins"] = 0,
            ["Critical Chance"] = 0,
            ["Critical Damage"] = 0,
        }

        if type(titleData) ~= "table"
            or type(titleData.Buffs) ~= "table"
        then
            return buffs
        end

        for _, buff in ipairs(titleData.Buffs) do
            if type(buff) == "table"
                and type(buff.Type) == "string"
            then
                local value =
                    tonumber(
                        buff.Percent
                        or buff.Amount
                        or 0
                    )
                    or 0

                if buffs[buff.Type] ~= nil then
                    buffs[buff.Type] = value
                end
            end
        end

        return buffs
    end

    local function isTitleUnlocked(unlockedTitles, titleId)
        if type(unlockedTitles) ~= "table" then
            return false
        end

        return unlockedTitles[tostring(titleId)] == true
    end

    local function isBetterTitle(candidate, current)
        if not current then
            return true
        end

        local candidateTier =
            tonumber(candidate.data.Tier) or 0

        local currentTier =
            tonumber(current.data.Tier) or 0

        if candidateTier ~= currentTier then
            return candidateTier > currentTier
        end

        local priorityStats = {
            "Damage",
            "Critical Damage",
            "Critical Chance",
            "Cooldown Reduction",
            "Drop Rate",
            "Exp",
            "Coins",
            "HP",
            "Walk Speed",
        }

        for _, statName in ipairs(priorityStats) do
            local candidateValue =
                candidate.buffs[statName] or 0

            local currentValue =
                current.buffs[statName] or 0

            if candidateValue ~= currentValue then
                return candidateValue > currentValue
            end
        end

        return (tonumber(candidate.id) or math.huge)
            < (tonumber(current.id) or math.huge)
    end

    local function StartAutoEquipBestTitle()
        if AutoEquipBestTitleEnabled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return
        end

        AutoEquipBestTitleEnabled = true

        task.spawn(function()
            local loaded, result =
                pcall(function()
                    local accountNamespace =
                        require(
                            ReplicatedStorage
                                :WaitForChild("global")
                                :WaitForChild("stores")
                                :WaitForChild("accountNamespace")
                        )

                    local titleConfig =
                        require(
                            ReplicatedStorage
                                :WaitForChild("assets")
                                :WaitForChild("config")
                                :WaitForChild("titleConfig")
                        )

                    local packets =
                        require(
                            ReplicatedStorage
                                :WaitForChild("lobby")
                                :WaitForChild("packets")
                        )

                    local account =
                        accountNamespace.getLocalPlayerAccount()

                    if not account then
                        error("LocalPlayer account unavailable")
                    end

                    local data = account:toTable()

                    return {
                        data = data,
                        titleConfig = titleConfig,
                        packets = packets,
                    }
                end)

            if not loaded then
                AutoEquipBestTitleEnabled = false

                warn(
                    "[AutoTitle] Failed to load title data:",
                    result
                )

                return
            end

            local data = result.data
            local titleConfig = result.titleConfig
            local packets = result.packets

            if type(data) ~= "table"
                or type(data.title) ~= "table"
            then
                AutoEquipBestTitleEnabled = false

                warn(
                    "[AutoTitle] Unlocked Title data unavailable."
                )

                return
            end

            if type(titleConfig) ~= "table" then
                AutoEquipBestTitleEnabled = false

                warn(
                    "[AutoTitle] titleConfig is unavailable."
                )

                return
            end

            if not packets.equipTitle
                or type(packets.equipTitle.fire) ~= "function"
            then
                AutoEquipBestTitleEnabled = false

                warn(
                    "[AutoTitle] equipTitle packet API is unavailable."
                )

                return
            end

            local currentEquipped =
                tostring(data.equippedTitle or "none")

            local bestTitle = nil

            for titleId, unlocked in pairs(data.title) do
                if unlocked == true then
                    local id =
                        tostring(titleId)

                    local titleData =
                        titleConfig[id]
                        or titleConfig[tonumber(id)]

                    if type(titleData) == "table" then
                        local candidate = {
                            id = id,
                            data = titleData,
                            buffs = getTitleBuffValues(titleData),
                        }

                        if isBetterTitle(candidate, bestTitle) then
                            bestTitle = candidate
                        end
                    end
                end
            end

            if not bestTitle then
                print(
                    "[AutoTitle] No unlocked Title found."
                )

                AutoEquipBestTitleEnabled = false
                return
            end

            print(
                "[AutoTitle] Best Title:",
                tostring(bestTitle.data.Name),
                "| ID:",
                bestTitle.id,
                "| Tier:",
                tostring(bestTitle.data.Tier)
            )

            if currentEquipped == bestTitle.id then
                print(
                    "[AutoTitle] Best Title already equipped -> Skip"
                )

                AutoEquipBestTitleEnabled = false
                return
            end

            local fireOk, fireError =
                pcall(function()
                    packets.equipTitle:fire(
                        bestTitle.id
                    )
                end)

            if not fireOk then
                warn(
                    "[AutoTitle] Equip failed:",
                    fireError
                )

                AutoEquipBestTitleEnabled = false
                return
            end

            print(
                "[AutoTitle] Equipped ->",
                tostring(bestTitle.data.Name),
                "| ID:",
                bestTitle.id
            )

            task.wait(0.25)

            -- Verify จาก account state/table
            local verifyOk, equippedTitle =
                pcall(function()
                    local account =
                        require(
                            ReplicatedStorage
                                :WaitForChild("global")
                                :WaitForChild("stores")
                                :WaitForChild("accountNamespace")
                        )
                        .getLocalPlayerAccount()

                    local latestData =
                        account:toTable()

                    return latestData.equippedTitle
                end)

            if verifyOk then
                print(
                    "[AutoTitle] Equipped Title Now:",
                    tostring(equippedTitle)
                )

                if tostring(equippedTitle)
                    ~= bestTitle.id
                then
                    warn(
                        "[AutoTitle] Verification mismatch."
                    )
                end
            end

            AutoEquipBestTitleEnabled = false
        end)
    end

