function StartAutoRedeemUnusedCodes()
    if AutoRedeemCodesEnabled
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
    then
        return
    end

    AutoRedeemCodesEnabled = true

    task.spawn(function()
        local packets
        local accountNamespace
        local codesConfig

        --==========================================
        -- Load modules
        --==========================================

        local modulesLoaded, moduleError =
            pcall(function()
                packets =
                    require(
                        ReplicatedStorage
                            :WaitForChild("lobby")
                            :WaitForChild("packets")
                    )

                accountNamespace =
                    require(
                        ReplicatedStorage
                            :WaitForChild("global")
                            :WaitForChild("stores")
                            :WaitForChild("accountNamespace")
                    )

                codesConfig =
                    require(
                        ReplicatedStorage
                            :WaitForChild("assets")
                            :WaitForChild("config")
                            :WaitForChild("codesConfig")
                    )
            end)

        if not modulesLoaded then
            AutoRedeemCodesEnabled = false

            warn(
                "[AutoRedeem] Failed to load modules:",
                moduleError
            )

            return
        end

        --==========================================
        -- Validate packet
        --==========================================

        if not packets
            or not packets.redeemCode
            or type(packets.redeemCode.fire) ~= "function"
        then
            AutoRedeemCodesEnabled = false

            warn(
                "[AutoRedeem] redeemCode packet API is unavailable."
            )

            return
        end

        if type(codesConfig) ~= "table" then
            AutoRedeemCodesEnabled = false

            warn(
                "[AutoRedeem] codesConfig is not a table."
            )

            return
        end

        --==========================================
        -- Account
        --==========================================

        local function getAccountData()
            local success, data =
                pcall(function()
                    local account =
                        accountNamespace
                            .getLocalPlayerAccount()

                    if not account then
                        error(
                            "LocalPlayer account is unavailable."
                        )
                    end

                    return account:toTable()
                end)

            if not success then
                return nil, tostring(data)
            end

            if type(data) ~= "table" then
                return nil,
                    "Account data is not a table."
            end

            return data
        end

        --==========================================
        -- Redeemed Code Set
        --==========================================

        local function makeRedeemedSet(data)
            local redeemed = {}

            if type(data) ~= "table"
                or type(data.cdk) ~= "table"
            then
                return redeemed
            end

            for _, value in pairs(data.cdk) do
                local normalized =
                    string.lower(
                        tostring(value)
                    ):gsub("%s+", "")

                if normalized ~= "" then
                    redeemed[normalized] = true
                end
            end

            return redeemed
        end

        --==========================================
        -- Build Code List
        --==========================================

        local codeList = {}

        for configKey, entry in pairs(codesConfig) do
            if type(entry) == "table"
                and type(entry.Code) == "string"
            then
                table.insert(
                    codeList,
                    {
                        code = entry.Code,
                        minimumLevel =
                            tonumber(
                                entry.MinimumLevel
                            ) or 0,
                        configKey =
                            tostring(configKey),
                    }
                )
            end
        end

        table.sort(
            codeList,
            function(a, b)
                return string.lower(a.code)
                    < string.lower(b.code)
            end
        )

        print(
            "[AutoRedeem] START | Config Codes:",
            #codeList
        )

        --==========================================
        -- Initial Account Check
        --==========================================

        local initialData, initialError =
            getAccountData()

        if not initialData then
            AutoRedeemCodesEnabled = false

            warn(
                "[AutoRedeem] Initial account read failed:",
                initialError
            )

            return
        end

        local playerLevel, levelError =
            RuntimeFix.getAccountLevel(initialData)

        if playerLevel == nil then
            AutoRedeemCodesEnabled = false

            warn(
                "[AutoRedeem] Cannot calculate player level:",
                levelError
            )

            return
        end

        print(
            "[AutoRedeem] Player Level:",
            playerLevel
        )

        --==========================================
        -- Redeem Codes
        --==========================================

        for _, codeInfo in ipairs(codeList) do
            if AutoFarmSession.Cancelled then
                break
            end

            local code =
                tostring(codeInfo.code)

            local normalizedCode =
                string.lower(code):gsub("%s+", "")

            ------------------------------------------
            -- Refresh account data
            ------------------------------------------

            local data, accountError =
                getAccountData()

            if not data then
                warn(
                    "[AutoRedeem] Account read failed:",
                    accountError
                )

                task.wait(1)
                continue
            end

            ------------------------------------------
            -- Check already redeemed
            ------------------------------------------

            local redeemed =
                makeRedeemedSet(data)

            if redeemed[normalizedCode] then
                print(
                    "[AutoRedeem] Already redeemed ->",
                    code
                )

                continue
            end

            ------------------------------------------
            -- Check Minimum Level
            ------------------------------------------

            if playerLevel < codeInfo.minimumLevel then
                print(
                    "[AutoRedeem] Skip ->",
                    code,
                    "| Required Level:",
                    codeInfo.minimumLevel,
                    "| Current Level:",
                    playerLevel
                )

                continue
            end

            ------------------------------------------
            -- Send Redeem Request
            ------------------------------------------

            print(
                "[AutoRedeem] Sending ->",
                code
            )

            local fireOk, fireError =
                pcall(function()
                    packets.redeemCode:fire(
                        code
                    )
                end)

            if not fireOk then
                warn(
                    "[AutoRedeem] Request failed ->",
                    code,
                    "|",
                    fireError
                )

                task.wait(1)
                continue
            end

            print(
                "[AutoRedeem] Request sent ->",
                code
            )

            ------------------------------------------
            -- Verify from Account
            ------------------------------------------

            local verified = false
            local deadline =
                os.clock() + 5

            repeat
                if AutoFarmSession.Cancelled then
                    break
                end

                task.wait(0.25)

                local latestData =
                    getAccountData()

                if latestData then
                    local latestRedeemed =
                        makeRedeemedSet(
                            latestData
                        )

                    if latestRedeemed[
                        normalizedCode
                    ]
                    then
                        verified = true
                        break
                    end
                end
            until os.clock() >= deadline

            if verified then
                print(
                    "[AutoRedeem] SUCCESS ->",
                    code
                )
            else
                warn(
                    "[AutoRedeem] Not verified ->",
                    code,
                    "| Server may have rejected, expired, or normalized this code differently."
                )
            end

            task.wait(0.75)
        end

        AutoRedeemCodesEnabled = false

        print(
            "[AutoRedeem] FINISHED"
        )
    end)
end

