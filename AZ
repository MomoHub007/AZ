    function RuntimeFix.getStoryDifficulty(defaultDifficulty, forCraft)
        local data, readError = RuntimeFix.readAccount()
        if not data then
            error("Cannot read team: " .. tostring(readError))
        end

        local equipped = data.EquippedCharacterSlots
        local unlocked = data.UnlockedCharacters

        if type(equipped) ~= "table"
            or type(unlocked) ~= "table"
        then
            error("Team slot data unavailable")
        end

        local inventorySlot = tonumber(
            equipped.Slot1 or equipped[1] or equipped["1"]
        )

        if not inventorySlot then
            error("Cannot read equipped game Slot1")
        end

        local slotData = unlocked["Slot" .. tostring(inventorySlot)]
        if type(slotData) ~= "table"
            or type(slotData.Character) ~= "string"
            or slotData.Character == ""
        then
            error("Character in game Slot1 unavailable")
        end

        local characterId = string.lower(slotData.Character)

        local craftNightmareCharacters = {
            sukuna = true,
            miyabi = true,
            cataclysm = true,
            katakuri = true,
            sung_jinwoo = true,
        }

        local difficulty

        if forCraft == true then
            difficulty = craftNightmareCharacters[characterId] and 4 or 2
        else
            difficulty = characterId == "sukuna"
                and defaultDifficulty
                or 2
        end

        print(string.format(
            "[AutoDifficulty] Slot1: %s | Purpose: %s | Difficulty: %s",
            characterId,
            forCraft == true and "Crown/Wings" or "Progression",
            tostring(difficulty)
