    --==================================================

    -- ชื่อสำรองจากสูตรคราฟในสคริปต์เดิม
    local BLAST_ARCHER_MATERIAL_NAMES = {
        ["103"] = "Mana Feather",
        ["107"] = "Broken Blade",
        ["109"] = "SunCore",
        ["110"] = "Magic Pendant",
        ["111"] = "Forbidden Fruit",
    }

    local materialConfigCache = nil
    local materialConfigRetryAt = 0

    local function getMaterialDisplayName(materialId)
        local id = tostring(materialId)

        -- อ่านชื่อจาก Config จริงของเกม
        if not materialConfigCache
            and os.clock() >= materialConfigRetryAt
        then
            materialConfigRetryAt = os.clock() + 5

            local ok, config = pcall(function()
                return RuntimeFix.requireModule(
                    ReplicatedStorage,
                    {"assets", "config", "materialConfig"}
                )
            end)

            if ok and type(config) == "table" then
                materialConfigCache = config
            end
        end

        local entry = materialConfigCache
            and (
                materialConfigCache[id]
                or materialConfigCache[tonumber(id)]
            )

        local name = nil

        if type(entry) == "table"
            and type(entry.Name) == "string"
            and entry.Name ~= ""
        then
            name = entry.Name
        end

        -- หาก Config ยังโหลดไม่ได้ ใช้ชื่อจากสูตรคราฟ
        name = name
            or BLAST_ARCHER_MATERIAL_NAMES[id]
            or "ไม่พบชื่อไอเทม"

        -- ป้องกันอักขระพิเศษทำให้ RichText ผิดรูป
        return name
            :gsub("&", "&amp;")
            :gsub("<", "&lt;")
            :gsub(">", "&gt;")
    end

    local function getCraftStatusRichText(data, config)
        if not data then
            return '<font color="#B0B6C8">?</font> รอข้อมูล'
        end

        if isAccessoryOwned(data, config.accessoryId) then
            return '<font color="#00E98B">✓ คราฟแล้ว</font>'
        end

        local missing = {}

        for materialId, requiredAmount in pairs(config.materials) do
            local currentAmount = getMaterialAmount(data, materialId)

            if currentAmount < requiredAmount then
                local need = requiredAmount - currentAmount
                table.insert(
                    missing,
                    string.format(
                        "%s x%d",
                        getMaterialDisplayName(materialId),
                        need
                    )
                )
            end
        end

        if #missing == 0 then
            return '<font color="#FFD966">• ยังไม่คราฟ — วัตถุดิบครบแล้ว</font>'
        end

        return '<font color="#FF5E6A">✗ ขาด: '
            .. table.concat(missing, ", ")
            .. '</font>'
    end

    local overlayTraitsById
    local overlayTraitRetryAt = 0

    local function escapeStatusText(value)
        local text = tostring(value)
        text = text:gsub("&", "&amp;")
        text = text:gsub("<", "&lt;")
        text = text:gsub(">", "&gt;")
        return text
    end

    local function getCharacterTraitText(data, characterId)
        local characters = data and data.CharactersData
        local character =
            type(characters) == "table" and characters[characterId]

        local traitData =
            type(character) == "table" and character.TraitData

        local traitId =
            type(traitData) == "table"
            and tonumber(traitData.Trait)

        if traitId == nil then
            return "รอข้อมูล"
        end

        if traitId == 0 then
            return "ยังไม่มี Trait"
        end

        if not overlayTraitsById
            and os.clock() >= overlayTraitRetryAt
        then
            overlayTraitRetryAt = os.clock() + 10

            local ok, result = pcall(function()
                local config = RuntimeFix.requireModule(
                    ReplicatedStorage,
                    { "assets", "config", "Traits", "traitConfig" }
                )

                if type(config) ~= "table" then
                    error("traitConfig is not a table")
                end

                local byId = {}

                for _, trait in pairs(config) do
                    if type(trait) == "table" then
                        local id = tonumber(trait.Id)

                        if id then
                            byId[id] = trait
                        end
                    end
                end

                return byId
            end)

            if ok then
                overlayTraitsById = result
            else
                warn("[KaiTunStatus] Trait config:", result)
            end
        end

        local trait =
            overlayTraitsById and overlayTraitsById[traitId]

        if not trait then
            return "ID " .. tostring(traitId) .. " · รอชื่อ Trait"
        end

        return escapeStatusText(trait.Name or ("ID " .. traitId))
            .. " · "
            .. escapeStatusText(trait.Rarity or "?")
    end

    local function formatCharacterName(value)
        local text = tostring(value or "")

        if text == "" then
            return "-"
        end

        text = text:gsub("_", " ")
        text = text:gsub("%s+", " ")

        return (text:gsub("^%l", string.upper))
    end

    local function getEquippedClassName(data, gameSlot)
        if type(data) ~= "table" then
            return "-"
        end

        local equippedSlots = data.EquippedCharacterSlots
        local unlockedCharacters = data.UnlockedCharacters

        if type(equippedSlots) ~= "table"
            or type(unlockedCharacters) ~= "table"
        then
