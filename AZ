    function RuntimeFix.runtimeMaterialTarget(
        missing,
        difficulty,
        allowedMaps
    )
        local tables =
            RuntimeFix.runtimeConfig("materialDropConfig").Tables

        assert(
            type(tables) == "table",
            "materialDropConfig.Tables unavailable"
        )

        local difficultyNames = {
            [1] = "Easy",
            [2] = "Medium",
            [3] = "Hard",
            [4] = "Nightmare",
        }

        assert(
            difficultyNames[difficulty],
            "Unsupported difficulty"
        )

        local candidates = {}
        local reachable = {}

        for _, map in ipairs({
            "hxh",
            "spiritedawayraid",
            "sololevelingraid",
        }) do
            if not allowedMaps or allowedMaps[map] then
                local chapters = tables[map]

                assert(
                    type(chapters) == "table",
                    "Drop table unavailable: " .. map
                )

                for chapter, drops in pairs(chapters) do
                    assert(
                        type(chapter) == "number"
                            and type(drops) == "table",
                        "Invalid chapter drops"
                    )

                    local coverage = 0
                    local rarest = math.huge
                    local seen = {}

                    for _, drop in ipairs(drops) do
                        local id = tostring(drop.Item)

                        if missing[id] and not seen[id] then
                            local chance = drop.Chance

                            if type(chance) == "table" then
                                chance = chance[
                                    difficultyNames[difficulty]
                                ]
                            end

                            if type(chance) == "number" and chance > 0 then
                                seen[id] = true
                                reachable[id] = true
                                coverage += 1
                                rarest = math.min(rarest, chance)
                            end
                        end
                    end

                    if coverage > 0 then
                        table.insert(candidates, {
                            Map = map,
                            Chapter = chapter,
                            Difficulty = map == "hxh"
                                and difficulty
                                or 4,
                            Coverage = coverage,
                            Rarest = rarest,
                        })
                    end
                end
            end
        end

        for id in pairs(missing) do
            assert(
                reachable[tostring(id)],
                "No supported drop source: material " .. tostring(id)
            )
        end

        table.sort(candidates, function(a, b)
            if a.Coverage ~= b.Coverage then
                return a.Coverage > b.Coverage
            end

            if a.Rarest ~= b.Rarest then
                return a.Rarest < b.Rarest
            end

            if a.Map ~= b.Map then
                return a.Map < b.Map
            end

            return a.Chapter < b.Chapter
        end)

        return candidates[1]
    end

