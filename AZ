        if not characterSlotNumber then
            warn("[AutoRoll] Sukuna inventory slot not found.")
            return false
        end

        local targetSlot =
            unlockedCharacters["Slot" .. characterSlotNumber]

        if not targetSlot or targetSlot.Unlocked ~= true then
            warn("[AutoRoll] Invalid Sukuna slot:", characterSlotNumber)
            return false
        end

        local characterName =
            string.lower(tostring(targetSlot.Character or ""))

        if characterName ~= "sukuna"
