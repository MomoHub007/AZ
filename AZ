        or RuntimeFix.QueueStatus == "inQuque"
        or RuntimeFix.QueueStatus == "teleporting"
        or LocalPlayer:GetAttribute("QueueRoom") ~= nil

    if hasQueue and not leaveCurrentLobbyQueue() then
        return false
    end

    ActiveLobbyQueue = nil
    AutoJoinStarted = false
    LastLobbyJoinAction = nil
    LastLobbyJoinAttemptClock = 0
    RuntimeFix.QueueStatus = "idle"
    return true
end

function RuntimeFix.monarchStep()
    local state = RuntimeFix.Monarch

    if AutoFarmSession.Cancelled
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        or RuntimeFix.StoredPending
        or RuntimeFix.PreparingTeam
        or RuntimeFix.Crafting
        or AutoRedeemCodesEnabled
        or AutoUnlockSlotsEnabled
        or AutoUpgradeSkillTreeEnabled
        or CustomAutoRollEnabled
    then
        return false
    end

    -- ไม่แทรกการโรลระหว่างรอผล Evolution
    if not state.Pending then
        if not RuntimeFix.runAutoTraits() then
            return false
        end
    end

    local data = RuntimeFix.readAccount()
    if not data
        or not RuntimeFix.findOwnedSlot(data, "sung_jinwoo")
    then
        return false
    end

    local stage = RuntimeFix.monarchStage(data)
    local pending = state.Pending

    -- ยืนยันจาก Account ก่อนเริ่มขั้นถัดไป
    if pending then
        if stage >= pending.Stage then
            RuntimeFix.monarchLog(
                "Stage " .. pending.Stage .. " confirmed"
            )
            state.Pending = nil
        elseif pending.Response
            and not pending.Response.Success
        then
            warn(
                "[Monarch] Evolution rejected:",
                pending.Response.Reason
            )
            state.Pending = nil
            state.RetryAt = os.clock() + 5
            return false
        else
            if os.clock() - pending.SentAt >= 15 then
                RuntimeFix.monarchLog(
                    "Waiting for evolution confirmation; "
                    .. "request will not be sent twice"
                )
            end
            return false
        end
    end

    if os.clock() < state.RetryAt then
        return false
    end

    if stage >= 3 then
        if not RuntimeFix.monarchClearQueue() then
            return false
        end
        if not prepareTeam() then
            return false
        end

        RuntimeFix.monarchLog(
            "Stage III complete | Jinwoo team slot 1, Hu Tao slot 2"
        )
        return true
    end

    local target = stage + 1
    local recipe = RuntimeFix.MonarchRecipes[target]
    local materials = data.material
    local currencies = data.currencies

    if type(materials) ~= "table"
        or type(currencies) ~= "table"
    then
        RuntimeFix.monarchLog("Waiting for account resources")
        return false
    end

    local needStory = false
    local needRaid = false

    for id, required in pairs(recipe.Materials) do
        local current = tonumber(materials[id]) or 0
        if current < required then
            if id == "101" or id == "110" then
                needStory = true
            else
                needRaid = true
            end
        end
    end

    local money = tonumber(currencies.money)
    local gems = tonumber(currencies.gems)
    if money == nil or gems == nil then
        return false
    end

    -- ตรวจงบของขั้นถัดไปจากยอด Account ปัจจุบัน
    local missingMoney = math.max(0, recipe.Money - money)
    local missingGems = math.max(0, recipe.Gems - gems)
    local needCurrency = missingMoney > 0 or missingGems > 0

    -- Shadow Gate ให้ทั้งเงิน เพชร และวัตถุดิบ Monarch
    -- หากยังขาดของ Story ระบบเลือก Hxh ก่อนตามเงื่อนไขเดิม
    if needCurrency then
        needRaid = true
    end

    -- เข้าเงื่อนไขอีโวเฉพาะเมื่อวัตถุดิบและงบครบแล้ว
    if not needStory and not needRaid then
        if not RuntimeFix.monarchClearQueue() then
            return false
        end

        if not prepareTeam() then
            return false
        end

        -- prepareTeam มีการ yield จึงอ่านทรัพยากรใหม่ก่อนส่ง
        local fresh = RuntimeFix.readAccount()
        if not fresh or RuntimeFix.monarchStage(fresh) ~= stage then
            return false
        end

        for id, required in pairs(recipe.Materials) do
            if (tonumber((fresh.material or {})[id]) or 0)
                < required
            then
                return false
            end
        end

        local funds = fresh.currencies or {}
        if (tonumber(funds.money) or 0) < recipe.Money
            or (tonumber(funds.gems) or 0) < recipe.Gems
        then
            return false
        end

        local packets = RuntimeFix.getPackets()
        RuntimeFix.monarchListen(packets)

        if AutoFarmSession.Cancelled then
            return false
        end

        state.Pending = {
            Stage = target,
            SentAt = os.clock(),
        }

        -- หาก fire error ให้คง Pending เพราะอาจส่งถึง server แล้ว
        if target == 1 then
            packets.evolveCharacter:fire("sung_jinwoo")
        else
            packets.monarchEvolve:fire(target)
        end

        RuntimeFix.monarchLog(
            "Evolution requested: Stage " .. target
        )
        return true
    end

    -- ยังไม่มี Sukuna Evo ให้เลือก Story แทน Shadow Gate
    if not needStory and not RuntimeFix.canFarmRaid() then
        needStory = true
    end

    local queueKey = needStory
        and "Monarch_Hxh1"
        or "Monarch_ShadowGate"

    if ActiveLobbyQueue == queueKey
        and LastLobbyJoinAttemptClock > 0
        and os.clock() - LastLobbyJoinAttemptClock
            < LOBBY_JOIN_TIMEOUT_SECONDS
    then
        return true
    end

    local retrying = ActiveLobbyQueue == queueKey

    if not RuntimeFix.monarchClearQueue() then
        return false
    end

    if retrying then
        cycleNextRoomNumber()
    end

    if not prepareTeam() or AutoFarmSession.Cancelled then
        return false
    end

    -- ต้องโหลดสคริปต์ต่อได้หลัง teleport
    if not queueScriptOnTeleport() then
        RuntimeFix.monarchLog(
            "Cannot queue script for next teleport"
        )
        return false
    end

    local packets = RuntimeFix.getPackets()

    ActiveLobbyQueue = queueKey
    LastLobbyJoinAttemptClock = os.clock()
    LastLobbyJoinAction = RuntimeFix.runMonarch

    packets.createQuque:fire({
        gamemode = needStory and "Story" or "Raid",
        map = needStory and "Hxh" or "ShadowGate",
        chapter = needStory and 1 or 0,
        difficulty = RuntimeFix.getStoryDifficulty(4),
        maxPlayers = 1,
        friendsOnly = false,
        roomNumber = CurrentLobbyRoomNumber,
    })

    RuntimeFix.monarchLog(string.format(
        "Stage %d -> %s | Room %d",
        target, queueKey, CurrentLobbyRoomNumber
    ))
    return true
end

function RuntimeFix.runMonarch()
    local state = RuntimeFix.Monarch
    local owner = coroutine.running()

    if state.Busy
        or (RuntimeFix.JoinOwner and RuntimeFix.JoinOwner ~= owner)
    then
        return false
    end

    local previousOwner = RuntimeFix.JoinOwner
    RuntimeFix.JoinOwner = owner
    state.Busy = true

    local ok, result = pcall(RuntimeFix.monarchStep)

    state.Busy = false
    RuntimeFix.JoinOwner = previousOwner

    if not ok then
        state.RetryAt = os.clock() + 5
        warn("[Monarch] Action failed:", result)
        return false
    end

    return result == true
end

