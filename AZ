    -- อ่านอย่างเดียว ใช้ร่วมกันทั้ง Lobby และ Retry/Leave
    function RuntimeFix.getPostMonarchPlan(data)
        if RuntimeFix.monarchStage(data) < 3 then
            return nil
        end

        for _, recipe in ipairs(RuntimeFix.PostMonarchRecipes) do
            local character = recipe.Character
            local entry = data.CharactersData
                and data.CharactersData[character]

            local inventorySlot = RuntimeFix.findOwnedSlot(
                data,
                character
            )

            local stored = RuntimeFix.storageCount(
                data,
                character
            ) > 0

            local evolved = type(entry) == "table"
                and entry.IsUltimateUnlocked == true

            if (inventorySlot or stored) and not evolved then
                if not inventorySlot then
                    return {
                        Recipe = recipe,
                        NeedsStorage = true,
                        Reason = recipe.Name .. " -> retrieve from Storage",
                    }
                end

                if type(entry) ~= "table"
                    or type(entry.IsUltimateUnlocked) ~= "boolean"
                    or type(data.material) ~= "table"
                    or type(data.currencies) ~= "table"
                then
                    error("Evolution account data unavailable: " .. character)
                end

                local money = tonumber(data.currencies.money)
                local gems = tonumber(data.currencies.gems)

                if money == nil or gems == nil then
                    error("Money/Gems unavailable")
                end

                local requirements = recipe.Materials

                if recipe.MaterialNames then
                    local config = RuntimeFix.requireModule(
                        ReplicatedStorage,
                        { "assets", "config", "materialConfig" }
                    )

                    if type(config) ~= "table" then
                        error("materialConfig unavailable")
                    end

                    requirements = {}
                    local found = {}

                    for id, material in pairs(config) do
                        if type(material) == "table" then
                            local required =
                                recipe.MaterialNames[material.Name]

                            if required then
                                requirements[tostring(id)] = required
                                found[material.Name] = true
                            end
                        end
                    end

                    for name in pairs(recipe.MaterialNames) do
                        if not found[name] then
                            error(
                                "Sukuna evolution material missing: "
                                .. name
                            )
                        end
                    end
                end

                local missing = {}

                for id, required in pairs(requirements) do
                    if (tonumber(data.material[id]) or 0) < required then
                        missing[id] = true
                    end
                end

                local target = RuntimeFix.runtimeMaterialTarget(missing, 4)

                -- เมื่อของครบแล้ว แต่เงิน/เพชรยังขาด:
                -- ใช้ Shadow Gate ตามแหล่งฟาร์มเงิน/เพชรเดิม
