    return {
        Map = "spiritedawayraid",
        Chapter = 1,
        Difficulty = 4,
    }, "Hu Tao BathTub resources"
end

-- คืน nil = ให้เส้นทางเดิมทำงานต่อ
-- คืน boolean = เส้นทางนี้เป็นผู้จัดการรอบปัจจุบัน
function RuntimeFix.routeSukunaProgression()
    if AutoFarmSession.Cancelled
        or game.PlaceId ~= AUTO_JOIN_PLACE_ID
    then
        return false
    end

    local data, readError = RuntimeFix.readAccount()
    if not data then
        error("Cannot read progression: " .. tostring(readError))
    end

    local carrySlot, carryName =
        RuntimeFix.findCraftCarrySlot(data)

    local hasRaidCarry = carrySlot ~= nil

    if not hasRaidCarry
        and not RuntimeFix.findOwnedSlot(data, "sukuna")
    then
        return nil
    end

    if RuntimeFix.StoredPending or RuntimeFix.Crafting then
        return false
    end

    -- ให้ watchdog เดิมจัดการคิวที่ส่งไปแล้ว
    if ActiveLobbyQueue or AutoJoinStarted then
        return true
    end

    local craftStatus = getBlastArcherCraftNeeds()
    if not craftStatus then
        return false
    end

    -- ขั้น 1: คราฟต์ Crown และ Wings ก่อน
    if not craftStatus.crownOwned or not craftStatus.wingsOwned then
        if next(craftStatus.missing) == nil then
            print("[Progression] Materials ready -> Craft Crown/Wings")
            StartAutoCraftBlastArcher()
            return true
        end

        print("[Progression] Farm Crown/Wings materials")
        return joinBlastArcherMaterialFarm()
    end

    local sukuna = type(data.CharactersData) == "table"
        and data.CharactersData.sukuna

    local evolved = type(sukuna) == "table"
        and sukuna.IsUltimateUnlocked == true

    local gamemode
    local map
    local chapter
    local queueKey

    if not evolved and not hasRaidCarry then
        -- ขั้น 2: ลอง Evo เมื่อทรัพยากรครบ
        -- ฟังก์ชันเดิมตรวจวัตถุดิบและ Gems 1,750
        if not SukunaEvolveTriggered then
            evolveSukunaIfReady()
        end

        -- ส่งคำขอแล้ว: รอ Account ยืนยันก่อนเลือก Raid
        if SukunaEvolveTriggered then
            local deadline = os.clock() + 5

            repeat
                if AutoFarmSession.Cancelled then
                    return false
                end

                if isSukunaEvolved() then
                    evolved = true
                    break
                end

                task.wait(0.25)
            until os.clock() >= deadline

            if not evolved then
                warn("[Progression] Waiting for Sukuna Evo confirmation.")
                return true
            end
        else
            -- วัตถุดิบหรือ Gems ยังไม่ครบ
            gamemode = "Story"
            map = "Hxh"
            chapter = 1
            queueKey = "Sukuna_Evo_Hxh1_Nightmare"
        end
    end

    if evolved or hasRaidCarry then
        if isHutaoEvolved() then
            return nil
        end

        local status = getHutaoEvoStatus()

        if status.isReady then
            evolveHutaoIfReady()
            return true
        end

        if status.missingStage == "Story_Hxh_Nightmare" then
            gamemode = "Story"
            map = "Hxh"
            chapter = 1
            queueKey = "HuTao_Pendant_Hxh1"
        elseif status.missingStage == "Story_Hxh_Chapter3" then
            gamemode = "Story"
            map = "Hxh"
            chapter = 3
            queueKey = "HuTao_Cloth_Hxh3"
        elseif status.missingStage == "Raid_BathTub"
            or status.needCurrency
        then
            if not RuntimeFix.ensureBathAccessories() then
                return true
            end

            gamemode = "Raid"
            map = "BathTub"
            chapter = 1

            if hasRaidCarry then
                if carryName == "Mochi Commander" then
                    queueKey = "Katakuri_Ready_BathTub"
                else
                    queueKey = "Miyabi_Ready_BathTub"
                end
            else
                queueKey = "Sukuna_Ready_BathTub"
            end
        else
            return false
        end
    end

    if not prepareTeam() or AutoFarmSession.Cancelled then
        return false
    end

    local packets = RuntimeFix.getPackets()
    if not packets.createQuque
        or type(packets.createQuque.fire) ~= "function"
    then
        error("createQuque packet unavailable")
    end

    queueScriptOnTeleport()

    ActiveLobbyQueue = queueKey
    LastLobbyJoinAction = autoJoinBestAvailableStory
    LastLobbyJoinAttemptClock = os.clock()

    packets.createQuque:fire({
        gamemode = gamemode,
        map = map,
        chapter = chapter,
        difficulty = queueKey == "Sukuna_Evo_Hxh1_Nightmare"
            and 4
            or (
                gamemode == "Story"
                and RuntimeFix.getStoryDifficulty(chapter == 3 and 1 or 4)
                or 4
            ),
        maxPlayers = 4,
        friendsOnly = false,
        roomNumber = CurrentLobbyRoomNumber,
    })

    print(string.format(
        "[Progression] %s | %s Chapter %d | Nightmare | Room %d",
        gamemode,
        map,
        chapter,
        CurrentLobbyRoomNumber
    ))

    return true
end

-- อ่านอย่างเดียว: ไม่สร้างคิว ไม่คราฟต์ และไม่ส่ง Evo
function RuntimeFix.getNextFarmStage()
    local data, readError = RuntimeFix.readAccount()
    if not data then
        error("Account unavailable: " .. tostring(readError))
    end

    if type(data.material) ~= "table"
        or type(data.currencies) ~= "table"
        or type(data.CharactersData) ~= "table"
    then
        error("Account resources unavailable")
    end

    local function stage(map, chapter, difficulty)
        return {
            Map = map,
            Chapter = chapter,
            Difficulty = difficulty,
        }
    end

    local function story(chapter, difficulty)
        return stage(
            "hxh",
            chapter,
            RuntimeFix.getStoryDifficulty(difficulty)
        )
    end

    local function evolved(character)
        local entry = data.CharactersData[character]
        return type(entry) == "table"
            and entry.IsUltimateUnlocked == true
    end

    local readyCraft = RuntimeFix.getReadyAccessoryCraft(data)

    if readyCraft then
        return nil,
            readyCraft.Name .. " ready -> Lobby to craft"
    end

    -- Jinwoo: ใช้ลำดับสูตร Monarch เดิม
    if RuntimeFix.findOwnedSlot(data, "sung_jinwoo") then
        local currentStage = RuntimeFix.monarchStage(data)
        if currentStage >= 3 then
            return nil, "Monarch Stage III complete"
        end

        local recipe = RuntimeFix.MonarchRecipes[currentStage + 1]
        if type(recipe) ~= "table" then
            error("Monarch recipe unavailable")
        end

        local needStory = false
        local needRaid = false

        for id, required in pairs(recipe.Materials) do
            if getMaterialAmount(data, id) < required then
                if id == "101" or id == "110" then
                    needStory = true
                else
                    needRaid = true
                end
            end
        end

        local money = tonumber(data.currencies.money)
        local gems = tonumber(data.currencies.gems)
        if not money or not gems then
            error("Money/Gems unavailable")
        end

        if money < recipe.Money or gems < recipe.Gems then
            needRaid = true
        end

        if not needStory and not needRaid then
            return nil, "Monarch resources complete -> Lobby for Evo"
        end

        if needStory or not RuntimeFix.canFarmRaid() then
            return story(1, 4), "Monarch Story resources"
        end

        return stage("sololevelingraid", 1, RuntimeFix.getStoryDifficulty(4)),
            "Monarch Raid resources"
    end

    local carrySlot = RuntimeFix.findCraftCarrySlot(data)
    local hasSukuna = RuntimeFix.findOwnedSlot(data, "sukuna") ~= nil
    local hutaoEvolved = evolved("hutao")

    -- Crown ก่อน Wings ตามระบบคราฟต์เดิม
    if carrySlot or hasSukuna or hutaoEvolved then
        local recipe

        if not isAccessoryOwned(data, "113") then
            recipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Crown
        elseif not isAccessoryOwned(data, "114") then
            recipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Wings
        end

        if recipe then
            local missing = {}

            for id, required in pairs(recipe.materials) do
                if getMaterialAmount(data, id) < required then
                    missing[id] = true
                end
            end

            if next(missing) == nil then
                return nil, "Craft materials complete -> Lobby to craft"
            end

            local target = getBlastArcherFarmStage({missing = missing})
            if not target then
                error("No craft stage for missing materials")
            end

            return stage(
                "hxh",
                target.chapter,
                RuntimeFix.getStoryDifficulty(target.difficulty, true)
            ), "Crown/Wings materials"
        end
    end

    -- ไม่มี Miyabi/Katakuri: ต้อง Evo Sukuna ก่อน Raid
    if hasSukuna and not carrySlot and not evolved("sukuna") then
        local config = RuntimeFix.requireModule(
            ReplicatedStorage,
            {"assets", "config", "materialConfig"}
        )

        local required = {
            ["Fine Cloth"] = 45,
            ["Eyeball"] = 20,
            ["Cursed Finger"] = 10,
            ["Magic Pendant"] = 4,
        }

        local counts = {}

        for id, entry in pairs(config) do
            if type(entry) == "table" and required[entry.Name] then
                counts[entry.Name] = getMaterialAmount(data, id)
            end
        end

        local missing = false

        for name, amount in pairs(required) do
            if counts[name] == nil then
                error("Material config unavailable: " .. name)
            end

            if counts[name] < amount then
                missing = true
            end
        end

        local gems = tonumber(data.currencies.gems)
        if not gems then
            error("Gems unavailable")
        end

        if not missing and gems >= 1750 then
            return nil, "Sukuna resources complete -> Lobby for Evo"
        end

        -- เส้นทาง Evo Sukuna กำหนด Nightmare โดยตรง
        return stage("hxh", 1, 4), "Sukuna Evo resources"
    end

    -- ฟาร์มของ Evo Hu Tao ตามของที่ยังขาด
    if not hutaoEvolved
        and (
            carrySlot
            or evolved("sukuna")
            or RuntimeFix.findOwnedSlot(data, "hutao")
        )
    then
        local status = getHutaoEvoStatus()

        if status.isReady then
            return nil, "Hu Tao resources complete -> Lobby for Evo"
        end

        if status.missingStage == "Raid_BathTub" then
            if carrySlot or evolved("sukuna") then
                return RuntimeFix.getBathFarmTarget(data)
            end

            return nil, "Sukuna Evo required before BathTub"
        elseif status.missingStage == "Story_Hxh_Nightmare" then
            return story(1, 4), "Hu Tao Magic Pendant"
        elseif status.missingStage == "Story_Hxh_Chapter3" then
            return story(3, 1), "Hu Tao Fine Cloth"
        elseif status.needCurrency then
            if carrySlot or evolved("sukuna") then
                return RuntimeFix.getBathFarmTarget(data)
            end
        end

        return nil, "Return to Lobby to select next task"
    end

    -- หา Jinwoo หลังอุปกรณ์ครบ ตามสิทธิ์ Shadow Gate เดิม
    if isAccessoryOwned(data, "113")
        and isAccessoryOwned(data, "114")
        and RuntimeFix.canFarmRaid()
    then
        if RuntimeFix.storageCount(data, "sung_jinwoo") > 0 then
            return nil, "Jinwoo in Storage -> Lobby"
        end

        return stage("sololevelingraid", 1, RuntimeFix.getStoryDifficulty(4)),
            "Farm Sung Jinwoo"
    end

    return nil, "No active craft/Evo farming target"
end

