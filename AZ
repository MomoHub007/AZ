    function RuntimeFix.selectTrialsSlot(data)
        local config = RuntimeFix.runtimeConfig("characterRollConfig")

        local rarities = config and config.rarityByCharacter
        if type(rarities) ~= "table" then
            error("characterRollConfig.rarityByCharacter unavailable")
        end

        local weights = RuntimeFix.runtimeRarityWeights()

        local protected = {
            sung_jinwoo = true,
            hutao = true,
            frieren = true,
            rin = true,
            ye_shunguang = true,
        }

        local lowestSlot = nil
        local lowestWeight = math.huge

        for index = 1, RuntimeFix.getInventorySlotCount() do
            local slot = data.UnlockedCharacters["Slot" .. index]

            if type(slot) ~= "table" then
                error("Inventory data unavailable: Slot" .. index)
            end

            if slot.Unlocked == true then
                local character = slot.Character

                if type(character) ~= "string" then
                    error("Invalid Character: Slot" .. index)
                end

                if character == "" then
                    return index
                end

                if not protected[character]
                    and slot.Favourite ~= true
                then
                    local rarity = rarities[character]
                    local weight = weights[rarity]

                    -- ไม่เดา Rarity ของตัวที่ไม่มีใน Config
                    if not weight then
                        error("Unknown Rarity: " .. character)
                    end

                    if weight < lowestWeight then
                        lowestSlot = index
                        lowestWeight = weight
                    end
                end
            end
        end

        return lowestSlot
    end

