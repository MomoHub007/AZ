                    if not clicked then
                        return nil, nil, nil, "Could not switch to Normal Rolls: " .. clickError
                    end

                    if not waitForRollCondition(function()
                        normalAmountText = normalAmountLabel.Text
                        normalRolls = getNumberFromText(normalAmountText, "^(%d[%d,]*)%s+Rolls? Left$")
                        return normalRolls ~= nil or normalAmountText ~= oldText
                    end, 3) then
                        return nil, nil, nil, "Could not read the Normal Rolls balance."
                    end
                end

                if normalRolls and normalRolls > 0 then
                    return normalSpinButton, "Normal", "rolls"
                end

                local oldText2 = normalAmountLabel.Text
                local clicked, clickError = clickRollButton(currencyToggle)

                if not clicked then
                    return nil, nil, nil, "Could not switch to money: " .. clickError
                end

                if not waitForRollCondition(function()
                    normalAmountText = normalAmountLabel.Text
                    return (normalAmountText:match("^You have %$") ~= nil) or (normalAmountText ~= oldText2)
                end, 3) then
                    return nil, nil, nil, "Could not switch Normal Spin payment to money."
                end

                local moneyBalance = getNumberFromText(normalAmountText, "^You have %$([%d,]+)$")
                local costLabel = normalSpinButton:FindFirstChild("Fill") and normalSpinButton.Fill:FindFirstChild("Title")
                local moneyCost = costLabel and getNumberFromText(costLabel.Text, "^Normal Spin %[%$([%d,]+)%]$")

                if moneyBalance == nil or moneyCost == nil then
                    return nil, nil, nil, "Could not verify money balance or Normal Spin cost."
                end

                if moneyBalance < moneyCost then
                    return nil, nil, nil, "Not enough money for a Normal Spin."
                end

                return normalSpinButton, "Normal", "money"
            end

            print(
                "[CustomAutoRoll] START | Mode:",
                "Lucky Spins > Normal Rolls > money",
                "| Targets: Cursed King, Divine Emperor, Cataclysm"
            )

            while CustomAutoRollEnabled do
                local chosenSlot = nil

                for slotNumber = 1, RuntimeFix.getInventorySlotCount() do
                    local slotFrame =
                        characterSlots:FindFirstChild("Slot" .. slotNumber)

                    if slotFrame and not isRollSlotLocked(slotFrame) then
                        local currentCharacter =
                            getCharacterIdFromRollSlot(slotFrame)

                        local slotButton = slotFrame:FindFirstChild("MainButton")
                        local characterButton =
                            slotButton and slotButton:FindFirstChild("MainButton")
                        local content =
                            characterButton and characterButton:FindFirstChild("Content")

                        if not currentCharacter and content and content.Visible then
                            finish(
                                "Could not read the current character in Slot "
                                    .. slotNumber
                                    .. "; stopped to avoid replacing an unknown character.",
                                true
                            )
                            return
                        end

                        if not currentCharacter
                            or not AUTO_ROLL_TARGETS[currentCharacter]
                        then
                            chosenSlot = slotNumber
                            break
                        end
                    end
                end

                if not chosenSlot then
                    finish("All unlocked slots already contain target characters.")
                    return
                end

                local slotFrame =
                    characterSlots:FindFirstChild("Slot" .. chosenSlot)
                local slotButton =
                    slotFrame
                    and slotFrame:FindFirstChild("MainButton")
                    and slotFrame.MainButton:FindFirstChild("MainButton")
                local selectedFrame =
                    slotButton and slotButton:FindFirstChild("SelectedFrame")

                if not slotButton or not selectedFrame then
                    finish("Could not find the selection button for Slot " .. chosenSlot .. ".", true)
                    return
                end

                if not selectedFrame.Visible then
                    local clicked, clickError = clickRollButton(slotButton)

                    if not clicked then
                        finish("Could not select Slot " .. chosenSlot .. ": " .. clickError, true)
                        return
                    end

                    if not waitForRollCondition(function()
                        return selectedFrame.Visible
                    end, 3) then
                        finish("Could not select Slot " .. chosenSlot .. ".", true)
                        return
                    end
                end

                if warningHolder.Visible then
                    finish("Another confirmation is open; stopped without confirming it.", true)
                    return
                end

                local spinButton, spinType, paymentCurrency, selectionError =
                    chooseSpinButton()

                if not spinButton then
                    finish(selectionError or "No usable spin method is available.", true)
                    return
                end

                if not spinButton.Visible or not spinButton.Interactable then
                    finish(spinType .. " spin button is unavailable.", true)
                    return
                end

                selectedSlot = chosenSlot
                selectedSpinType = spinType
                rollResult = nil
                waitingForResult = true
                local clicked, clickError = clickRollButton(spinButton)

                if not clicked then
                    waitingForResult = false
                    finish("Could not start the " .. spinType .. " spin: " .. clickError, true)
                    return
                end

                local resultReceived = waitForRollCondition(function()
                    return rollResult ~= nil or warningHolder.Visible
                end, AUTO_ROLL_RESULT_TIMEOUT)

                if warningHolder.Visible then
                    local currentCharacter =
                        getCharacterIdFromRollSlot(slotFrame)
                    local currentCharacterIsTarget =
                        currentCharacter ~= nil
                        and AUTO_ROLL_TARGETS[currentCharacter] ~= nil

                    if not isReplacePromptForSlot(chosenSlot)
                        or currentCharacterIsTarget
                    then
                        waitingForResult = false
                        finish("Unexpected replacement confirmation; stopped without confirming it.", true)
                        return
                    end

                    local replaceButton =
                        warningPanel:FindFirstChild("Yes")

                    if not replaceButton
                        or not replaceButton:IsA("GuiButton")
                    then
                        waitingForResult = false
                        finish("Replacement confirmation button is unavailable.", true)
                        return
                    end

                    print(
                        "[CustomAutoRoll] Confirming replacement of non-target character in Slot",
                        chosenSlot,
                        "| Payment:",
                        paymentCurrency
                    )
                    task.wait(1.6)

                    if not replaceButton.Interactable then
                        waitingForResult = false
                        finish("Replacement confirmation button is unavailable.", true)
                        return
                    end

                    local clicked, clickError = clickRollButton(replaceButton)

                    if not clicked then
                        waitingForResult = false
                        finish("Could not confirm replacement: " .. clickError, true)
                        return
                    end

                    if not waitForRollCondition(function()
                        return not warningHolder.Visible
                    end, 3) then
                        waitingForResult = false
                        finish("Replacement confirmation did not close.", true)
                        return
                    end

                    resultReceived = waitForRollCondition(function()
                        return rollResult ~= nil
                    end, AUTO_ROLL_RESULT_TIMEOUT)
                end

                waitingForResult = false

                if not resultReceived or not rollResult then
                    finish("No roll result was received before timeout; stopped to avoid duplicate rolls.", true)
                    return
                end

                if not rollResult.success then
                    finish(
                        "Roll failed: "
                            .. tostring(rollResult.reason)
                            .. ".",
                        true
                    )
                    return
                end

                local rolledCharacter =
                    string.lower(tostring(rollResult.character))
                local targetName = AUTO_ROLL_TARGETS[rolledCharacter]

                if targetName then
                    finish(
                        "TARGET FOUND: "
                            .. targetName
                            .. " in Slot "
                            .. tostring(rollResult.slot)
                            .. "."
                    )
                    return
                end

                print(
                    "[CustomAutoRoll] Slot",
                    chosenSlot,
                    "rolled",
                    tostring(rollResult.character),
                    "(" .. tostring(rollResult.rarity) .. ")",
                    "| Payment:",
                    paymentCurrency
                )

                if not waitForRollCondition(function()
                    return spinButton.Interactable
                end, AUTO_ROLL_RESULT_TIMEOUT) then
                    finish("Spin button did not become available again; stopped safely.", true)
                    return
                end
            end

            disconnectResult()
        end)
    end

    function isSukunaEvolved()
        local ok, evolved = pcall(function()
            local accountNamespace =
                require(
                    ReplicatedStorage
                        :WaitForChild("global")
                        :WaitForChild("stores")
                        :WaitForChild("accountNamespace")
                )

            local account =
                accountNamespace.getLocalPlayerAccount()

            if not account
                or not account.state
                or not account.state.CharactersData
            then
                error(
                    "Account Character data is not loaded."
                )
            end

            local sukunaData =
                account.state.CharactersData.sukuna

            if not sukunaData then
                return false
            end

            if not sukunaData.IsUltimateUnlocked then
                return false
            end

            if type(sukunaData.IsUltimateUnlocked) == "table"
                and type(sukunaData.IsUltimateUnlocked.get) == "function"
            then
                return sukunaData.IsUltimateUnlocked:get() == true
            end

            return sukunaData.IsUltimateUnlocked == true
        end)

        if not ok then
            warn(
                "[AutoEvolve] Failed to check Sukuna Evo:",
                evolved
            )

            return false
        end

        return evolved == true
    end

    function joinSukunaEvoFarm()
        if game.PlaceId ~= AUTO_JOIN_PLACE_ID then
            return false
        end

        if not RuntimeFix.canFarmRaid() then
            return false
        end

        --==========================================
        -- Hu Tao Evo เสร็จแล้ว
        -- ห้ามกลับไป BathTub Raid ของ Sukuna
        -- ให้หยุด flow นี้ เพื่อให้ Auto Craft/Farm
        -- เป็นตัวตัดสินด่านถัดไป
        --==========================================

        if isHutaoEvolved() then
            print(
                "[AutoEvoFarm] Hu Tao Evo COMPLETE -> Switch to Blast Archer farming"
            )

            SukunaEvoFarmStarted = false

            local farming =
                joinBlastArcherMaterialFarm()

            if farming then
                return true
            end

            print(
                "[AutoEvoFarm] Blast Archer materials ready -> Do not join BathTub Raid"
            )

            return false
        end

        if ActiveLobbyQueue then
            print(
                "[AutoEvoFarm] Queue already active -> Skip Raid",
                "| Active:",
                ActiveLobbyQueue
            )
            return false
        end

        if not prepareTeam() then
            return false
        end

        if joinHutaoEvoFarm then
            local hutaoJoined = joinHutaoEvoFarm()

            if hutaoJoined then
                return true
            end
        end

        if SukunaEvoFarmStarted then
            return false
        end
        if not RuntimeFix.ensureBathAccessories() then
            return true
        end

        SukunaEvoFarmStarted = true
        LastLobbyJoinAction = joinSukunaEvoFarm
        LastLobbyJoinAttemptClock = os.clock()
        ActiveLobbyQueue = "Raid"

        queueScriptOnTeleport()
        task.wait(0.15)

        local ok, err = pcall(function()
            RuntimeFix.createQueue({
                gamemode = "Raid",
                map = "BathTub",
                chapter = 0,
                floor = 0,
                difficulty = 4,
                maxPlayers = 4,
                friendsOnly = false,
                roomNumber = CurrentLobbyRoomNumber,
            })
        end)

        if not ok then
            SukunaEvoFarmStarted = false
            ActiveLobbyQueue = nil

            warn("[AutoEvoFarm] CreateQuque failed:", err)
            return false
        end

        print(string.format("[AutoEvoFarm] Queue -> BathTub | Raid | Room %d", CurrentLobbyRoomNumber))
        return true
    end

    function StartCustomAutoRoll()
        if CustomAutoRollEnabled or game.PlaceId ~= AUTO_JOIN_PLACE_ID then
            return
        end

        CustomAutoRollEnabled = true

        task.spawn(function()
            local data = RuntimeFix.readAccount()

            if data and RuntimeFix.findOwnedSlot(data, "sung_jinwoo") then
                CustomAutoRollEnabled = false
                prepareTeam()
                return
            end

            if isHutaoEvolved() then
                CustomAutoRollEnabled = false

                print(
                    "[AutoRoll] Hu Tao Evo COMPLETE -> Skip Auto Roll"
                )

                task.wait(0.25)

                joinBlastArcherMaterialFarm()

                return
            end

            while (
                AutoRedeemCodesEnabled
                or AutoUnlockSlotsEnabled
                or AutoUpgradeSkillTreeEnabled
            )
                and not AutoFarmSession.Cancelled
            do
                task.wait(0.1)
            end

            if AutoFarmSession.Cancelled then
                CustomAutoRollEnabled = false
                return
            end

            local AUTO_ROLL_COST =
                RuntimeFix.runtimeRollCost("Normal").amount
            local AUTO_ROLL_SUKUNA = "sukuna"
            local AUTO_ROLL_STOP_AND_NEXT = {
                miyabi = true,
                cataclysm = true,
            }
            local KeptSpecialCharacters = {}

            local function getSpecialCharacterKey(character)
                if character == "cataclysm" then
                    return "miyabi"
                end

                return character
            end

            local packets
            local accountNamespace
            local ok, result = pcall(function()
                packets = require(
                    ReplicatedStorage
                        :WaitForChild("lobby")
                        :WaitForChild("packets")
                )
                accountNamespace = require(
                    ReplicatedStorage
                        :WaitForChild("global")
                        :WaitForChild("stores")
                        :WaitForChild("accountNamespace")
                )
            end)

            if not ok then
                CustomAutoRollEnabled = false
                warn("[AutoRoll] Failed to load game modules:", result)
                return
            end

            if not packets.rollCharacter
                or type(packets.rollCharacter.fire) ~= "function"
                or not packets.characterRolled
                or type(packets.characterRolled.on) ~= "function"
            then
                CustomAutoRollEnabled = false
                warn("[AutoRoll] Roll packet API is unavailable.")
                return
            end

            local function getAccountData()
                local account = accountNamespace.getLocalPlayerAccount()

                if not account then
                    return nil, "LocalPlayer account is unavailable."
                end

                local success, data = pcall(function()
                    return account:toTable()
                end)

                if not success then
                    return nil, tostring(data)
                end

                return data
            end

            local function getUnlockedSlotCharacter(slotNumber)
                local data, accountError = getAccountData()

                if not data then
                    return nil, nil, accountError
                end

                local unlockedCharacters = data.UnlockedCharacters

                if type(unlockedCharacters) ~= "table" then
                    return nil, nil, "UnlockedCharacters is unavailable."
                end

                local slotKey = "Slot" .. tostring(slotNumber)
                local slot = unlockedCharacters[slotKey]

                if not slot then
                    return nil, false, nil
                end

                if slot.Unlocked ~= true then
                    return nil, false, nil
                end

                return slot.Character, true, nil
            end

            local function getEquippedGameSlot1()
                local data, accountError = getAccountData()

                if not data then
                    return nil, nil, accountError
                end

                local equippedSlots = data.EquippedCharacterSlots
                local unlockedCharacters = data.UnlockedCharacters

                if type(equippedSlots) ~= "table"
                    or type(unlockedCharacters) ~= "table"
                then
                    return nil, nil,
                        "EquippedCharacterSlots or UnlockedCharacters unavailable."
                end

                local inventorySlot =
                    equippedSlots["Slot1"]
                    or equippedSlots[1]
                    or equippedSlots["1"]

                local slotNumber = tonumber(inventorySlot)

                if not slotNumber then
                    return nil, nil, nil
                end

                local characterData =
                    unlockedCharacters["Slot" .. tostring(slotNumber)]

                if not characterData
                    or characterData.Unlocked ~= true
                then
                    return nil, slotNumber, nil
                end

                return characterData.Character, slotNumber, nil
            end

            local function getRollResources()
                local data, accountError = getAccountData()

                if not data then
                    return nil, accountError
                end

                local currencies = data.currencies

                if type(currencies) ~= "table" then
                    return nil, "Currencies are unavailable."
                end

                return {
                    luckySpins = tonumber(currencies.luckySpins) or 0,
                    rolls = tonumber(currencies.rolls) or 0,
                    money = tonumber(currencies.money) or 0,
                }
            end

            local function waitForResult(condition, timeout)
                local deadline = os.clock() + timeout

                repeat
                    if condition() then
                        return true
                    end

                    task.wait(0.05)
                until os.clock() >= deadline
                    or not CustomAutoRollEnabled
                    or AutoFarmSession.Cancelled

                return condition()
            end

            local waitingForResult = false
            local currentRollSlot = nil
            local currentRequestId = 0
            local rollResult = nil
            local disconnectResult = packets.characterRolled:on(function(packet)
                if not waitingForResult
                    or type(packet) ~= "table"
                    or packet.slot ~= currentRollSlot
                    or packet.requestId ~= currentRequestId
                then
                    return
                end

                rollResult = packet
            end)

            local function finish(message, isWarning)
                CustomAutoRollEnabled = false

                if disconnectResult then
                    disconnectResult()
                    disconnectResult = nil
                end

                if isWarning then
                    warn("[AutoRoll] " .. message)
                else
                    print("[AutoRoll] " .. message)
                end
            end

            if isSukunaEvolved() then
                print(
                    "[AutoEvoFarm] Sukuna Evo already unlocked -> Skip Auto Roll"
                )

                CustomAutoRollEnabled = false

                if disconnectResult then
                    disconnectResult()
                    disconnectResult = nil
                end

                task.wait(0.5)

                joinSukunaEvoFarm()

                return
            end

            local equippedCharacter, equippedInventorySlot, equippedError =
                getEquippedGameSlot1()

            if equippedError then
                finish(equippedError, true)
                return
            end

            local normalizedEquipped =
                string.lower(tostring(equippedCharacter or ""))
                    :gsub("%s+", "")

            if normalizedEquipped == "sukuna"
                or normalizedEquipped == "cursedking"
            then
                print(
                    "[AutoRoll] Sukuna already equipped | Game Slot: 1",
                    "| Inventory Slot:",
                    tostring(equippedInventorySlot)
                )

                CustomAutoRollEnabled = false
                waitingForResult = false

                if disconnectResult then
                    disconnectResult()
                    disconnectResult = nil
                end

                StartAutoUpgradeSkillTree()

                while AutoUpgradeSkillTreeEnabled
                    and not AutoFarmSession.Cancelled
                do
                    task.wait(0.1)
                end

                print("[AutoRoll] Sukuna already equipped -> Check Evolution")
                evolveSukunaIfReady()

                local evoDeadline = os.clock() + 5
                local evoUnlocked = false

                repeat
                    evoUnlocked = isSukunaEvolved()

                    if evoUnlocked then
                        break
                    end

                    task.wait(0.25)
                until evoUnlocked
                    or os.clock() >= evoDeadline
                    or AutoFarmSession.Cancelled

                if evoUnlocked then
                    print(
                        "[AutoEvoFarm] Sukuna Evo confirmed -> Join BathTub Raid"
                    )

                    CustomAutoRollEnabled = false

                    if disconnectResult then
                        disconnectResult()
                        disconnectResult = nil
                    end

                    task.wait(0.5)

                    joinSukunaEvoFarm()
                    return
                end

                print(
                    "[AutoEvoFarm] Sukuna Evo not confirmed yet."
                )

                CustomAutoRollEnabled = false
                waitingForResult = false

                if disconnectResult then
                    disconnectResult()
                    disconnectResult = nil
                end

                task.wait(0.5)

                if not AutoFarmSession.Cancelled
                    and game.PlaceId == AUTO_JOIN_PLACE_ID
                then
                    print(
                        "[AutoRoll] Sukuna ready -> Join Story -> AutoFarm"
                    )

                    autoJoinBestAvailableStory()
                end

                return
            end

            local ownedData = RuntimeFix.readAccount()
            local carrySlot, carryName =
                RuntimeFix.findCraftCarrySlot(ownedData)

            if carrySlot then
                finish(
                    carryName
                        .. " owned -> Stop Summon -> Craft Crown/Wings"
                )

                if not AutoFarmSession.Cancelled then
                    autoJoinBestAvailableStory()
                end

                return
            end

            if isSukunaEvolved() then
                print(
                    "[AutoEvoFarm] Sukuna Evo already unlocked -> Skip Auto Roll"
                )

                CustomAutoRollEnabled = false

                if disconnectResult then
                    disconnectResult()
                    disconnectResult = nil
                end

                task.wait(0.5)

                joinSukunaEvoFarm()

                return
            end

            prepareTeam()

            print(
                "[AutoRoll] START | Priority: Lucky > Rolls > Money",
                "| Money Cost: $500"
            )

            for slotNumber = 1, RuntimeFix.getInventorySlotCount() do
                if not CustomAutoRollEnabled or AutoFarmSession.Cancelled then
                    break
                end

                local currentCharacter, isUnlocked, slotError =
                    getUnlockedSlotCharacter(slotNumber)

                if slotError then
                    finish(slotError, true)
                    return
                end

                if not isUnlocked then
                    print(
                        "[AutoRoll] Slot",
                        slotNumber,
                        "is Locked or has no data -> Skip"
                    )
                    continue
                end

                local normalizedCharacter =
                    string.lower(tostring(currentCharacter or ""))
                        :gsub("%s+", "")
                local specialCharacterKey =
                    getSpecialCharacterKey(normalizedCharacter)

                print(
                    "[AutoRoll] Unlocked Slot",
                    slotNumber,
                    "| Character:",
                    tostring(currentCharacter)
                )

                if normalizedCharacter == AUTO_ROLL_SUKUNA then
                    finish(
                        "SUKUNA already exists in Unlocked Slot "
                            .. tostring(slotNumber)
                            .. "."
                    )
                    return
                end

                if AUTO_ROLL_STOP_AND_NEXT[normalizedCharacter] then
                    if not KeptSpecialCharacters[specialCharacterKey] then
                        KeptSpecialCharacters[specialCharacterKey] = true

                        print(
                            "[AutoRoll] Keep",
                            tostring(currentCharacter),
                            "in Slot",
                            slotNumber,
                            "-> Next Slot"
                        )

                        continue
                    end

                    print(
                        "[AutoRoll] Duplicate",
                        tostring(currentCharacter),
                        "in Slot",
                        slotNumber,
                        "-> Roll this slot again"
                    )
                end

                while CustomAutoRollEnabled do
                    if AutoFarmSession.Cancelled then
                        finish("Cancelled because a newer script session started.")
                        return
                    end

                    local resources, resourceError = getRollResources()

                    if not resources then
                        finish(resourceError or "Could not read roll resources.", true)
                        return
                    end

                    print(
                        "[AutoRoll] Resources | Lucky:",
                        resources.luckySpins,
                        "| Rolls:",
                        resources.rolls,
                        "| Money:",
                        resources.money,
                        "| Unlocked Slot:",
                        slotNumber
                    )

                    local luckyCost = RuntimeFix.runtimeRollCost("Lucky")
                    local diceCost = RuntimeFix.runtimeRollCost("NormalDice")
                    local normalCost = RuntimeFix.runtimeRollCost("Normal")

                    AUTO_ROLL_COST = normalCost.amount

                    local spinType
                    local paymentCurrency

                    if (resources[luckyCost.currency] or 0) >= luckyCost.amount then
                        spinType = "Lucky"
                        paymentCurrency = luckyCost.currency

                    elseif (resources[diceCost.currency] or 0) >= diceCost.amount then
                        spinType = "Normal"
                        paymentCurrency = diceCost.currency

                    elseif (resources[normalCost.currency] or 0) >= normalCost.amount then
                        spinType = "Normal"
                        paymentCurrency = normalCost.currency

                    else
                        finish(
                            "Lucky Spins, Normal Rolls, and Money are exhausted -> Join Story"
                        )

                        task.wait(0.25)

                        if not AutoFarmSession.Cancelled
                            and game.PlaceId == AUTO_JOIN_PLACE_ID
                        then
                            autoJoinBestAvailableStory()
                        end

                        return
                    end

                    currentRequestId = currentRequestId % 65535 + 1
                    currentRollSlot = slotNumber
                    rollResult = nil
                    waitingForResult = true

                    local requestId = currentRequestId
                    local fireOk, fireError = pcall(function()
                        packets.rollCharacter:fire({
                            spinType = spinType,
                            slot = slotNumber,
                            paymentCurrency = paymentCurrency,
                            requestId = requestId,
                        })
                    end)

                    if not fireOk then
                        waitingForResult = false
                        finish("Roll request failed: " .. tostring(fireError), true)
                        return
                    end

                    print(
                        "[AutoRoll] Roll -> Unlocked Slot",
                        currentRollSlot,
                        "|",
                        spinType,
                        "|",
                        paymentCurrency,
                        "| RequestId:",
                        requestId,
                        "| Money Cost:",
                        paymentCurrency == "money" and AUTO_ROLL_COST or 0
                    )

                    local resultReceived = waitForResult(function()
                        return rollResult ~= nil
                    end, AUTO_ROLL_RESULT_TIMEOUT)

                    waitingForResult = false

                    if not resultReceived or not rollResult then
                        finish(
                            "No roll result received before timeout; stopped to prevent duplicate rolls.",
                            true
                        )
                        return
                    end

                    if not rollResult.success then
                        print(
                            "[AutoRoll] Roll failed:",
                            tostring(rollResult.reason)
                        )
                        task.wait(0.20)
                        continue
                    end

                    local rolledCharacter =
                        string.lower(tostring(rollResult.character or ""))
                            :gsub("%s+", "")
                    local rolledSpecialCharacterKey =
                        getSpecialCharacterKey(rolledCharacter)

                    print(
                        "[AutoRoll] Unlocked Slot",
                        currentRollSlot,
                        "Result:",
                        tostring(rollResult.character)
                    )

                    if rolledCharacter == "miyabi"
                        or rolledCharacter == "cataclysm"
                        or rolledCharacter == "katakuri"
                    then
                        local carryName =
                            rolledCharacter == "katakuri"
                            and "Mochi Commander"
                            or "Miyabi"

                        finish(
                            carryName
                                .. " found -> Stop Summon -> Craft Crown/Wings"
                        )

                        local deadline = os.clock() + 10
                        local confirmed = false

                        repeat
                            if AutoFarmSession.Cancelled then
                                return
                            end

                            local updated = RuntimeFix.readAccount()

                            if updated then
                                local ownedSlot =
                                    RuntimeFix.findOwnedSlot(
                                        updated,
                                        rolledCharacter
                                    )

                                if ownedSlot then
                                    confirmed = true
                                    break
                                end
                            end

                            task.wait(0.1)
                        until os.clock() >= deadline

                        if not confirmed then
                            warn(
                                "[AutoRoll] "
                                    .. carryName
                                    .. " received; waiting for account sync."
                            )
                            return
                        end

                        autoJoinBestAvailableStory()
                        return
                    end

                    if rolledCharacter == AUTO_ROLL_SUKUNA then
                        print(
                            "[AutoRoll] TARGET FOUND: SUKUNA | Unlocked Slot:",
                            currentRollSlot
                        )

                        local equipped = prepareTeam()

                        if not equipped then
                            finish(
                                "Found Sukuna but failed to equip it into gameSlot 1.",
                                true
                            )

                            return
                        end

                        print("[AutoRoll] Team equipment confirmed")

                        evolveSukunaIfReady()

                        local evoDeadline = os.clock() + 5
                        local evoUnlocked = false

                        repeat
                            evoUnlocked = isSukunaEvolved()

                            if evoUnlocked then
                                break
                            end

                            task.wait(0.25)
                        until evoUnlocked
                            or os.clock() >= evoDeadline
                            or AutoFarmSession.Cancelled

                        if evoUnlocked then
                            print(
                                "[AutoEvoFarm] Sukuna Evo confirmed -> Join BathTub Raid"
                            )

                            CustomAutoRollEnabled = false

                            if disconnectResult then
                                disconnectResult()
                                disconnectResult = nil
                            end

                            task.wait(0.5)

                            joinSukunaEvoFarm()
                            return
                        end

                        print(
                            "[AutoEvoFarm] Sukuna Evo not confirmed yet."
                        )

                        CustomAutoRollEnabled = false
                        waitingForResult = false

                        if disconnectResult then
                            disconnectResult()
                            disconnectResult = nil
                        end

                        StartAutoUpgradeSkillTree()

                        while AutoUpgradeSkillTreeEnabled
                            and not AutoFarmSession.Cancelled
                        do
                            task.wait(0.1)
                        end

                        task.wait(0.5)

                        if not AutoFarmSession.Cancelled
                            and game.PlaceId == AUTO_JOIN_PLACE_ID
                        then
                            print(
                                "[AutoRoll] Sukuna ready -> Join Story -> AutoFarm"
                            )

                            autoJoinBestAvailableStory()
                        end

                        return
                    end

                    if AUTO_ROLL_STOP_AND_NEXT[rolledCharacter] then
                        if KeptSpecialCharacters[rolledSpecialCharacterKey] then
                            print(
                                "[AutoRoll] Duplicate:",
                                tostring(rollResult.character),
                                "-> Do NOT keep | Roll Slot",
                                slotNumber,
                                "again"
                            )

                            task.wait(0.10)
                            continue
                        end

                        KeptSpecialCharacters[rolledSpecialCharacterKey] = true

                        print(
                            "[AutoRoll] KEEP:",
                            tostring(rollResult.character),
                            "in Slot",
                            slotNumber,
                            "-> Next Slot"
                        )
                        break
                    end

                    task.wait(0.10)
                end
            end

            if CustomAutoRollEnabled then
                local resources, resourceError = getRollResources()

                if not resources then
                    finish(
                        resourceError or "Could not read final roll resources.",
                        true
                    )
                    return
                end

                local luckyCost = RuntimeFix.runtimeRollCost("Lucky")
                local diceCost = RuntimeFix.runtimeRollCost("NormalDice")
                local normalCost = RuntimeFix.runtimeRollCost("Normal")

                if (resources[luckyCost.currency] or 0) < luckyCost.amount
                    and (resources[diceCost.currency] or 0) < diceCost.amount
                    and (resources[normalCost.currency] or 0) < normalCost.amount
                then
                    finish("ALL RESOURCES EXHAUSTED -> Join Story")

                    task.wait(0.25)

                    if not AutoFarmSession.Cancelled
                        and game.PlaceId == AUTO_JOIN_PLACE_ID
                    then
                        autoJoinBestAvailableStory()
                    end

                    return
                end

                finish("Auto Roll finished; eligible game slots are exhausted -> Join Story")

                task.wait(0.25)

                if not AutoFarmSession.Cancelled
                    and game.PlaceId == AUTO_JOIN_PLACE_ID
                then
                    autoJoinBestAvailableStory()
                end
            end
        end)
    end

