local function getEquippedCharacter(gameSlot)
    local ok, data = pcall(function()
        local accountNamespace =
            require(ReplicatedStorage.global.stores.accountNamespace)
        local account = accountNamespace.getLocalPlayerAccount()

        if not account then
            error("LocalPlayer account unavailable")
        end

        return account:toTable()
    end)

    if not ok or type(data) ~= "table" then
        return nil, nil, tostring(data)
    end

    local equippedSlots = data.EquippedCharacterSlots
    local unlockedCharacters = data.UnlockedCharacters

    if type(equippedSlots) ~= "table"
        or type(unlockedCharacters) ~= "table"
    then
        return nil, nil,
            "EquippedCharacterSlots or UnlockedCharacters unavailable."
    end

    local inventorySlot =
        equippedSlots["Slot" .. tostring(gameSlot)]
        or equippedSlots[gameSlot]
        or equippedSlots[tostring(gameSlot)]
    local slotNumber = tonumber(inventorySlot)

    if not slotNumber then
        return nil, nil, nil
    end

    local characterData =
        unlockedCharacters["Slot" .. tostring(slotNumber)]

    if not characterData or characterData.Unlocked ~= true then
        return nil, slotNumber, nil
    end

    return characterData.Character, slotNumber, nil
end

local function findEquippedSukuna()
    for gameSlot = 1, 4 do
        local character, inventorySlot, errorMessage =
            getEquippedCharacter(gameSlot)

        if errorMessage then
            return nil, errorMessage
        end

        local normalizedCharacter =
            string.lower(tostring(character or ""))
                :gsub("%s+", "")

        if normalizedCharacter == "sukuna"
            or normalizedCharacter == "cursedking"
        then
            return {
                gameSlot = gameSlot,
                inventorySlot = inventorySlot,
                character = character,
            }, nil
        end
    end

    return nil, nil
end

local function equipSukunaToGameSlot1(characterSlotNumber)
    local ok, data = pcall(function()
        local accountNamespace =
            require(ReplicatedStorage.global.stores.accountNamespace)

        local account =
            accountNamespace.getLocalPlayerAccount()

        if not account then
            error("LocalPlayer account unavailable")
        end

        return account:toTable()
    end)

    if not ok or not data then
        warn("[AutoRoll] Cannot read account data:", data)
        return false
    end

    local unlockedCharacters = data.UnlockedCharacters

    if type(unlockedCharacters) ~= "table" then
        warn("[AutoRoll] UnlockedCharacters unavailable")
        return false
    end

    if characterSlotNumber == nil then
        for slotNumber = 1, 4 do
            local slot =
                unlockedCharacters["Slot" .. slotNumber]

            if slot and slot.Unlocked == true then
                local characterName =
                    string.lower(tostring(slot.Character or ""))

                if characterName == "sukuna"
                    or characterName == "cursed king"
                then
                    characterSlotNumber = slotNumber
                    break
                end
            end
        end
    end

    characterSlotNumber = tonumber(characterSlotNumber)

    if not characterSlotNumber then
        warn("[AutoRoll] Sukuna inventory slot not found.")
        return false
    end

    local targetSlot =
        unlockedCharacters["Slot" .. characterSlotNumber]

    if not targetSlot or targetSlot.Unlocked ~= true then
        warn("[AutoRoll] Invalid Sukuna slot:", characterSlotNumber)
        return false
    end

    local characterName =
        string.lower(tostring(targetSlot.Character or ""))

    if characterName ~= "sukuna"
        and characterName ~= "cursed king"
    then
        warn(
            "[AutoRoll] Slot",
            characterSlotNumber,
            "is not Sukuna:",
            tostring(targetSlot.Character)
        )

        return false
    end

    local equippedSukuna, equippedError =
        findEquippedSukuna()

    if equippedError then
        warn("[AutoRoll] Cannot check equipped Sukuna:", equippedError)
        return false
    end

    if equippedSukuna then
        print(
            "[AutoRoll] Sukuna already equipped | Game Slot:",
            equippedSukuna.gameSlot,
            "| Inventory Slot:",
            equippedSukuna.inventorySlot
        )

        return true
    end

    local event =
        ReplicatedStorage:FindFirstChild("EquipCharacterSlot")

    if not event then
        warn("[AutoRoll] ReplicatedStorage.EquipCharacterSlot not found")
        return false
    end

    if not event:IsA("RemoteEvent") then
        warn("[AutoRoll] EquipCharacterSlot is not RemoteEvent")
        return false
    end

    local requestId = EquipCharacterSlotRequestId

    EquipCharacterSlotRequestId += 1

    if EquipCharacterSlotRequestId > 65535 then
        EquipCharacterSlotRequestId = 1
    end

    -- Observed packet layout: {characterSlot, 5, requestIdHigh, requestIdLow}
    local bytes = {
        characterSlotNumber,
        5,
        math.floor(requestId / 256),
        requestId % 256,
    }

    local packet = buffer.create(#bytes)

    for i, value in ipairs(bytes) do
        buffer.writeu8(packet, i - 1, value)
    end

    local fireOk, fireError = pcall(function()
        event:FireServer(packet)
    end)

    if not fireOk then
        warn("[AutoRoll] Equip Sukuna failed:", fireError)
        return false
    end

    print(
        "[AutoRoll] Equip Sukuna | Character Slot:",
        characterSlotNumber,
        "| Equip Packet Slot: 5 | RequestId:",
        requestId
    )

    return true
end

