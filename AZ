            if ActiveLobbyQueue == "Raid_ShadowGate" then
                ActiveLobbyQueue = nil
            end

            warn("[ShadowGate] Join failed:", joinError)
            return false
        end

        print(
            "[ShadowGate] Queue request sent | Room:",
            CurrentLobbyRoomNumber
        )

        return true
    end

