                or fresh.character ~= "hutao"
                or AutoFarmSession.Cancelled
            then
                return false
            end

            if isHutaoEvolved() then
                return true
            end

            local freshStatus = getHutaoEvoStatus()

            if not freshStatus or not freshStatus.isReady then
                warn("[AutoEvoHutao] Resources changed; reevaluate farm.")
                return false
            end

            local packets = RuntimeFix.getPackets()
            local packet = packets.evolveCharacter

            if not packet or type(packet.fire) ~= "function" then
                error("evolveCharacter unavailable")
