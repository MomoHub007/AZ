    local function leaveCurrentLobbyQueue(): boolean
        local function isOutsideQueue()
            local status = RuntimeFix.QueueStatus

            -- มีหลักฐานว่ายังอยู่ในคิว/กำลังวาร์ป: ต้องรอยืนยันออก
            if status == "inQuque"
                or status == "teleporting"
                or LocalPlayer:GetAttribute("QueueLeader") == true
                or LocalPlayer:GetAttribute("MatchSearching")
            then
                return false
            end

            -- idle หรือตอนเริ่มต้นที่ยังไม่ได้รับสถานะ
            -- และไม่มีห้องผูกอยู่กับผู้เล่น
            return (status == "idle" or status == nil)
                and LocalPlayer:GetAttribute("QueueRoom") == nil
        end

        if AutoFarmSession.Cancelled then
            return false
        end

        -- สร้างคิวไม่สำเร็จและไม่ได้อยู่ในห้อง:
        -- ไม่ต้องรอ Leave Event ที่อาจไม่มีวันถูกส่งมา
        if isOutsideQueue() then
            print("[LobbyWatchdog] No queue registered -> retry allowed")
            return true
        end

        local revision = RuntimeFix.QueueIdleRevision

        local ok, leaveError = pcall(function()
            local packets = RuntimeFix.getPackets()
            local packet = packets and packets.leaveQuque

            if not packet or type(packet.fire) ~= "function" then
                error("leaveQuque unavailable")
            end

            packet:fire()
        end)

        if not ok then
            warn("[LobbyWatchdog] Leave request failed:", leaveError)
            return false
        end

        local deadline = os.clock() + 5

        repeat
            if AutoFarmSession.Cancelled then
                return false
            end

            if isOutsideQueue() then
                print("[LobbyWatchdog] Outside queue confirmed")
                return true
            end

            -- รับ idle ใหม่จาก Server หลังส่ง Leave
            if RuntimeFix.QueueIdleRevision > revision
                and RuntimeFix.QueueStatus == "idle"
                and LocalPlayer:GetAttribute("QueueLeader") ~= true
                and not LocalPlayer:GetAttribute("MatchSearching")
            then
                print("[LobbyWatchdog] Leave confirmed by Server")
                return true
            end

            task.wait(0.1)
        until os.clock() >= deadline

        warn(string.format(
            "[LobbyWatchdog] Leave unresolved"
                .. " | Status=%s Room=%s Leader=%s MatchSearching=%s",
            tostring(RuntimeFix.QueueStatus),
            tostring(LocalPlayer:GetAttribute("QueueRoom")),
            tostring(LocalPlayer:GetAttribute("QueueLeader")),
            tostring(LocalPlayer:GetAttribute("MatchSearching"))
        ))

        return false
    end

