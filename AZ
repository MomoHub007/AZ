    --==================================================

    local AutoEquipBestAccessoryEnabled = false

    local function StartAutoEquipBestAccessory()
        if AutoEquipBestAccessoryEnabled
            or AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return
        end

        AutoEquipBestAccessoryEnabled = true

        task.spawn(function()
            local loaded, result = pcall(function()
                local accountNamespace = require(
                    ReplicatedStorage
                        :WaitForChild("global")
                        :WaitForChild("stores")
                        :WaitForChild("accountNamespace")
                )

                local accessoryConfig = require(
                    ReplicatedStorage
                        :WaitForChild("assets")
                        :WaitForChild("config")
                        :WaitForChild("accessoryConfig")
                )

                local packets = require(
                    ReplicatedStorage
                        :WaitForChild("lobby")
                        :WaitForChild("packets")
                )

                return {
                    account = accountNamespace.getLocalPlayerAccount(),
                    config = accessoryConfig,
                    packets = packets,
                }
            end)

            if not loaded then
                warn("[AutoAccessory] Load failed:", result)
                AutoEquipBestAccessoryEnabled = false
                return
            end

            local account = result.account
            local config = result.config
            local packets = result.packets

            if not account
                or type(config) ~= "table"
                or not packets.setEquippedAccessory
                or type(packets.setEquippedAccessory.fire) ~= "function"
            then
                warn("[AutoAccessory] Required data unavailable")
                AutoEquipBestAccessoryEnabled = false
                return
            end

            local slots = {
                "Head",
                "Face",
                "Neck",
                "Back",
            }

            local validSlots = {
                Head = true,
                Face = true,
                Neck = true,
                Back = true,
            }

            local disconnectAccessory
            local running = false
            local pending = false
            local revision = 0

            local function calculateScore(item)
                local score = 0

                if type(item.Buffs) ~= "table" then
                    return score
                end

                for _, buff in ipairs(item.Buffs) do
                    if type(buff) == "table" then
                        score += tonumber(buff.Percent) or 0
                        score += tonumber(buff.Amount) or 0
                    end
                end

                return score
            end

            local function findBestItems(data)
                local best = {}

                if type(data.accessory) ~= "table" then
                    return best
                end

                for rawId, amount in pairs(data.accessory) do
                    if (tonumber(amount) or 0) > 0 then
                        local id = tostring(rawId)
                        local item = config[id]

                        if type(item) == "table"
                            and validSlots[item.Slot]
                        then
                            local score = calculateScore(item)
                            local current = best[item.Slot]

                            if not current
                                or score > current.score
                                or (
                                    score == current.score
                                    and (tonumber(id) or math.huge)
                                        < (tonumber(current.id) or math.huge)
                                )
                            then
                                best[item.Slot] = {
                                    id = id,
                                    name = item.Name or id,
                                    score = score,
                                }
                            end
                        end
                    end
                end

                return best
            end

            local function equipBest()
                if running or AutoFarmSession.Cancelled then
                    pending = true
                    return
                end

                running = true

                repeat
                    pending = false

                    local ok, err = pcall(function()
                        local data = account:toTable()

                        if type(data) ~= "table" then
                            return
                        end

                        local equipped = data.equippedAccessories or {}
                        local best = findBestItems(data)

                        for _, slot in ipairs(slots) do
                            if AutoFarmSession.Cancelled then
                                break
                            end

                            local target = best[slot]

                            if target
                                and tostring(equipped[slot] or "")
                                    ~= target.id
                            then
                                local sent, sendError = pcall(function()
                                    packets.setEquippedAccessory:fire(target.id)
                                end)

                                if sent then
                                    print(
                                        "[AutoAccessory] Equip:",
                                        slot,
                                        target.name,
                                        "Score:",
                                        target.score
                                    )

                                    local confirmed = false
                                    local deadline = os.clock() + 2

                                    repeat
                                        task.wait(0.15)

                                        if AutoFarmSession.Cancelled then
                                            break
                                        end

                                        local latest = account:toTable()
                                        local currentEquipped =
                                            latest.equippedAccessories or {}

                                        confirmed =
                                            tostring(currentEquipped[slot] or "")
                                            == target.id
                                    until confirmed or os.clock() >= deadline

                                    if not confirmed
                                        and not AutoFarmSession.Cancelled
                                    then
                                        warn(
                                            "[AutoAccessory] Equip not confirmed:",
                                            slot,
                                            target.id
                                        )
                                    end
                                else
                                    warn(
                                        "[AutoAccessory] Equip failed:",
                                        sendError
                                    )
                                end
                            end
                        end
                    end)

                    if not ok then
                        warn("[AutoAccessory] Scan failed:", err)
                        pending = false
                    end
                until not pending or AutoFarmSession.Cancelled

                running = false
            end

            local function scheduleCheck()
                if AutoFarmSession.Cancelled then
                    return
                end

                revision += 1
                local currentRevision = revision

                task.delay(0.35, function()
                    if AutoFarmSession.Cancelled
                        or currentRevision ~= revision
                    then
                        return
                    end

                    equipBest()
                end)
            end

            local listenerOk, listenerResult = pcall(function()
                return account.state.accessory:changed(function()
                    scheduleCheck()
                end)
            end)

            if not listenerOk
                or type(listenerResult) ~= "function"
            then
                warn(
                    "[AutoAccessory] Listener failed:",
                    listenerResult
                )
                AutoEquipBestAccessoryEnabled = false
                return
            end

            disconnectAccessory = listenerResult

            AutoFarmSession.AccessoryCleanup = function()
                if disconnectAccessory then
                    disconnectAccessory()
                    disconnectAccessory = nil
                end

                AutoEquipBestAccessoryEnabled = false
            end

            print("[AutoAccessory] Watching inventory changes")
            scheduleCheck()
        end)
    end

