    prepareTeam = function(): boolean
        if AutoFarmSession.Cancelled then
            return false
        end

        if RuntimeFix.PreparingTeam then
            return false
        end

        RuntimeFix.PreparingTeam = true

        local ok, result = pcall(function()
            local data, readError = RuntimeFix.readAccount()

            if not data then
                error(readError)
            end

            if game.PlaceId == AUTO_JOIN_PLACE_ID
                and RuntimeFix.trialsEvolutionComplete(data)
            then
                return true
            end

            local unlocked = data.UnlockedCharacters

            if type(unlocked) ~= "table" then
                error("UnlockedCharacters unavailable")
            end

            local jinwooSlot = nil
            local hutaoSlot = nil
            local sukunaSlot = nil

            for slotNumber = 1, RuntimeFix.getInventorySlotCount() do
                local slot = unlocked["Slot" .. slotNumber]

                if type(slot) == "table"
                    and slot.Unlocked == true
                then
                    local name = string.lower(
                        tostring(slot.Character or "")
                    ):gsub("%s+", "")

                    if name == "sung_jinwoo" then
                        jinwooSlot = slotNumber
                    elseif name == "hutao" then
                        hutaoSlot = slotNumber
                    elseif name == "sukuna" or name == "cursedking" then
                        sukunaSlot = slotNumber
                    end
                end
            end

            local packets = RuntimeFix.getPackets()

            if not packets.equipCharacterSlot
                or type(packets.equipCharacterSlot.fire) ~= "function"
            then
                error("equipCharacterSlot unavailable")
            end

            local function equipAndVerify(inventorySlot, gameSlot)
                local current = RuntimeFix.readAccount()
                local equipped = current
                    and current.EquippedCharacterSlots

                if type(equipped) == "table"
                    and tonumber(equipped["Slot" .. gameSlot])
                        == inventorySlot
                then
                    return true
                end

                EquipCharacterSlotRequestId =
                    EquipCharacterSlotRequestId % 65535 + 1

                packets.equipCharacterSlot:fire({
                    slot = inventorySlot,
                    gameSlot = gameSlot,
                    requestId = EquipCharacterSlotRequestId,
                })

                local deadline = os.clock() + 5

                repeat
                    if AutoFarmSession.Cancelled then
                        return false
                    end

                    local updated = RuntimeFix.readAccount()
                    local slots = updated
                        and updated.EquippedCharacterSlots

                    if type(slots) == "table"
                        and tonumber(slots["Slot" .. gameSlot])
                            == inventorySlot
                    then
                        print(
                            "[PrepareTeam] Equip confirmed | Inventory:",
                            inventorySlot,
                            "| Game Slot:",
                            gameSlot
                        )

                        return true
                    end

                    task.wait(0.1)
                until os.clock() >= deadline

                warn(
                    "[PrepareTeam] Equip not confirmed | Inventory:",
                    inventorySlot,
                    "| Game Slot:",
                    gameSlot
                )

                return false
            end

            local evoState = RuntimeFix.TrialsEvolution
            local activeForEvo = evoState and evoState.ActiveForEvo

            local preparingTrials =
                workspace:GetAttribute("Mode") == "trials"
                or (
                    RuntimeFix.trialsReady(data)
                    and RuntimeFix.getTrialsTask(data) ~= nil
                )

            if preparingTrials and not activeForEvo then
                if not jinwooSlot then
                    warn("[PrepareTeam] Trials requires Sung Jinwoo in inventory")
                    return false
                end

                -- ใส่ตัวรองก่อน เพื่อย้าย Jinwoo ออกจากช่องรองถ้ามี
                if hutaoSlot and not equipAndVerify(hutaoSlot, 2) then
                    return false
                end

                if not equipAndVerify(jinwooSlot, 1) then
                    return false
                end

                if not RuntimeFix.equipPostMonarchActive("sung_jinwoo") then
                    return false
                end

                local fresh = RuntimeFix.readAccount()
                local equipped = fresh and fresh.EquippedCharacterSlots

                if type(equipped) ~= "table"
                    or tonumber(equipped.Slot1) ~= jinwooSlot
                    or fresh.character ~= "sung_jinwoo"
                    or (
                        hutaoSlot
                        and tonumber(equipped.Slot2) ~= hutaoSlot
                    )
                then
                    return false
                end

                print(
                    "[PrepareTeam] Trials CONFIRMED: Sung Jinwoo Slot1",
                    hutaoSlot and "| Hu Tao Slot2" or ""
                )

                return true
            end

            local rinSlot = RuntimeFix.findOwnedSlot(data, "rin")
            local frierenSlot = RuntimeFix.findOwnedSlot(data, "frieren")

            if rinSlot
                and frierenSlot
                and RuntimeFix.trialsReady(data)
            then
                local evoState = RuntimeFix.TrialsEvolution
                local evolvingCharacter = evoState and evoState.ActiveForEvo

                local evolvingFrieren = evolvingCharacter == "frieren"
                local evolvingYe = evolvingCharacter == "ye_shunguang"

                local mainCharacter = evolvingYe and "ye_shunguang"
                    or (evolvingFrieren and "frieren" or "rin")

                local mainSlot = evolvingYe
                    and RuntimeFix.findOwnedSlot(data, "ye_shunguang")
                    or (evolvingFrieren and frierenSlot or rinSlot)

                local subSlot = evolvingFrieren and rinSlot or frierenSlot

                if not mainSlot then
                    warn("[PrepareTeam] Evo character not in inventory:", mainCharacter)
                    return false
                end

                -- Ye Evo: Ye ช่อง 1 / Frieren ช่อง 2
                -- หลังยืนยัน Evo ระบบจะคืน Rin ช่อง 1 / Frieren ช่อง 2
                if not equipAndVerify(subSlot, 2)
                    or not equipAndVerify(mainSlot, 1)
                then
                    return false
                end

                if not RuntimeFix.equipPostMonarchActive(mainCharacter) then
                    return false
                end

                local final = RuntimeFix.readAccount()
                local equipped = final and final.EquippedCharacterSlots

                if type(equipped) ~= "table"
                    or tonumber(equipped.Slot1) ~= mainSlot
                    or tonumber(equipped.Slot2) ~= subSlot
                    or final.character ~= mainCharacter
                then
                    return false
                end

                print(
                    "[PrepareTeam] CONFIRMED:",
                    mainCharacter,
                    "Slot1 |",
                    evolvingFrieren and "rin" or "frieren",
                    "Slot2"
                )

                return true
            end

            local carrySlot, carryName =
                RuntimeFix.findCraftCarrySlot(data)

            if carrySlot and not jinwooSlot and not isHutaoEvolved() then
                if not equipAndVerify(carrySlot, 1) then
                    return false
                end

                print(
                    "[PrepareTeam] CONFIRMED: "
                        .. carryName
                        .. " Slot1"
                )

                return true
            end

            -- ยังไม่มีตัวเป้าหมาย: ใช้ตัวที่มีอยู่เพื่อฟาร์มต่อ
            if not jinwooSlot and not hutaoSlot and not sukunaSlot then
                local fallbackSlot = nil
                local fallbackCharacter = nil

                for slotNumber = 1, RuntimeFix.getInventorySlotCount() do
                    local slot = unlocked["Slot" .. slotNumber]

                    if type(slot) == "table"
                        and slot.Unlocked == true
                        and type(slot.Character) == "string"
                        and slot.Character ~= ""
                    then
                        fallbackSlot = slotNumber
                        fallbackCharacter = slot.Character
                        break
                    end
                end

                if not fallbackSlot then
                    warn("[PrepareTeam] No character in unlocked slots.")
                    return false
                end

                if not equipAndVerify(fallbackSlot, 1) then
                    return false
                end

                print(
                    "[PrepareTeam] Fallback confirmed:",
                    fallbackCharacter,
                    "| Inventory Slot:",
                    fallbackSlot,
                    "| Game Slot: 1"
                )

                return true
            end

            if jinwooSlot then
                -- มี Hu Tao ใช้ Hu Tao
                -- ระหว่างยังไม่มี ใช้ Miyabi/Katakuri หรือ Sukuna
                local supportSlot = hutaoSlot or carrySlot or sukunaSlot

                if not equipAndVerify(jinwooSlot, 1) then
                    return false
                end

                if supportSlot then
                    if not equipAndVerify(supportSlot, 2) then
                        return false
                    end
                end

                local finalData = RuntimeFix.readAccount()
                local slots = finalData
                    and finalData.EquippedCharacterSlots

                if type(slots) ~= "table"
                    or tonumber(slots.Slot1) ~= jinwooSlot
                then
                    return false
                end

                if supportSlot
                    and tonumber(slots.Slot2) ~= supportSlot
                then
                    return false
                end

                print(
                    "[PrepareTeam] CONFIRMED: Jinwoo Slot1",
                    "| Support inventory slot:",
                    supportSlot or "none"
                )

                return true
            end

            if hutaoSlot then
                if not equipAndVerify(hutaoSlot, 1) then
                    return false
                end

                if sukunaSlot then
                    return equipAndVerify(sukunaSlot, 2)
                end

                return true
            end

            return equipAndVerify(sukunaSlot, 1)
        end)

        RuntimeFix.PreparingTeam = false

        if not ok then
            warn("[PrepareTeam] Failed:", result)
            return false
        end

        return result == true
    end

