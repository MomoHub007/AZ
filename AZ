    function RuntimeFix.requireModule(root, path)
        local instance = root

        for _, name in ipairs(path) do
            instance = instance and instance:FindFirstChild(name)

            if not instance then
                error("Module path unavailable: " .. table.concat(path, "."))
            end
        end

        if not instance:IsA("ModuleScript") then
            error("Expected ModuleScript: " .. instance:GetFullName())
        end

        return require(instance)
    end

    -- แปลงเฉพาะข้อมูลเป็น Snapshot
    -- ไม่ส่ง Function หรือ Instance ข้าม Teleport
    function RuntimeFix.packRuntimeValue(value, seen)
        local kind = type(value)

        if kind == "string"
            or kind == "number"
            or kind == "boolean"
        then
            return {
                Kind = kind,
                Value = value,
            }
        end

        if kind ~= "table" then
            return nil
        end

        seen = seen or {}

        if seen[value] then
            return nil
        end

        seen[value] = true

        local entries = {}

        for key, item in pairs(value) do
            if type(key) == "string" or type(key) == "number" then
                local packed =
                    RuntimeFix.packRuntimeValue(item, seen)

                if packed then
                    table.insert(entries, {
                        Key = key,
                        Value = packed,
                    })
                end
            end
        end

        seen[value] = nil

        return {
            Kind = "table",
            Entries = entries,
        }
    end

    -- คืนชนิดข้อมูลและ Key ตัวเลขให้เหมือน Config ต้นฉบับ
    function RuntimeFix.unpackRuntimeValue(node)
        assert(
            type(node) == "table",
            "Invalid runtime snapshot node"
        )

        if node.Kind == "table" then
            assert(
                type(node.Entries) == "table",
                "Invalid runtime snapshot entries"
            )

            local value = {}

            for _, entry in ipairs(node.Entries) do
                assert(
                    type(entry.Key) == "string"
                        or type(entry.Key) == "number",
                    "Invalid runtime snapshot key"
                )

                assert(
                    value[entry.Key] == nil,
                    "Duplicate runtime snapshot key"
                )

                value[entry.Key] =
                    RuntimeFix.unpackRuntimeValue(entry.Value)
            end

            return value
        end

        assert(
            node.Kind == "string"
                or node.Kind == "number"
                or node.Kind == "boolean",
            "Unsupported runtime snapshot value"
        )

        assert(
            type(node.Value) == node.Kind,
            "Runtime snapshot type mismatch"
        )

        return node.Value
    end

    function RuntimeFix.runtimeSnapshotValue(name)
        -- ใน Lobby ต้องอ่านโมดูลจริง ไม่ใช้สำเนาจากรอบก่อน
        if game.PlaceId == AUTO_JOIN_PLACE_ID then
            return nil
        end

        local snapshot =
            SharedEnv.__AnimeZeroRuntimeSnapshot

        if type(snapshot) ~= "table"
            or snapshot.Schema ~= 1
            or snapshot.SourcePlaceId ~= AUTO_JOIN_PLACE_ID
            or snapshot.GameId ~= game.GameId
            or snapshot.UserId ~= LocalPlayer.UserId
            or type(snapshot.Configs) ~= "table"
            or type(snapshot.Configs[name]) ~= "table"
        then
            return nil
        end

        local config = RuntimeFix.unpackRuntimeValue(
            snapshot.Configs[name]
        )

        assert(
            type(config) == "table",
            "Runtime snapshot config is not a table: " .. name
        )

        return config
    end

    function RuntimeFix.runtimeConfig(name)
        RuntimeFix.RuntimeConfigs =
            RuntimeFix.RuntimeConfigs or {}

        if RuntimeFix.RuntimeConfigs[name] then
            return RuntimeFix.RuntimeConfigs[name]
        end

        local function findModule()
            local assets =
                ReplicatedStorage:FindFirstChild("assets")

            local configs =
                assets and assets:FindFirstChild("config")

            if name == "traitConfig" then
                local traits =
                    configs and configs:FindFirstChild("Traits")

                return traits
                    and traits:FindFirstChild("traitConfig")
            end

            return configs and configs:FindFirstChild(name)
        end

        local module = findModule()

        if not module then
            local cached =
                RuntimeFix.runtimeSnapshotValue(name)

            if cached then
                RuntimeFix.RuntimeConfigs[name] = cached

                local logger = getfenv().warn

                if type(logger) == "function" then
                    logger(
                        "[RuntimeConfig] Using Lobby snapshot:",
                        name
                    )
                end

                return cached
            end

            -- ไม่มี Snapshot: รอ Replication แบบมีเวลาสิ้นสุด
            local deadline = os.clock() + 10

            repeat
                if AutoFarmSession.Cancelled then
                    error("Runtime config loading cancelled")
                end

                task.wait(0.2)
                module = findModule()
            until module or os.clock() >= deadline
        end

        assert(
            module,
            "[RuntimeConfig] Missing " .. name
                .. " | PlaceId=" .. tostring(game.PlaceId)
                .. " | No valid Lobby snapshot."
                .. " Run the updated script in Lobby before joining."
        )

        assert(
            module:IsA("ModuleScript"),
            "Expected ModuleScript: " .. name
        )

        local config = require(module)

        assert(
            type(config) == "table",
            "Invalid runtime config: " .. name
        )

        RuntimeFix.RuntimeConfigs[name] = config
        return config
    end

