function RuntimeFix.startAutoEndAction()
    if RuntimeFix.EndActionStarted or AutoFarmSession.Cancelled then
        return
    end

    RuntimeFix.EndActionStarted = true

    task.spawn(function()
        local modules = nil
        local nextModuleAttempt = 0
        local sent = false
        local payoutReadyAt = nil
        local lastMessage = nil
        local lastMessageAt = 0
        local nextSendAttempt = 0

        local SETTLE_SECONDS = 2
        local SEND_ERROR_RETRY_SECONDS = 3
        local DEBUG_INTERVAL = 5

        local function report(message)
            local now = os.clock()

            if message ~= lastMessage
                or now - lastMessageAt >= DEBUG_INTERVAL
            then
                lastMessage = message
                lastMessageAt = now
                print("[AutoEnd] " .. message)
            end
        end

        print("[AutoEnd] Watcher started | Place:", game.PlaceId)

        while not AutoFarmSession.Cancelled do
            task.wait(0.25)

            local ok, err = pcall(function()
                -- โหลดไม่ทัน ให้ลองใหม่แทนการหยุดระบบ
                if not modules then
                    if os.clock() < nextModuleAttempt then
                        return
                    end

                    nextModuleAttempt = os.clock() + 1

                    local loaded = {
                        Run = RuntimeFix.requireModule(
                            ReplicatedStorage,
                            {"game", "stores", "runStore"}
                        ),
                        Packets = RuntimeFix.requireModule(
                            ReplicatedStorage,
                            {"game", "packets", "runPackets"}
                        ),
                        Maps = RuntimeFix.requireModule(
                            ReplicatedStorage,
                            {"global", "constants", "maps"}
                        ),
                    }

                    if not loaded.Run.store
                        or not loaded.Run.store.state
                    then
                        error("runStore state unavailable")
                    end

                    local packet = loaded.Packets.endAction
                    if not packet or type(packet.fire) ~= "function" then
                        error("endAction packet unavailable")
                    end

                    modules = loaded
                    report("Modules ready")
                end

                local state = modules.Run.store.state
                local participant = state.participants:get(
                    tostring(LocalPlayer.UserId)
                )

                if not participant then
                    report("Waiting: participant unavailable")
                    return
                end

                local screen = PlayerGui:FindFirstChild("EndScreen")
                local showing = screen
                    and screen:IsA("ScreenGui")
                    and screen.Enabled == true

                local status = participant.status:get()

                if status == "active" then
                    if not showing then
                        if RuntimeFix.EndRoundPaused then
                            RuntimeFix.resetFarmRound()
                            report("New round -> farm resumed")
                        end

                        RuntimeFix.EndRoundPaused = false
                        sent = false
                        payoutReadyAt = nil
                        nextSendAttempt = 0
                    end

                    return
                end

                if not showing then
                    report(
                        "Waiting: EndScreen hidden | Status: "
                        .. tostring(status)
                    )
                    return
                end

                if not RuntimeFix.EndRoundPaused then
                    RuntimeFix.EndRoundPaused = true
                    RuntimeFix.resetFarmRound()
                end

                if sent then
                    report("Action sent -> waiting for round/teleport")
                    return
                end

                local travelStatus = participant.travelStatus:get()

                if travelStatus ~= "idle" then
                    payoutReadyAt = nil

                    report(string.format(
                        "Waiting: travelStatus=%s",
                        tostring(travelStatus)
                    ))
                    return
                end
                -- The actual EndScreen only checks if travelStatus == "idle".
                -- Payouts might take a long time or not update on client correctly.


                -- รอหลัง payout แล้วอ่าน Account สดก่อนตัดสินใจ
                -- ไม่รอ JSON ของ Account ทั้งก้อนนิ่งอีกต่อไป
                if not payoutReadyAt then
                    payoutReadyAt = os.clock()
                    report("Payout complete -> waiting for account sync")
                    return
                end

                if os.clock() - payoutReadyAt < SETTLE_SECONDS then
                    return
                end

                if os.clock() < nextSendAttempt then
                    return
                end

                local currentMap = modules.Maps.currentMap
                local chapter = tonumber(state.chapter:get())
                local difficulty = tonumber(state.difficulty:get())

                if type(currentMap) ~= "string"
                    or not chapter
                    or not difficulty
                then
                    error("Current map/chapter/difficulty unavailable")
                end

                -- ฟังก์ชันเดิมอ่านข้อมูลล่าสุดและเลือกงานถัดไป
                -- ถ้าอ่านข้อมูลผิดพลาด จะไม่ส่ง Leave โดยเดา
                local target, reason = RuntimeFix.getNextFarmStage()

                -- เหตุผลจาก getNextFarmStage() ในโค้ดเดิม
                local evoFarmReasons = {
                    ["Monarch Story resources"] = true,
                    ["Monarch Raid resources"] = true,

                    ["Sukuna Evo resources"] = true,

                    ["Hu Tao Raid materials"] = true,
                    ["Hu Tao Magic Pendant"] = true,
                    ["Hu Tao Fine Cloth"] = true,
                    ["Hu Tao Money/Gems"] = true,
                }

                local isEvoFarm = evoFarmReasons[reason] == true

                local sameMapAndChapter = target ~= nil
                    and target.Map == currentMap
                    and target.Chapter == chapter

                local sameStage = sameMapAndChapter
                    and (
                        isEvoFarm
                        or target.Difficulty == difficulty
                    )

                -- Retry เล่นซ้ำด้วย Difficulty ของรอบปัจจุบัน
                local action = sameStage and 1 or 3
                local actionName = sameStage and "RETRY" or "LEAVE"

                if sameStage and isEvoFarm then
                    report(string.format(
                        "Evo materials still needed -> RETRY"
                        .. " | Map=%s | Chapter=%d | Difficulty=%d",
                        currentMap,
                        chapter,
                        difficulty
                    ))
                end

                report(string.format(
                    "Decision: %s | Current=%s/%d/%d | Target=%s | %s",
                    actionName,
                    currentMap,
                    chapter,
                    difficulty,
                    target and string.format(
                        "%s/%s/%s",
                        tostring(target.Map),
                        tostring(target.Chapter),
                        tostring(target.Difficulty)
                    ) or "Lobby",
                    tostring(reason)
                ))

                -- ส่งผ่าน Packet โดยตรง จึงไม่ต้องตรวจ
                -- Active/Interactable ของปุ่ม UI
                nextSendAttempt =
                    os.clock() + SEND_ERROR_RETRY_SECONDS

                modules.Packets.endAction:fire(action)

                -- ตั้งหลัง fire สำเร็จเท่านั้น
                -- ไม่ส่งโหวตซ้ำระหว่างรอผู้เล่นคนอื่น
                sent = true
                report("Sent: " .. actionName)
            end)

            if not ok then
                report("Error: " .. tostring(err))
            end
        end

        RuntimeFix.EndActionStarted = false
    end)
end

function RuntimeFix.guardJoin(original)
    return function(...)
        if AutoFarmSession.Cancelled then
            return false
        end

        if not AZEnabled("Lobby", "AutoJoin") then
            return false
        end

        if AZEnabled("Lobby", "ClaimBeforeJoin")
            and AZEnabled("Rewards", "AutoClaim")
            and not RuntimeFix.AutoClaimInitialReady
        then
            return false
        end

        if not RuntimeFix.runAutoTraits() then
            return false
        end

        local owner = coroutine.running()

        if RuntimeFix.JoinOwner
            and RuntimeFix.JoinOwner ~= owner
        then
            return false
        end

        local outermost = RuntimeFix.JoinOwner == nil

        if outermost then
            RuntimeFix.JoinOwner = owner
        end

        local ok, result = pcall(function(...)
            if outermost then
                if not RuntimeFix.craftReadyAccessories() then
                    return false
                end

                local routed = RuntimeFix.routeSukunaProgression()

                if routed ~= nil then
                    return routed
                end
            end

            return original(...)
        end, ...)

        if outermost then
            RuntimeFix.JoinOwner = nil
        end

        if not ok then
            ActiveLobbyQueue = nil
            AutoJoinStarted = false
            HutaoEvoFarmStarted = false
            SukunaEvoFarmStarted = false

            warn("[AutoJoin] Action failed:", result)
            return false
        end

        return result
    end
end

