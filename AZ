                RuntimeFix.AutoClaimInitialReady = true
            end

            -- รอ Claim เสร็จก่อนเข้าด่าน
            if AZEnabled("Lobby", "AutoJoin")
                and AZEnabled("Lobby", "ClaimBeforeJoin")
                and AZEnabled("Rewards", "AutoClaim")
            then
                print("[AZ Config] Waiting for rewards...")

                local claimDeadline = os.clock() + 60

                while not AutoFarmSession.Cancelled
                    and not RuntimeFix.AutoClaimInitialReady
                    and os.clock() < claimDeadline
                do
                    task.wait(0.25)
                end

                if not AutoFarmSession.Cancelled
                    and not RuntimeFix.AutoClaimInitialReady
                then
                    RuntimeFix.AutoClaimJoinReleased = true

                    warn(
                        "[AutoJoin] Reward wait exceeded 60 seconds"
                        .. " -> allowing Auto Join"
                    )
                end
            end

            if AutoFarmSession.Cancelled then
                return
            end

            -- ระบบ Auto Join
            if AZEnabled("Lobby", "AutoJoin") then
                startLobbyAutoJoinWatcher()
            end

            -- ระบบ Storage เดิม
            startUnitStorageWatcher()

            if AZEnabled("Rewards", "RedeemCodes") then
                StartAutoRedeemUnusedCodes()
