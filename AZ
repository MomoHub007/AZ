function RuntimeFix.requireModule(root, path)
    local instance = root

    for _, name in ipairs(path) do
        instance = instance and instance:FindFirstChild(name)

        if not instance then
            error("Module path unavailable: " .. table.concat(path, "."))
        end
    end

    if not instance:IsA("ModuleScript") then
        error("Expected ModuleScript: " .. instance:GetFullName())
    end

    return require(instance)
end

function RuntimeFix.getPackets()
    return RuntimeFix.requireModule(
        ReplicatedStorage,
        {"lobby", "packets"}
    )
end

function RuntimeFix.readAccount()
    local ok, result = pcall(function()
        local accountNamespace = RuntimeFix.requireModule(
            ReplicatedStorage,
            {"global", "stores", "accountNamespace"}
        )

        local account = accountNamespace.getLocalPlayerAccount()

        if not account then
            error("LocalPlayer account unavailable")
        end

        return account:toTable()
    end)

    if not ok or type(result) ~= "table" then
        return nil, tostring(result)
    end

    return result, nil
end

function RuntimeFix.getAccountLevel(data)
    local currencies =
        type(data) == "table" and data.currencies

    local xp =
        type(currencies) == "table" and currencies.xp

    if type(xp) ~= "string" then
        return nil, "currencies.xp unavailable or not a string"
    end

    local ok, result = pcall(function()
        local progression = RuntimeFix.requireModule(
            ReplicatedStorage,
            { "global", "utils", "levelProgression" }
        )

        if type(progression) ~= "table"
            or type(progression.getProgress) ~= "function"
        then
            error("levelProgression.getProgress unavailable")
        end

        -- ส่ง EXP เป็น string ตาม API เกม
        local progress = progression.getProgress(xp)

        if type(progress) ~= "table"
            or type(progress.level) ~= "number"
        then
            error("Invalid level progression result")
        end

        return progress.level
    end)

    if not ok then
        return nil, tostring(result)
    end

    return result, nil
end

