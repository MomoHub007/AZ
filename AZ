    function isRollSlotLocked(slotFrame)
        local slotButton = slotFrame:FindFirstChild("MainButton")
        local characterButton =
            slotButton and slotButton:FindFirstChild("MainButton")
        local locked = characterButton and characterButton:FindFirstChild("Locked")
        local content = locked and locked:FindFirstChild("Content")

        return content ~= nil and content.Visible
    end

    function waitForRollCondition(condition, timeout)
        local deadline = os.clock() + timeout

        repeat
            if condition() then
                return true
            end

            task.wait(0.1)
        until os.clock() >= deadline or not CustomAutoRollEnabled

        return condition()
    end

    function clickRollButton(button)
        if not button or not button:IsA("GuiButton") then
            return false, "Target is not a GUI button."
        end

        if not button.Visible or not button.Interactable then
            return false, "Target button is not currently interactable."
        end

        if typeof(firesignal) ~= "function" then
            return false, "This executor does not provide firesignal."
        end

        local ok, err = pcall(function()
            firesignal(button.MouseButton1Down)
        end)

        if not ok then
            return false, tostring(err)
        end

        return true
    end

