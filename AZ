    local BLAST_ARCHER_CRAFT_REQUIREMENTS = {
        Crown = RuntimeFix.runtimeAccessory("Blast Archer Crown"),
        Wings = RuntimeFix.runtimeAccessory("Blast Archer Wings"),
    }

    local function getBlastArcherCraftNeeds()
        local data = getAccountDataForCraft()

        if not data then
            return nil
        end

        local required = {}

        local crownOwned = isAccessoryOwned(
            data,
            RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
        )
        local wingsOwned = isAccessoryOwned(
            data,
            RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
        )

        local targetRecipe = nil

        if not crownOwned then
            targetRecipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Crown
        elseif not wingsOwned then
            targetRecipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Wings
        end

        if targetRecipe then
            for materialId, amount in pairs(targetRecipe.materials) do
                required[materialId] = amount
            end
        end

        local missing = {}

        for materialId, amount in pairs(required) do
            local current =
                getMaterialAmount(
                    data,
                    materialId
                )

            if current < amount then
                missing[materialId] = {
                    current = current,
                    required = amount,
                    missing = amount - current,
                }
            end
        end

        return {
            data = data,
            required = required,
            missing = missing,

            crownOwned =
                isAccessoryOwned(
