    end

    local requiredMaterials = {
        ["Fine Cloth"] = 45,
        ["Eyeball"] = 20,
        ["Cursed Finger"] = 10,
        ["Magic Pendant"] = 4,
    }
    local currentMaterials = {
        ["Fine Cloth"] = 0,
        ["Eyeball"] = 0,
        ["Cursed Finger"] = 0,
        ["Magic Pendant"] = 0,
    }

    for id, entry in pairs(materials) do
        local config = materialConfig[tostring(id)]

        if config and config.Name then
            local materialName = tostring(config.Name)

            if currentMaterials[materialName] ~= nil then
                local amount = entry

                if type(entry) == "table" then
                    amount =
                        entry.Amount
                        or entry.amount
                        or entry.Count
                        or entry.count
                        or entry.Value
                        or entry.value
                end

                currentMaterials[materialName] =
                    tonumber(amount) or 0
            end
        end
    end

    local currencies = data.currencies
    local gems =
        type(currencies) == "table"
        and (tonumber(currencies.gems) or 0)
        or 0

    print(
