    function RuntimeFix.startAutoEndAction()
        if RuntimeFix.EndActionStarted or AutoFarmSession.Cancelled then
            return
        end

        RuntimeFix.EndActionStarted = true

        task.spawn(function()
            local modules = nil
            local nextModuleAttempt = 0
            local sent = false
            local payoutReadyAt = nil
            local lastMessage = nil
            local lastMessageAt = 0
            local nextSendAttempt = 0

            local huntingCharacter = nil
            local trialsOwnedAtEntry = nil

            local raidCharacters = {
                sololevelingraid = "sung_jinwoo",
            }

            local function ownsRaidCharacter(data, character)
                return RuntimeFix.findOwnedSlot(data, character) ~= nil
                    or RuntimeFix.storageCount(data, character) > 0
            end

            local SETTLE_SECONDS = 2
            local SEND_ERROR_RETRY_SECONDS = 3
            local DEBUG_INTERVAL = 5

            local function report(message)
                local now = os.clock()

                if message ~= lastMessage
                    or now - lastMessageAt >= DEBUG_INTERVAL
                then
                    lastMessage = message
                    lastMessageAt = now

                    local logger = getfenv().warn

                    if type(logger) == "function" then
                        logger("[AutoEnd] " .. message)
                    end
                end
            end

            print("[AutoEnd] Watcher started | Place:", game.PlaceId)

            while not AutoFarmSession.Cancelled do
                task.wait(0.25)

                local ok, err = pcall(function()
                    -- โหลดไม่ทัน ให้ลองใหม่แทนการหยุดระบบ
                    if not modules then
                        if os.clock() < nextModuleAttempt then
                            return
                        end

                        nextModuleAttempt = os.clock() + 1

                        local loaded = {
                            Run = RuntimeFix.requireModule(
                                ReplicatedStorage,
                                {"game", "stores", "runStore"}
                            ),
                            Packets = RuntimeFix.requireModule(
                                ReplicatedStorage,
                                {"game", "packets", "runPackets"}
                            ),
                            Maps = RuntimeFix.requireModule(
                                ReplicatedStorage,
                                {"global", "constants", "maps"}
                            ),
                        }

                        if not loaded.Run.store
                            or not loaded.Run.store.state
                        then
                            error("runStore state unavailable")
                        end

                        local packet = loaded.Packets.endAction
                        if not packet or type(packet.fire) ~= "function" then
                            error("endAction packet unavailable")
                        end

                        modules = loaded
                        report("Modules ready")
                    end

                    -- จำเป้าหมายตั้งแต่ยังไม่มีตัว
                    -- คงค่าไว้หลัง Retry จนกว่าจะได้รับแล้ว Leave
                    if not huntingCharacter then
                        local mode = workspace:GetAttribute("Mode")

                        local map = raidCharacters[mode] and mode
                            or modules.Maps.currentMap

                        local character = raidCharacters[map]

                        if character then
                            local data = RuntimeFix.readAccount()

                            if data
                                and type(data.UnlockedCharacters) == "table"
                                and type(data.achievements) == "table"
                                and type(data.achievements.progress) == "table"
                            then
                                local stored = RuntimeFix.storageCount(
                                    data, character
                                )

                                if stored > 0
                                    or not ownsRaidCharacter(data, character)
                                then
                                    huntingCharacter = character
                                end
                            end
                        end
                    end

                    if workspace:GetAttribute("Mode") == "trials"
                        and not trialsOwnedAtEntry
                    then
                        local data = RuntimeFix.readAccount()

                        if not data then
                            report("Waiting for Trials account data")
                            return
                        end

                        local snapshot = {}

                        for _, target in ipairs(RuntimeFix.TrialsTargets) do
                            snapshot[target.Character] =
                                RuntimeFix.trialsOwns(data, target.Character)
                        end

                        trialsOwnedAtEntry = snapshot
                    end

                    local state = modules.Run.store.state
                    local participant = state.participants:get(
                        tostring(LocalPlayer.UserId)
                    )

                    if not participant then
                        report("Waiting: participant unavailable")
                        return
                    end

                    local screen = PlayerGui:FindFirstChild("EndScreen")
                    local showing = (screen
                        and screen:IsA("ScreenGui")
                        and screen.Enabled == true)
                        or PlayerGui:GetAttribute("EndScreenActive") == true

                    local status = participant.status:get()

                    if status == "active" then
                        if not showing then
                            if RuntimeFix.EndRoundPaused then
                                RuntimeFix.resetFarmRound()
                                report("New round -> farm resumed")
                            end

                            RuntimeFix.EndRoundPaused = false
                            sent = false
                            payoutReadyAt = nil
                            nextSendAttempt = 0
                        end

                        return
                    end

                    if not showing then
                        report(
                            "Waiting: EndScreen hidden | Status: "
                            .. tostring(status)
                        )
                        return
                    end

                    if not RuntimeFix.EndRoundPaused then
                        RuntimeFix.EndRoundPaused = true
                        RuntimeFix.resetFarmRound()
                    end

                    if sent then
                        report("Action sent -> waiting for round/teleport")
                        return
                    end

                    local travelStatus = participant.travelStatus:get()

                    if travelStatus ~= "idle" then
                        payoutReadyAt = nil

                        report(string.format(
                            "Waiting: travelStatus=%s",
                            tostring(travelStatus)
                        ))
                        return
                    end

                    local mode = workspace:GetAttribute("Mode")

                    -- Raid/BathTub ยืนยันรางวัลเฉพาะรอบที่ชนะ (รอบ failed ไม่มี payout ให้รอ)
                    if status ~= "failed"
                        and (huntingCharacter or mode == "spiritedawayraid")
                    then
                        local payoutStatus = participant.payoutStatus
                            and participant.payoutStatus:get()
                        local materialsAwarded = participant.materialsAwarded
                            and participant.materialsAwarded:get()

                        -- Anime Zero ตั้งค่า payoutStatus เป็น "paid" หรือ materialsAwarded = true เมื่อแจกรางวัลเสร็จ
                        local payoutDone = payoutStatus == "paid"
                            or payoutStatus == "completed"
                            or materialsAwarded == true

                        if not payoutDone then
                            payoutReadyAt = nil
                            report(string.format(
                                "Waiting rewards | Mode=%s | Character=%s"
                                    .. " | payoutStatus=%s"
                                    .. " | materialsAwarded=%s",
                                tostring(mode or "Unknown"),
                                tostring(huntingCharacter),
                                tostring(payoutStatus),
                                tostring(materialsAwarded)
                            ))
                            return
                        end
                    end

                    -- รอหลัง payout แล้วอ่าน Account สดก่อนตัดสินใจ
                    -- ไม่รอ JSON ของ Account ทั้งก้อนนิ่งอีกต่อไป
                    if not payoutReadyAt then
                        payoutReadyAt = os.clock()
                        report("Payout complete -> waiting for account sync")
                        return
                    end

                    if os.clock() - payoutReadyAt < SETTLE_SECONDS then
                        return
                    end

                    if os.clock() < nextSendAttempt then
                        return
                    end

                    if workspace:GetAttribute("Mode") == "trials" then
                        local data = RuntimeFix.readAccount()
                        if not data then
                            report("Waiting for Trials account sync")
                            return
                        end

                        local obtained = false
                        local allOwned = true
                        local needsStorage = false

                        for _, target in ipairs(RuntimeFix.TrialsTargets) do
                            local owned, slot = RuntimeFix.trialsOwns(
                                data, target.Character
                            )

                            if not owned then
                                allOwned = false
                            elseif not slot then
                                needsStorage = true
                            end

                            if owned
                                and trialsOwnedAtEntry
                                and not trialsOwnedAtEntry[target.Character]
                            then
                                obtained = true
                            end
                        end

                        local action
                        local actionName

                        if obtained then
                            action = 3
                            actionName = "LEAVE"

                        elseif state.canNext:get() == true then
                            action = 2
                            actionName = "NEXT FLOOR"

                        elseif status == "failed" then
                            action = 1
                            actionName = "RETRY"

                        else
                            -- canNext อาจอัปเดตช้ากว่าหน้าจบรอบ
                            -- รอตรวจใหม่ แทนการรีบโหวต Retry
                            report("Trials: waiting for Next Floor availability")
                            return
                        end

                        report(
                            "Trials Decision: " .. actionName
                            .. (obtained and " | Target obtained" or "")
                        )

                        nextSendAttempt =
                            os.clock() + SEND_ERROR_RETRY_SECONDS

                        modules.Packets.endAction:fire(action)

                        -- Trials ตรวจต่อจนรอบใหม่เริ่มหรือ travelStatus เปลี่ยน
                        -- nextSendAttempt จำกัดการส่งซ้ำไว้ที่ 3 วินาที
                        sent = false

                        report("Sent: " .. actionName)
                        return
                    end

                    mode = workspace:GetAttribute("Mode") or mode

                    local currentMap = (mode and mode ~= "" and mode)
                        or (raidCharacters[mode] and mode)
                        or modules.Maps.currentMap
                    local chapter = tonumber(state.chapter:get())
                    local difficulty = tonumber(state.difficulty:get())

                    if type(currentMap) ~= "string"
                        or not chapter
                        or not difficulty
                    then
                        error("Current map/chapter/difficulty unavailable")
                    end

                    local target = nil
                    local reason = nil
                    local huntingAction = nil

                    if huntingCharacter then
                        local data = RuntimeFix.readAccount()

                        if not data
                            or type(data.UnlockedCharacters) ~= "table"
                            or type(data.achievements) ~= "table"
                            or type(data.achievements.progress) ~= "table"
                        then
                            report("Waiting for character/Storage data")
                            return
                        end

                        if huntingCharacter == "hutao" then
                            huntingAction = 3
                            target = nil
                            reason = "Hu Tao hunt -> Leave after match"

                        elseif ownsRaidCharacter(data, huntingCharacter) then
                            huntingAction = 3
                            target = nil

                            reason = "Obtained " .. huntingCharacter
                                .. " -> Lobby to retrieve/equip"
                        else
                            huntingAction = 1

                            target = {
                                Map = currentMap,
                                Chapter = chapter,
                                Difficulty = difficulty,
                            }

                            reason = "Still finding " .. huntingCharacter
                                .. " -> Retry"
                        end
                    else
                        -- เรียกตัวเลือกงานทั่วไปเฉพาะเมื่อไม่ได้กำลังหาตัวละคร
                        target, reason = RuntimeFix.getNextFarmStage()
                    end

                    -- เหตุผลจาก getNextFarmStage() ในโค้ดเดิม
                    local evoFarmReasons = {
                        ["Monarch Story resources"] = true,
                        ["Monarch Raid resources"] = true,

                        ["Sukuna Evo resources"] = true,

                        ["Hu Tao Raid materials"] = true,
                        ["Hu Tao Magic Pendant"] = true,
                        ["Hu Tao Fine Cloth"] = true,
                        ["Hu Tao Money/Gems"] = true,
                    }

                    local isEvoFarm = evoFarmReasons[reason] == true

                    local sameMapAndChapter = target ~= nil
                        and target.Map == currentMap
                        and (
                            raidCharacters[currentMap] ~= nil
                            or target.Chapter == chapter
                        )

                    local isHuTaoEvoFarm =
                        reason == "Hu Tao Magic Pendant"
                        or reason == "Hu Tao Fine Cloth"
                        or reason == "Hu Tao Raid materials"
                        or reason == "Hu Tao Money/Gems"
                        or reason == "Hu Tao BathTub resources"

                    local isMonarchFarm =
                        reason == "Monarch Story resources"
                        or reason == "Monarch Raid resources"

                    local sameStage = sameMapAndChapter
                        and (
                            target.Difficulty == difficulty
                            or (
                                isEvoFarm
                                and not isHuTaoEvoFarm
                                and not isMonarchFarm
                            )
                        )

                    -- Retry เล่นซ้ำด้วย Difficulty ของรอบปัจจุบัน
                    local action = huntingAction
                        or (sameStage and 1 or 3)

                    -- งานสุดท้าย: อยู่ Shadow Gate แล้วให้ Retry ต่อ
                    if reason == "Endless Shadow Gate"
                        and workspace:GetAttribute("Mode") == "sololevelingraid"
                    then
                        action = 1
                    end

                    -- ดัน BathTub: จบรอบแล้วต้อง LEAVE กลับ Lobby เสมอ
                    if mode == "spiritedawayraid" or currentMap == "spiritedawayraid" then
                        action = 3
                        target = nil
                        reason = "BathTub Raid finished -> Leave to Lobby"
                    end

                    local actionName =
                        action == 1 and "RETRY"
                        or (action == 2 and "NEXT FLOOR" or "LEAVE")

                    if sameStage and isEvoFarm and action == 1 then
                        report(string.format(
                            "Evo materials still needed -> RETRY"
                            .. " | Map=%s | Chapter=%d | Difficulty=%d",
                            currentMap,
                            chapter,
                            difficulty
                        ))
                    end

                    report(string.format(
                        "Decision: %s | Current=%s/%d/%d | Target=%s | %s",
                        actionName,
                        currentMap,
                        chapter,
                        difficulty,
                        target and string.format(
                            "%s/%s/%s",
                            tostring(target.Map),
                            tostring(target.Chapter),
                            tostring(target.Difficulty)
                        ) or "Lobby",
                        tostring(reason)
                    ))

                    -- ส่งผ่าน Packet โดยตรง จึงไม่ต้องตรวจ
                    -- Active/Interactable ของปุ่ม UI
                    nextSendAttempt =
                        os.clock() + SEND_ERROR_RETRY_SECONDS

                    modules.Packets.endAction:fire(action)

                    -- หากเป็น LEAVE อนุญาตให้ส่งซ้ำหากผ่านไป 3 วิแล้วยังอยู่ที่เดิม
                    if action == 3 then
                        sent = false
                    else
                        sent = true
                    end
                    report("Sent: " .. actionName)
                end)

                if not ok then
                    report("Error: " .. tostring(err))
                end
            end

            RuntimeFix.EndActionStarted = false
        end)
    end

    function RuntimeFix.guardJoin(original)
        return function(...)
            if AutoFarmSession.Cancelled then
                return false
            end

            if not AZEnabled("Lobby", "AutoJoin") then
                return false
            end

            if AZEnabled("Lobby", "ClaimBeforeJoin")
                and AZEnabled("Rewards", "AutoClaim")
                and not RuntimeFix.AutoClaimInitialReady
                and not RuntimeFix.AutoClaimJoinReleased
            then
                return false
            end

            if not RuntimeFix.runAutoTraits() then
                return false
            end

            local owner = coroutine.running()

            if RuntimeFix.JoinOwner
                and RuntimeFix.JoinOwner ~= owner
            then
                return false
            end

            local outermost = RuntimeFix.JoinOwner == nil

            if outermost then
                RuntimeFix.JoinOwner = owner
            end

            local ok, result = pcall(function(...)
                if outermost then
                    if not RuntimeFix.craftReadyAccessories() then
                        return false
                    end

                    local routed = RuntimeFix.routeSukunaProgression()

                    if routed ~= nil then
                        return routed
                    end
                end

                return original(...)
            end, ...)

            if outermost then
                RuntimeFix.JoinOwner = nil
            end

            if not ok then
                ActiveLobbyQueue = nil
                AutoJoinStarted = false
                HutaoEvoFarmStarted = false
                SukunaEvoFarmStarted = false

                warn("[AutoJoin] Action failed:", result)
                return false
            end

            return result
        end
    end

