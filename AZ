    local LobbyAutoJoinWatcherStarted = false

    function startLobbyAutoJoinWatcher()
        if game.PlaceId ~= AUTO_JOIN_PLACE_ID
            or LobbyAutoJoinWatcherStarted
            or AutoFarmSession.Cancelled
        then
            return
        end

        LobbyAutoJoinWatcherStarted = true

        task.spawn(function()
            while not AutoFarmSession.Cancelled do
                local listenerOk, listenerError = pcall(function()
                    if RuntimeFix.QueueListenerStarted then
                        return
                    end

                    local packets = RuntimeFix.getPackets()
                    local statusPacket = packets.updateClientQuqueStatus

                    if not statusPacket
                        or type(statusPacket.on) ~= "function"
                    then
                        error("updateClientQuqueStatus unavailable")
                    end

                    local disconnect = statusPacket:on(function(status)
                        if AutoFarmSession.Cancelled then
                            return
                        end

                        RuntimeFix.QueueStatus = status

                        if status == "idle" then
                            RuntimeFix.QueueIdleRevision += 1
                        end
                    end)

                    if typeof(disconnect) == "function" then
                        table.insert(AutoFarmSession.Cleanups, disconnect)
                    elseif typeof(disconnect) == "RBXScriptConnection" then
                        table.insert(AutoFarmSession.Cleanups, function()
                            disconnect:Disconnect()
                        end)
                    end

                    RuntimeFix.QueueListenerStarted = true
                end)

                if listenerOk then
                    break
                end

                warn("[LobbyWatchdog] Listener unavailable:", listenerError)
                task.wait(2)
            end

            while not AutoFarmSession.Cancelled
                and game.PlaceId == AUTO_JOIN_PLACE_ID
            do
                task.wait(1)

                if AutoFarmSession.Cancelled then
                    break
                end

                -- กู้คำขอคิวที่หมดเวลาก่อนแยกเส้นทาง progression
                local queueTimedOut =
                    ActiveLobbyQueue ~= nil
                    and LastLobbyJoinAttemptClock > 0
                    and os.clock() - LastLobbyJoinAttemptClock
                        >= LOBBY_JOIN_TIMEOUT_SECONDS

                local canRecover =
                    AZEnabled("Lobby", "AutoJoin")
                    and RuntimeFix.JoinOwner == nil
                    and not RuntimeFix.Monarch.Busy
                    and not RuntimeFix.PreparingTeam
                    and not RuntimeFix.Crafting
                    and not RuntimeFix.StoredPending

                if queueTimedOut and canRecover then
                    local previousRoom = CurrentLobbyRoomNumber
                    local previousQueue = ActiveLobbyQueue
                    local previousAction = LastLobbyJoinAction

                    -- ถือสิทธิ์ระหว่างรอ Leave เพื่อไม่ให้งานอื่นสร้างคิวซ้อน
                    local recoveryOwner = coroutine.running()
                    RuntimeFix.JoinOwner = recoveryOwner

                    local recoveryOk, recovered = pcall(function()
                        if AutoFarmSession.Cancelled
                            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
                        then
                            return false
                        end

                        -- ฟังก์ชันเดิมรองรับปล่อยคำขอที่หมดเวลา
                        -- แม้ไม่ได้รับคำยืนยัน Leave
                        if not RuntimeFix.monarchClearQueue() then
                            return false
                        end

                        if AutoFarmSession.Cancelled
                            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
                        then
                            return false
                        end

                        cycleNextRoomNumber()
                        LobbyRetryCount += 1

                        HutaoEvoFarmStarted = false
                        SukunaEvoFarmStarted = false

                        -- เก็บงานเดิมไว้ให้ลูปถัดไปเรียกใหม่
                        LastLobbyJoinAction = previousAction

                        if RuntimeFix.webhookIssue then
                            RuntimeFix.webhookIssue(
                                "Auto Join timeout",
                                "ยังอยู่ Lobby หลังหมดเวลาคิว"
                                    .. "\nเป้าหมาย: " .. tostring(previousQueue)
                                    .. "\nห้องเดิม: " .. tostring(previousRoom)
                                    .. " → ห้องใหม่: " .. tostring(CurrentLobbyRoomNumber)
                            )
                        end

                        warn(string.format(
                            "[LobbyWatchdog] Queue timeout -> retry next room"
                                .. " | Queue=%s | Room=%s -> %s | Retry=%d",
                            tostring(previousQueue),
                            tostring(previousRoom),
                            tostring(CurrentLobbyRoomNumber),
                            LobbyRetryCount
                        ))

                        return true
                    end)

                    -- คืนสิทธิ์เฉพาะงานนี้ ห้ามล้างสิทธิ์ของงานอื่น
                    if RuntimeFix.JoinOwner == recoveryOwner then
                        RuntimeFix.JoinOwner = nil
                    end

                    if not recoveryOk then
                        warn("[LobbyWatchdog] Recovery failed:", recovered)
                    elseif not recovered then
                        warn("[LobbyWatchdog] Recovery not completed; checking again")
                    end

                    continue
                end

                local startOk, startError = pcall(RuntimeFix.tryStartQueueNow)

                if not startOk then
                    warn("[AutoStart] Start Now failed:", startError)
                end

                -- Debug ใช้ลูป Watchdog เดิม ไม่สร้างลูปเพิ่ม
                local debugNow = os.clock()

                if debugNow >= (RuntimeFix.NextQueueDebugAt or 0) then
                    RuntimeFix.NextQueueDebugAt = debugNow + 5

                    local age = LastLobbyJoinAttemptClock > 0
                        and math.floor(debugNow - LastLobbyJoinAttemptClock)
                        or -1

                    local monarch = RuntimeFix.Monarch

                    warn(string.format(
                        "[QueueFlow] Room=%s ActiveQueue=%s Age=%s Status=%s"
                            .. " | JoinOwner=%s MonarchBusy=%s"
                            .. " | StoredPending=%s PreparingTeam=%s Crafting=%s"
                            .. " | Redeem=%s Unlock=%s SkillTree=%s Summon=%s",
                        tostring(CurrentLobbyRoomNumber),
                        tostring(ActiveLobbyQueue),
                        tostring(age),
                        tostring(RuntimeFix.QueueStatus),
                        tostring(RuntimeFix.JoinOwner ~= nil),
                        tostring(monarch and monarch.Busy),
                        tostring(RuntimeFix.StoredPending ~= nil
                            and RuntimeFix.StoredPending ~= false),
                        tostring(RuntimeFix.PreparingTeam),
                        tostring(RuntimeFix.Crafting),
                        tostring(AutoRedeemCodesEnabled),
                        tostring(AutoUnlockSlotsEnabled),
                        tostring(AutoUpgradeSkillTreeEnabled),
                        tostring(CustomAutoRollEnabled)
                    ))
                end

                local jinwooData = RuntimeFix.readAccount()

                if not jinwooData then
                    continue
                end

                if RuntimeFix.StoredPending then
                    continue
                end

                if RuntimeFix.findOwnedSlot(jinwooData, "sung_jinwoo") then
                    RuntimeFix.runMonarch()
                    continue
                end

                if RuntimeFix.storageCount(jinwooData, "sung_jinwoo") > 0 then
                    continue
                end

                if RuntimeFix.JoinOwner
                    or RuntimeFix.Crafting
                    or RuntimeFix.PreparingTeam
                then
                    continue
                end

                local prepInProgress = AutoRedeemCodesEnabled
                    or AutoUnlockSlotsEnabled
                    or AutoUpgradeSkillTreeEnabled
                    or CustomAutoRollEnabled

                local hasAttempt = LastLobbyJoinAttemptClock > 0
                local timedOut = hasAttempt
                    and os.clock() - LastLobbyJoinAttemptClock
                        >= LOBBY_JOIN_TIMEOUT_SECONDS

                if not timedOut
                    and (hasAttempt or prepInProgress)
                then
                    continue
                end

                if timedOut then
                    local previousRoom = CurrentLobbyRoomNumber
                    local leaveConfirmed = leaveCurrentLobbyQueue()

                    if AutoFarmSession.Cancelled then
                        break
                    end

                    -- เปลี่ยนห้องแม้คิวเดิมไม่ยืนยันการออก
                    local nextRoom = cycleNextRoomNumber()
                    LobbyRetryCount += 1

                    -- ล้างตัวจำกัดการส่ง Start Now ของรอบเดิม
                    RuntimeFix.StartNowRoom = nil
                    RuntimeFix.StartNowLastSentAt = nil

                    warn(
                        "[LobbyWatchdog] Retry:",
                        LobbyRetryCount,
                        "| Previous room:",
                        previousRoom,
                        "| Next room:",
                        nextRoom,
                        "| Leave confirmed:",
                        leaveConfirmed
                    )
                end

                if AutoFarmSession.Cancelled then
                    break
                end

                AutoJoinStarted = false
                HutaoEvoFarmStarted = false
                SukunaEvoFarmStarted = false
                ActiveLobbyQueue = nil
                LastLobbyJoinAttemptClock = os.clock()

                local action = LastLobbyJoinAction
                    or autoJoinBestAvailableStory

                local ok, result = pcall(action)

                if not ok then
                    warn("[LobbyWatchdog] Join failed:", result)
                elseif result == false
                    and not ActiveLobbyQueue
                    and action ~= autoJoinBestAvailableStory
                    and not AutoFarmSession.Cancelled
                then
                    local fallbackOk, fallbackError =
                        pcall(autoJoinBestAvailableStory)

                    if not fallbackOk then
                        warn(
                            "[LobbyWatchdog] Fallback failed:",
                            fallbackError
                        )
                    end
                end
            end

            LobbyAutoJoinWatcherStarted = false
        end)
    end

