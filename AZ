    local function getEquippedCharacter(gameSlot)
        local ok, data = pcall(function()
            local accountNamespace =
                require(ReplicatedStorage.global.stores.accountNamespace)
            local account = accountNamespace.getLocalPlayerAccount()

            if not account then
                error("LocalPlayer account unavailable")
            end

            return account:toTable()
        end)

        if not ok or type(data) ~= "table" then
            return nil, nil, tostring(data)
        end

        local equippedSlots = data.EquippedCharacterSlots
        local unlockedCharacters = data.UnlockedCharacters

        if type(equippedSlots) ~= "table"
            or type(unlockedCharacters) ~= "table"
        then
            return nil, nil,
                "EquippedCharacterSlots or UnlockedCharacters unavailable."
        end

        local inventorySlot =
            equippedSlots["Slot" .. tostring(gameSlot)]
            or equippedSlots[gameSlot]
            or equippedSlots[tostring(gameSlot)]
        local slotNumber = tonumber(inventorySlot)

        if not slotNumber then
            return nil, nil, nil
        end

        local characterData =
            unlockedCharacters["Slot" .. tostring(slotNumber)]

        if not characterData or characterData.Unlocked ~= true then
            return nil, slotNumber, nil
        end

        return characterData.Character, slotNumber, nil
    end

    local function findEquippedSukuna()
        for gameSlot = 1, 4 do
            local character, inventorySlot, errorMessage =
                getEquippedCharacter(gameSlot)

            if errorMessage then
                return nil, errorMessage
            end

            local normalizedCharacter =
                string.lower(tostring(character or ""))
                    :gsub("%s+", "")

            if normalizedCharacter == "sukuna"
                or normalizedCharacter == "cursedking"
            then
                return {
                    gameSlot = gameSlot,
                    inventorySlot = inventorySlot,
                    character = character,
                }, nil
            end
        end

        return nil, nil
    end

    local function equipSukunaToGameSlot1(characterSlotNumber)
        local ok, data = pcall(function()
            local accountNamespace =
                require(ReplicatedStorage.global.stores.accountNamespace)

            local account =
                accountNamespace.getLocalPlayerAccount()

            if not account then
                error("LocalPlayer account unavailable")
            end

            return account:toTable()
        end)

        if not ok or not data then
            warn("[AutoRoll] Cannot read account data:", data)
            return false
        end

