    function RuntimeFix.getIgrisPlan(data)
        if RuntimeFix.monarchStage(data) < 3 then
            error("Auto Igris requires Monarch Stage 3")
        end

        if type(data.material) ~= "table"
            or type(data.currencies) ~= "table"
        then
            error("Igris resource data unavailable")
        end

        local money = tonumber(data.currencies.money)
        if money == nil then
            error("Igris Money unavailable")
        end

        local firstMissing = nil
        local firstMissingMaterials = nil

        for _, node in ipairs(RuntimeFix.IgrisNodeOrder) do
            local level = RuntimeFix.getIgrisLevel(data, node)
            local recipe = RuntimeFix.IgrisRecipes[node][level + 1]

            if recipe then
                local missing = {}
                local affordable = money >= recipe.Money

                for id, amount in pairs(recipe.Materials) do
                    local have = getMaterialAmount(data, id)
                    if have < amount then
                        affordable = false
                        table.insert(missing, string.format(
                            "%s=%d/%d", id, have, amount
                        ))
                    end
                end

                if money < recipe.Money then
                    table.insert(missing, string.format(
                        "Money=%s/%s",
                        tostring(money),
                        tostring(recipe.Money)
                    ))
                end

                local plan = {
                    Node = node,
                    Level = level + 1,
                    Ready = affordable,
                    Reason = node .. " Lv." .. (level + 1),
                }

                if affordable then
                    plan.Reason = plan.Reason .. " ready -> Lobby"
                    return plan
                end

                plan.Reason = plan.Reason
                    .. " missing: " .. table.concat(missing, ", ")

                if not firstMissing then
                    firstMissing = plan
                    firstMissingMaterials = {}

                    for id, required in pairs(recipe.Materials) do
                        if getMaterialAmount(data, id) < required then
                            firstMissingMaterials[id] = true
                        end
                    end
                end
            end
        end

        if firstMissing then
            firstMissing.Target =
                RuntimeFix.runtimeMaterialTarget(firstMissingMaterials, 4)
                or {
                    Map = "sololevelingraid",
                    Chapter = 1,
                    Difficulty = 4,
                }
        end

        return firstMissing
    end

