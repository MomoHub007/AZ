            local packets = require(ReplicatedStorage.lobby.packets)

            if status.missingStage == "Raid_BathTub" then
                print(string.format("[AutoEvoHutao] Joining Spirited Away Raid (BathTub) | Room %d...", CurrentLobbyRoomNumber))
                ActiveLobbyQueue = "Raid"

                RuntimeFix.createQueue({
                    gamemode = "Raid",
                    map = "BathTub",
                    chapter = 1,
                    difficulty = 4, -- Nightmare
                    maxPlayers = 4,
                    friendsOnly = false,
                    roomNumber = CurrentLobbyRoomNumber
                })
            elseif status.missingStage == "Story_Hxh_Nightmare" then
                print(string.format("[AutoEvoHutao] Joining Story Hxh Chapter 1 (Nightmare) | Room %d...", CurrentLobbyRoomNumber))
                ActiveLobbyQueue = "Story_Hxh_Nightmare"

                RuntimeFix.createQueue({
                    gamemode = "Story",
                    map = "Hxh",
                    chapter = 1,
                    difficulty = 4, -- Nightmare
                    maxPlayers = 4,
                    friendsOnly = false,
                    roomNumber = CurrentLobbyRoomNumber
                })
            elseif status.missingStage == "Story_Hxh_Chapter3" then
                print(string.format("[AutoEvoHutao] Joining Story Hxh Chapter 3 | Room %d...", CurrentLobbyRoomNumber))
                ActiveLobbyQueue = "Story_Hxh_Chapter3"

                RuntimeFix.createQueue({
                    gamemode = "Story",
                    map = "Hxh",
                    chapter = 3,
                    difficulty = 4, -- Nightmare
                    maxPlayers = 4,
                    friendsOnly = false,
                    roomNumber = CurrentLobbyRoomNumber
                })
            end
