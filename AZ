prepareTeam = function(): boolean
    if AutoFarmSession.Cancelled then
        return false
    end

    if RuntimeFix.PreparingTeam then
        return false
    end

    RuntimeFix.PreparingTeam = true

    local ok, result = pcall(function()
        local data, readError = RuntimeFix.readAccount()

        if not data then
            error(readError)
        end

        local unlocked = data.UnlockedCharacters

        if type(unlocked) ~= "table" then
            error("UnlockedCharacters unavailable")
        end

        local jinwooSlot = nil
        local hutaoSlot = nil
        local sukunaSlot = nil

        for slotNumber = 1, 4 do
            local slot = unlocked["Slot" .. slotNumber]

            if type(slot) == "table"
                and slot.Unlocked == true
            then
                local name = string.lower(
                    tostring(slot.Character or "")
                ):gsub("%s+", "")

                if name == "sung_jinwoo" then
                    jinwooSlot = slotNumber
                elseif name == "hutao" then
                    hutaoSlot = slotNumber
                elseif name == "sukuna" or name == "cursedking" then
                    sukunaSlot = slotNumber
                end
            end
        end

        local packets = RuntimeFix.getPackets()

        if not packets.equipCharacterSlot
            or type(packets.equipCharacterSlot.fire) ~= "function"
        then
            error("equipCharacterSlot unavailable")
        end

        local function equipAndVerify(inventorySlot, gameSlot)
            local current = RuntimeFix.readAccount()
            local equipped = current
                and current.EquippedCharacterSlots

            if type(equipped) == "table"
                and tonumber(equipped["Slot" .. gameSlot])
                    == inventorySlot
            then
                return true
            end

            EquipCharacterSlotRequestId =
                EquipCharacterSlotRequestId % 65535 + 1

            packets.equipCharacterSlot:fire({
                slot = inventorySlot,
                gameSlot = gameSlot,
                requestId = EquipCharacterSlotRequestId,
            })

            local deadline = os.clock() + 5

            repeat
                if AutoFarmSession.Cancelled then
                    return false
                end

                local updated = RuntimeFix.readAccount()
                local slots = updated
                    and updated.EquippedCharacterSlots

                if type(slots) == "table"
                    and tonumber(slots["Slot" .. gameSlot])
                        == inventorySlot
                then
                    print(
                        "[PrepareTeam] Equip confirmed | Inventory:",
                        inventorySlot,
                        "| Game Slot:",
                        gameSlot
                    )

                    return true
                end

                task.wait(0.1)
            until os.clock() >= deadline

            warn(
                "[PrepareTeam] Equip not confirmed | Inventory:",
                inventorySlot,
                "| Game Slot:",
                gameSlot
            )

            return false
        end

        local carrySlot, carryName =
            RuntimeFix.findCraftCarrySlot(data)

        if carrySlot and not jinwooSlot and not isHutaoEvolved() then
            if not equipAndVerify(carrySlot, 1) then
                return false
            end

            print(
                "[PrepareTeam] CONFIRMED: "
                    .. carryName
                    .. " Slot1"
            )

            return true
        end

        -- ยังไม่มีตัวเป้าหมาย: ใช้ตัวที่มีอยู่เพื่อฟาร์มต่อ
        if not jinwooSlot and not hutaoSlot and not sukunaSlot then
            local fallbackSlot = nil
            local fallbackCharacter = nil

            for slotNumber = 1, 4 do
                local slot = unlocked["Slot" .. slotNumber]

                if type(slot) == "table"
                    and slot.Unlocked == true
                    and type(slot.Character) == "string"
                    and slot.Character ~= ""
                then
                    fallbackSlot = slotNumber
                    fallbackCharacter = slot.Character
                    break
                end
            end

            if not fallbackSlot then
                warn("[PrepareTeam] No character in unlocked slots.")
                return false
            end

            if not equipAndVerify(fallbackSlot, 1) then
                return false
            end

            print(
                "[PrepareTeam] Fallback confirmed:",
                fallbackCharacter,
                "| Inventory Slot:",
                fallbackSlot,
                "| Game Slot: 1"
            )

            return true
        end

        if jinwooSlot then
            if not hutaoSlot then
                warn("[PrepareTeam] Jinwoo owned but Hu Tao not found.")
                return false
            end

            if not equipAndVerify(jinwooSlot, 1) then
                return false
            end

            if not equipAndVerify(hutaoSlot, 2) then
                return false
            end

            local finalData = RuntimeFix.readAccount()
            local slots = finalData and finalData.EquippedCharacterSlots

            local confirmed = type(slots) == "table"
                and tonumber(slots.Slot1) == jinwooSlot
                and tonumber(slots.Slot2) == hutaoSlot

            if confirmed then
                print("[PrepareTeam] CONFIRMED: Jinwoo Slot1 | Hu Tao Slot2")
            end

            return confirmed
        end

        if hutaoSlot then
            if not equipAndVerify(hutaoSlot, 1) then
                return false
            end

            if sukunaSlot then
                return equipAndVerify(sukunaSlot, 2)
            end

            return true
        end

        return equipAndVerify(sukunaSlot, 1)
    end)

    RuntimeFix.PreparingTeam = false

    if not ok then
        warn("[PrepareTeam] Failed:", result)
        return false
    end

    return result == true
end

