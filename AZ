        local state = RuntimeFix.IgrisAuto
        local data = RuntimeFix.readAccount()
        if not data then
            return false
        end

        local pending = state.Pending
        if pending then
            local level = RuntimeFix.getIgrisLevel(data, pending.Node)

            if level >= pending.Level then
                RuntimeFix.igrisLog(string.format(
                    "Confirmed: %s Lv.%d", pending.Node, level
                ))
                state.Pending = nil
            elseif pending.Response
                and not pending.Response.Success
            then
                warn(
                    "[AutoIgris] Rejected:",
                    pending.Node,
                    pending.Response.Reason
                )
                state.Pending = nil
                state.RetryAt = os.clock() + 5
                return false
            else
                if os.clock() - pending.SentAt >= 15 then
                    RuntimeFix.igrisLog(
                        "Waiting for Account confirmation: "
                        .. pending.Node
                        .. " | No duplicate request"
                    )
                end
                return false
            end
        end

        if os.clock() < state.RetryAt then
            return false
        end

        local plan = RuntimeFix.getIgrisPlan(data)
        if not plan then
            return RuntimeFix.runAutoTrials()
        end

        if plan.Ready then
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            local packets = RuntimeFix.getPackets()
            local packet = packets.igrisUpgrade
            if not packet or type(packet.fire) ~= "function" then
                error("igrisUpgrade unavailable")
            end

            RuntimeFix.listenIgrisResult(packets)

            -- การออกคิวอาจ yield จึงตรวจข้อมูลใหม่ก่อนใช้ทรัพยากร
            local fresh = RuntimeFix.readAccount()
            if not fresh or AutoFarmSession.Cancelled then
                return false
            end

            local freshPlan = RuntimeFix.getIgrisPlan(fresh)
            if not freshPlan or not freshPlan.Ready then
                return false
            end

            state.Pending = {
                Node = freshPlan.Node,
                Level = freshPlan.Level,
                SentAt = os.clock(),
                Response = nil,
            }

            -- เก็บ Pending ก่อนส่ง เพื่อรองรับผลที่กลับมาเร็ว
            packet:fire(freshPlan.Node)
            RuntimeFix.igrisLog(string.format(
                "Requested: %s Lv.%d",
                freshPlan.Node,
                freshPlan.Level
            ))
            return true
        end

        local queueKey = "Igris_ShadowGate"

        if ActiveLobbyQueue == queueKey
            and LastLobbyJoinAttemptClock > 0
            and os.clock() - LastLobbyJoinAttemptClock
                < LOBBY_JOIN_TIMEOUT_SECONDS
        then
            return true
        end

        local retrying = ActiveLobbyQueue == queueKey
        if not RuntimeFix.monarchClearQueue() then
            return false
        end

        if retrying then
            cycleNextRoomNumber()
        end

        if not prepareTeam()
            or AutoFarmSession.Cancelled
            or not queueScriptOnTeleport()
        then
            return false
        end

        ActiveLobbyQueue = queueKey
        LastLobbyJoinAttemptClock = os.clock()
        LastLobbyJoinAction = RuntimeFix.runMonarch

        local target = plan.Target
        local isStory = target.Map == "hxh"

        RuntimeFix.createQueue({
            gamemode = isStory and "Story" or "Raid",

            map = isStory and "Hxh"
                or (
                    target.Map == "spiritedawayraid"
                    and "BathTub"
                    or "ShadowGate"
                ),

            chapter = isStory and target.Chapter or 0,
            floor = 0,
            difficulty = target.Difficulty,
            maxPlayers = 1,
            friendsOnly = false,
            roomNumber = CurrentLobbyRoomNumber,
        })

        RuntimeFix.igrisLog(
            plan.Reason .. " -> Shadow Gate | Room "
            .. CurrentLobbyRoomNumber
        )
        return true
    end

    function RuntimeFix.runPostMonarchEvo()
        local state = RuntimeFix.PostMonarchEvo
        local data = RuntimeFix.readAccount()

        if not data or RuntimeFix.monarchStage(data) < 3 then
            return false
        end

        -- ตรวจคำขอเดิมก่อนเลือกตัวหรือส่งคำขอใหม่
        local pending = state.Pending

        if pending then
            local entry = data.CharactersData
                and data.CharactersData[pending.Character]

            if type(entry) == "table"
                and entry.IsUltimateUnlocked == true
            then
                RuntimeFix.postMonarchLog(
                    "Evolution confirmed: " .. pending.Character
                )
                state.Pending = nil
            elseif pending.Response
                and not pending.Response.Success
            then
                warn(
                    "[PostMonarchEvo] Evolution rejected:",
                    pending.Character,
                    pending.Response.Reason
                )

                state.Pending = nil
                state.RetryAt = os.clock() + 5
                return false
            else
                if os.clock() - pending.SentAt >= 15 then
                    RuntimeFix.postMonarchLog(
                        "Waiting for Account Evo confirmation: "
                        .. pending.Character
                        .. " | No duplicate request"
                    )
                end

                return false
            end
        end

        if os.clock() < state.RetryAt then
            return false
        end

        local plan = RuntimeFix.getPostMonarchPlan(data)

        if not plan then
            return RuntimeFix.runAutoIgris()
        end

        if plan.NeedsStorage then
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            RuntimeFix.postMonarchLog(plan.Reason)
            return false
        end

        local recipe = plan.Recipe
        local target = plan.Target

        if not target then
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            local packets = RuntimeFix.getPackets()
            local packet = packets.evolveCharacter

            if not packet or type(packet.fire) ~= "function" then
                error("evolveCharacter unavailable")
            end

            RuntimeFix.listenPostMonarchEvo(packets)

            if not RuntimeFix.equipPostMonarchActive(
                recipe.Character
            ) then
                state.RetryAt = os.clock() + 5
                return false
            end

            -- Equip มีการ yield: อ่านสูตรและทรัพยากรใหม่ก่อน Evo
            local fresh = RuntimeFix.readAccount()
            local freshPlan = fresh
                and RuntimeFix.getPostMonarchPlan(fresh)

            if not freshPlan
                or freshPlan.NeedsStorage
                or freshPlan.Target
                or freshPlan.Recipe.Character ~= recipe.Character
                or fresh.character ~= recipe.Character
                or AutoFarmSession.Cancelled
            then
                return false
            end

            state.Pending = {
                Character = recipe.Character,
                SentAt = os.clock(),
                Response = nil,
            }

            -- คง Pending หาก fire error เพราะคำขออาจส่งถึง Server แล้ว
            packet:fire(recipe.Character)

            RuntimeFix.postMonarchLog(
                "Evolution requested: " .. recipe.Character
            )

            return true
        end

        local queueKey = string.format(
            "PostMonarch_%s_%s_%d",
            recipe.Character,
            target.Map,
            target.Chapter
        )

        if ActiveLobbyQueue == queueKey
            and LastLobbyJoinAttemptClock > 0
            and os.clock() - LastLobbyJoinAttemptClock
                < LOBBY_JOIN_TIMEOUT_SECONDS
        then
            return true
        end

        local retrying = ActiveLobbyQueue == queueKey

        if not RuntimeFix.monarchClearQueue() then
            return false
        end

        if retrying then
            cycleNextRoomNumber()
        end

        -- ใช้ทีมฟาร์มเดิมก่อนสร้างคิว
        if not prepareTeam()
            or AutoFarmSession.Cancelled
            or not queueScriptOnTeleport()
        then
            return false
        end

        local packets = RuntimeFix.getPackets()
        local packet = packets.createQuque

        if not packet or type(packet.fire) ~= "function" then
            error("createQuque unavailable")
        end

        ActiveLobbyQueue = queueKey
        LastLobbyJoinAttemptClock = os.clock()
        LastLobbyJoinAction = RuntimeFix.runMonarch

        local isStory = target.Map == "hxh"

        RuntimeFix.createQueue({
            gamemode = isStory and "Story" or "Raid",
            map = isStory and "Hxh"
                    or (
                        target.Map == "spiritedawayraid"
                        and "BathTub"
                        or "ShadowGate"
                    ),
            chapter = isStory and target.Chapter or 0,
            difficulty = target.Difficulty,
            maxPlayers = 1,
            friendsOnly = false,
            roomNumber = CurrentLobbyRoomNumber,
        })

        RuntimeFix.postMonarchLog(string.format(
            "%s -> %s Chapter %d Nightmare | Room %d",
            recipe.Name,
            target.Map,
            target.Chapter,
            CurrentLobbyRoomNumber
        ))

        return true
    end

    function RuntimeFix.monarchStep()
        local state = RuntimeFix.Monarch

        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            or RuntimeFix.StoredPending
            or RuntimeFix.PreparingTeam
            or RuntimeFix.Crafting
            or AutoRedeemCodesEnabled
            or AutoUnlockSlotsEnabled
            or AutoUpgradeSkillTreeEnabled
            or CustomAutoRollEnabled
        then
            return false
        end

        -- ไม่แทรกการโรลระหว่างรอผล Evolution
        if not state.Pending then
            if not RuntimeFix.runAutoTraits() then
                return false
            end
        end

        local data = RuntimeFix.readAccount()
        if not data
            or not RuntimeFix.findOwnedSlot(data, "sung_jinwoo")
        then
            return false
        end

        -- ทำ Hu Tao ให้เสร็จก่อนเริ่มขั้น Monarch ถัดไป
        -- หากส่งคำขอ Monarch ไปแล้ว ให้จัดการผลเดิมก่อน
        if not state.Pending then
            local hutao = data.CharactersData
                and data.CharactersData.hutao

            if not hutao or hutao.IsUltimateUnlocked ~= true then
                return RuntimeFix.routeSukunaProgression() == true
            end
        end

        local stage = RuntimeFix.monarchStage(data)
        local pending = state.Pending

        -- ยืนยันจาก Account ก่อนเริ่มขั้นถัดไป
        if pending then
            if stage >= pending.Stage then
                RuntimeFix.monarchLog(
                    "Stage " .. pending.Stage .. " confirmed"
                )
                state.Pending = nil
            elseif pending.Response
                and not pending.Response.Success
            then
                warn(
                    "[Monarch] Evolution rejected:",
                    pending.Response.Reason
                )
                state.Pending = nil
                state.RetryAt = os.clock() + 5
                return false
            else
                if os.clock() - pending.SentAt >= 15 then
                    RuntimeFix.monarchLog(
                        "Waiting for evolution confirmation; "
                        .. "request will not be sent twice"
                    )
                end
                return false
            end
        end

        if os.clock() < state.RetryAt then
            return false
        end

        if stage >= 3 then
            -- คราฟต์ไอเทมที่พร้อมก่อน ตามระบบเดิม
            if not RuntimeFix.craftReadyAccessories() then
                return false
            end

            return RuntimeFix.runPostMonarchEvo()
        end

        local target = stage + 1
        local recipe = RuntimeFix.MonarchRecipes[target]
        local materials = data.material
        local currencies = data.currencies

        if type(materials) ~= "table"
            or type(currencies) ~= "table"
        then
            RuntimeFix.monarchLog("Waiting for account resources")
            return false
        end

        local missingMaterials = {}

        for id, required in pairs(recipe.Materials) do
            if getMaterialAmount(data, id) < required then
                missingMaterials[id] = true
            end
        end

        local runtimeTarget =
            RuntimeFix.runtimeMaterialTarget(missingMaterials, 4)

        local needStory =
            runtimeTarget ~= nil and runtimeTarget.Map == "hxh"

        local needRaid =
            runtimeTarget ~= nil and runtimeTarget.Map ~= "hxh"

        local money = tonumber(currencies.money)
        local gems = tonumber(currencies.gems)
        if money == nil or gems == nil then
            return false
        end

        -- ตรวจงบของขั้นถัดไปจากยอด Account ปัจจุบัน
        local missingMoney = math.max(0, recipe.Money - money)
        local missingGems = math.max(0, recipe.Gems - gems)
        local needCurrency = missingMoney > 0 or missingGems > 0

        -- Shadow Gate ให้ทั้งเงิน เพชร และวัตถุดิบ Monarch
        -- หากยังขาดของ Story ระบบเลือก Hxh ก่อนตามเงื่อนไขเดิม
        if needCurrency then
            needRaid = true
        end

        -- เข้าเงื่อนไขอีโวเฉพาะเมื่อวัตถุดิบและงบครบแล้ว
        if not needStory and not needRaid then
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            if not prepareTeam() then
                return false
            end

            -- prepareTeam มีการ yield จึงอ่านทรัพยากรใหม่ก่อนส่ง
            local fresh = RuntimeFix.readAccount()
            if not fresh or RuntimeFix.monarchStage(fresh) ~= stage then
                return false
            end

            for id, required in pairs(recipe.Materials) do
                if (tonumber((fresh.material or {})[id]) or 0)
                    < required
                then
                    return false
                end
            end

            local funds = fresh.currencies or {}
            if (tonumber(funds.money) or 0) < recipe.Money
                or (tonumber(funds.gems) or 0) < recipe.Gems
            then
                return false
            end

            local packets = RuntimeFix.getPackets()
            RuntimeFix.monarchListen(packets)

            if AutoFarmSession.Cancelled then
                return false
            end

            state.Pending = {
                Stage = target,
                SentAt = os.clock(),
            }

            -- หาก fire error ให้คง Pending เพราะอาจส่งถึง server แล้ว
            if target == 1 then
                packets.evolveCharacter:fire("sung_jinwoo")
            else
                packets.monarchEvolve:fire(target)
            end

            RuntimeFix.monarchLog(
                "Evolution requested: Stage " .. target
            )
            return true
        end

        -- ยังไม่มี Sukuna Evo ให้เลือก Story แทน Shadow Gate
        if not needStory and not RuntimeFix.canFarmRaid() then
            needStory = true
        end

        local queueKey = needStory
            and "Monarch_Hxh1"
            or "Monarch_ShadowGate"

        if ActiveLobbyQueue == queueKey
            and LastLobbyJoinAttemptClock > 0
            and os.clock() - LastLobbyJoinAttemptClock
                < LOBBY_JOIN_TIMEOUT_SECONDS
        then
            return true
        end

        local retrying = ActiveLobbyQueue == queueKey

        if not RuntimeFix.monarchClearQueue() then
            return false
        end

        if retrying then
            cycleNextRoomNumber()
        end

        if not prepareTeam() or AutoFarmSession.Cancelled then
            return false
        end

        -- ต้องโหลดสคริปต์ต่อได้หลัง teleport
        if not queueScriptOnTeleport() then
            RuntimeFix.monarchLog(
                "Cannot queue script for next teleport"
            )
            return false
        end

        local packets = RuntimeFix.getPackets()

        ActiveLobbyQueue = queueKey
        LastLobbyJoinAttemptClock = os.clock()
        LastLobbyJoinAction = RuntimeFix.runMonarch

        RuntimeFix.createQueue({
            gamemode = needStory and "Story" or "Raid",
            map = needStory and "Hxh"
                or (
                    runtimeTarget
                    and runtimeTarget.Map == "spiritedawayraid"
                    and "BathTub"
                    or "ShadowGate"
                ),
            chapter = needStory
                and (runtimeTarget and runtimeTarget.Chapter or 1)
                or 0,
            difficulty = 4, -- Nightmare สำหรับฟาร์ม Evo Jinwoo
            maxPlayers = 1,
            friendsOnly = false,
            roomNumber = CurrentLobbyRoomNumber,
        })

        RuntimeFix.monarchLog(string.format(
            "Stage %d -> %s | Room %d",
            target, queueKey, CurrentLobbyRoomNumber
        ))
        return true
    end

    function RuntimeFix.runMonarch()
        local state = RuntimeFix.Monarch
        local owner = coroutine.running()

        if state.Busy
            or (RuntimeFix.JoinOwner and RuntimeFix.JoinOwner ~= owner)
        then
            return false
        end

        local previousOwner = RuntimeFix.JoinOwner
        RuntimeFix.JoinOwner = owner
        state.Busy = true

        local ok, result = pcall(RuntimeFix.monarchStep)

        state.Busy = false
        RuntimeFix.JoinOwner = previousOwner

        if not ok then
            state.RetryAt = os.clock() + 5
            if RuntimeFix.webhookIssue then
                RuntimeFix.webhookIssue(
                    "Progression ทำงานล้มเหลว",
                    "งาน progression เกิด Error ซ้ำ; ตรวจ [Monarch] Action failed ใน executor"
                )
            end
            warn("[Monarch] Action failed:", result)
            return false
        end

        return result == true
    end

