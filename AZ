    function RuntimeFix.getConfiguredTraitTargets()
        local characters = AZUserSettings.Characters
        local configured = nil

        if type(characters) == "table" then
            configured = characters.TraitTargets
        end

        if configured == nil then
            configured = AZDefaults.Characters.TraitTargets
        end

        if configured == false then
            return {}
        end

        if type(configured) ~= "table" then
            if type(characters) ~= "table" then
                characters = {}
                AZUserSettings.Characters = characters
            end

            characters.AutoTrait = false

            local logger = getfenv().warn

            if type(logger) == "function" then
                logger(
                    "[AutoTrait Config] Invalid TraitTargets;"
                        .. " AutoTrait disabled for this run"
                )
            end

            return {}
        end

        local targets = {}
        local seen = {}

        for index, characterId in ipairs(configured) do
            assert(
                type(characterId) == "string" and characterId ~= "",
                "Invalid TraitTargets entry: " .. tostring(index)
            )

            if not seen[characterId] then
                seen[characterId] = true
                table.insert(targets, characterId)
            end
        end

        return targets
    end

    RuntimeFix.AutoTrait = {
        Targets = RuntimeFix.getConfiguredTraitTargets(),
        Enabled = AZEnabled("Characters", "AutoTrait"),
        Busy = false,
        Halted = false,
        Listening = false,
        RequestId = 0,
        LastSentAt = -math.huge,
        RetryAt = 0,
        Pending = nil,

        Interval = 1,
        ResponseTimeout = 10,
        SyncTimeout = 10,

        KeepTraitIds = RuntimeFix.runtimeKeepTraitIds(),
    }

    function RuntimeFix.isTraitReadyForJoin()
        local state = RuntimeFix.AutoTrait

        -- ยังเริ่มระบบไม่ครบ: ห้ามปล่อยเข้าด่าน
        if not state or AutoFarmSession.Cancelled then
            return false
        end

        if not state.Enabled then
            return true
        end

        -- ต้องรอคำขอเดิมและข้อมูลบัญชีให้ซิงค์ก่อน
        if state.Busy or state.Pending then
            return false
        end

        local data = RuntimeFix.readAccount()

        if not data
            or type(data.UnlockedCharacters) ~= "table"
            or type(data.CharactersData) ~= "table"
            or type(data.currencies) ~= "table"
        then
            return false
        end

        local balance = tonumber(data.currencies.traitRerolls)
        if balance == nil then
            return false
        end

        for _, characterId in ipairs(state.Targets) do
            if RuntimeFix.findOwnedSlot(data, characterId) then
                local character = data.CharactersData[characterId]
                local traitData = type(character) == "table"
                    and character.TraitData

                local traitId = type(traitData) == "table"
                    and tonumber(traitData.Trait)

                if traitId == nil then
                    return false
                end

                if not state.KeepTraitIds[traitId]
                    and balance >= 1
                then
                    return false
                end
            end
        end

        -- ไม่มีตัวเป้าหมายใน Slot:
        -- อนุญาตให้ระบบหา/รับตัวละครเดิมทำงานต่อ
        return true
    end

    function RuntimeFix.traitKeepListCleared(data)
        local settings = data and data.settings

        -- ข้อมูลยังไม่พร้อม ไม่ถือว่าเคลียร์แล้ว
        if type(settings) ~= "table" then
            return false
        end

        for key, value in pairs(settings) do
            if type(key) == "string"
                and key:match("^SkipTrait%d+$")
                and value == true
            then
                return false
            end
        end

        return true
    end

    function RuntimeFix.clearTraitKeepList()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        local data = RuntimeFix.readAccount()
        local settings = data and data.settings

        if type(settings) ~= "table" then
            warn("[AutoTrait] Keep settings unavailable -> retry later")
            return false
        end

        if RuntimeFix.traitKeepListCleared(data) then
            return true
        end

        local globalPackets = RuntimeFix.requireModule(
            ReplicatedStorage,
            {"global", "packets"}
        )

        local packet = globalPackets and globalPackets.setBoolSetting

        if not packet or type(packet.fire) ~= "function" then
            error("global.packets.setBoolSetting unavailable")
        end

        local keys = {}

        for key, value in pairs(settings) do
            if type(key) == "string"
                and key:match("^SkipTrait%d+$")
                and value == true
            then
                table.insert(keys, key)
            end
        end

        table.sort(keys)

        print("[AutoTrait] Untick All -> clearing:", #keys)

        for _, key in ipairs(keys) do
            if AutoFarmSession.Cancelled
                or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            then
                return false
            end

            packet:fire({
                id = key,
                value = false,
            })

            task.wait(0.1)
        end

        local deadline = os.clock() + 5

        repeat
            if AutoFarmSession.Cancelled
                or game.PlaceId ~= AUTO_JOIN_PLACE_ID
            then
                return false
            end

            if RuntimeFix.traitKeepListCleared(
                RuntimeFix.readAccount()
            ) then
                print("[AutoTrait] Untick All confirmed -> roll allowed")
                return true
            end

            task.wait(0.1)
        until os.clock() >= deadline

        warn("[AutoTrait] Untick All not confirmed -> roll paused")
        return false
    end

    function RuntimeFix.runAutoTraits()
        local state = RuntimeFix.AutoTrait

        if AutoFarmSession.Cancelled then
            return false
        end

        if game.PlaceId ~= AUTO_JOIN_PLACE_ID then
            return true
        end

        if not state.Enabled then
            return true
        end

        if state.Halted then
            -- Error ไม่ได้แปลว่าได้ Trait เป้าหมายแล้ว
            return RuntimeFix.isTraitReadyForJoin()
        end

        if state.Busy then
            return false
        end

        if os.clock() < state.RetryAt then
            return RuntimeFix.isTraitReadyForJoin()
        end

        if ActiveLobbyQueue then
            if RuntimeFix.isTraitReadyForJoin() then
                return true
            end

            -- ยกเลิกคิวเก่าที่หลุดเข้ามาระหว่างโรล
            if not RuntimeFix.monarchClearQueue() then
                return false
            end

            return false
        end

        -- อนุญาตให้เจ้าของงานเดิมตรวจ Trait และทำงานต่อ
        -- ป้องกันเฉพาะงานอื่นที่พยายามเข้ามาซ้อน
        local owner = coroutine.running()

        if (RuntimeFix.JoinOwner ~= nil
                and RuntimeFix.JoinOwner ~= owner)
            or RuntimeFix.StoredPending
            or RuntimeFix.PreparingTeam
            or RuntimeFix.Crafting
            or AutoRedeemCodesEnabled
            or AutoUnlockSlotsEnabled
            or AutoUpgradeSkillTreeEnabled
            or CustomAutoRollEnabled
        then
            return false
        end

        state.Busy = true

        local ok, runError = pcall(function()
            -- Busy ถูกตั้งไว้แล้ว จึงไม่มี AutoTrait งานอื่นเข้ามาซ้อน
            if not RuntimeFix.clearTraitKeepList() then
                state.RetryAt = os.clock() + 3
                return
            end

            local packets = RuntimeFix.getPackets()

            if not packets.rollTrait
                or type(packets.rollTrait.fire) ~= "function"
                or not packets.traitRolled
                or type(packets.traitRolled.on) ~= "function"
            then
                error("Trait packet API unavailable")
            end

            local traitConfig = RuntimeFix.requireModule(
                ReplicatedStorage,
                { "assets", "config", "Traits", "traitConfig" }
            )

            if type(traitConfig) ~= "table" then
                error("traitConfig is not a table")
            end

            -- Account และผลโรลใช้ trait.Id ไม่ใช่ Array Index
            local traitsById = {}

            for _, trait in pairs(traitConfig) do
                if type(trait) == "table" then
                    local id = tonumber(trait.Id)

                    if id ~= nil then
                        if traitsById[id] ~= nil then
                            error("Duplicate Trait Id: " .. tostring(id))
                        end

                        traitsById[id] = trait
                    end
                end
            end

            -- ตรวจ Target ก่อนใช้รีโรล
            for id, enabled in pairs(state.KeepTraitIds) do
                if enabled and traitsById[id] == nil then
                    error("Target Trait Id not found: " .. tostring(id))
                end
            end

            if not state.Listening then
                local connection = packets.traitRolled:on(function(result)
                    if AutoFarmSession.Cancelled
                        or type(result) ~= "table"
                    then
                        return
                    end

                    local pending = state.Pending

                    if pending
                        and result.character == pending.Character
                        and result.requestId == pending.RequestId
                        and pending.Response == nil
                    then
                        pending.Response = result
                    end
                end)

                table.insert(AutoFarmSession.Cleanups, function()
                    if typeof(connection) == "function" then
                        connection()
                    elseif typeof(connection) == "RBXScriptConnection" then
                        connection:Disconnect()
                    end

                    state.Pending = nil
                    state.Listening = false
                end)

                state.Listening = true
            end

            local function readTrait(data, characterId)
                local characters = data and data.CharactersData
                local character =
                    type(characters) == "table"
                    and characters[characterId]

                local traitData =
                    type(character) == "table"
                    and character.TraitData

                return type(traitData) == "table"
                    and tonumber(traitData.Trait)
                    or nil
            end

            local function readBalance(data)
                local currencies = data and data.currencies

                return type(currencies) == "table"
                    and tonumber(currencies.traitRerolls)
                    or nil
            end

            for _, characterId in ipairs(state.Targets) do
                while not AutoFarmSession.Cancelled do
                    local data, readError = RuntimeFix.readAccount()

                    if not data then
                        error("Account unavailable: " .. tostring(readError))
                    end

                    -- โรลเฉพาะตัวที่อยู่ใน slot ที่ปลดล็อกแล้ว
                    if not RuntimeFix.findOwnedSlot(data, characterId) then
                        break
                    end

                    local traitId = readTrait(data, characterId)

                    if traitId == nil then
                        error("Trait data unavailable: " .. characterId)
                    end

                    if traitId ~= 0 then
                        local trait = traitsById[traitId]

                        if type(trait) ~= "table"
                            or type(trait.Rarity) ~= "string"
                        then
                            error("Unknown Trait config: " .. tostring(traitId))
                        end

                        if state.KeepTraitIds[traitId] then
                            print(
                                "[AutoTrait] Keep:",
                                characterId,
                                "| Trait:",
                                traitId,
                                "| Rarity:",
                                trait.Rarity
                            )
                            break
                        end
                    end

                    local balance = readBalance(data)

                    if balance == nil then
                        error("traitRerolls balance unavailable")
                    end

                    if balance < 1 then
                        state.RetryAt = os.clock() + 30
                        print("[AutoTrait] Not enough traitRerolls")
                        return
                    end

                    -- บันทึกตัวที่กำลังสุ่ม รวมช่วงรอก่อนส่งคำขอ
                    state.CurrentCharacter = characterId

                    local waitTime =
                        state.Interval - (os.clock() - state.LastSentAt)

                    if waitTime > 0 then
                        task.wait(waitTime)
                    end

                    if AutoFarmSession.Cancelled then
                        return
                    end

                    -- อ่านซ้ำก่อนส่ง เพื่อไม่ใช้ข้อมูลก่อนช่วงรอ
                    local latest = RuntimeFix.readAccount()

                    if not latest
                        or not RuntimeFix.traitKeepListCleared(latest)
                        or readTrait(latest, characterId) ~= traitId
                        or readBalance(latest) ~= balance
                        or not RuntimeFix.findOwnedSlot(latest, characterId)
                    then
                        state.RetryAt = os.clock() + 2
                        return
                    end

                    state.RequestId = state.RequestId % 65535 + 1

                    local pending = {
                        Character = characterId,
                        RequestId = state.RequestId,
                        Response = nil,
                    }

                    state.Pending = pending
                    state.LastSentAt = os.clock()

                    packets.rollTrait:fire({
                        character = characterId,
                        requestId = pending.RequestId,
                    })

                    local deadline = os.clock() + state.ResponseTimeout

                    while not pending.Response
                        and not AutoFarmSession.Cancelled
                        and os.clock() < deadline
                    do
                        task.wait(0.1)
                    end

                    if AutoFarmSession.Cancelled then
                        return
                    end

                    local result = pending.Response

                    if not result then
                        error("Trait response timeout: " .. characterId)
                    end

                    if result.success ~= true then
                        state.Pending = nil

                        if result.reason == "Roll is on cooldown" then
                            state.RetryAt = os.clock() + 2
                            warn("[AutoTrait] Cooldown; retry later")
                            return
                        end

                        error(
                            "Trait rejected: " .. tostring(result.reason)
                        )
                    end

                    local rolledId = tonumber(result.traitId)
                    local rolledTrait = rolledId and traitsById[rolledId]

                    if type(rolledTrait) ~= "table"
                        or type(rolledTrait.Rarity) ~= "string"
                    then
                        error("Unknown result Trait: " .. tostring(rolledId))
                    end

                    -- ต้องยืนยัน Trait และยอดที่ใช้แล้วก่อนส่งรอบถัดไป
                    local synced = false
                    local syncDeadline = os.clock() + state.SyncTimeout

                    repeat
                        if AutoFarmSession.Cancelled then
                            return
                        end

                        local updated = RuntimeFix.readAccount()
                        local updatedBalance = readBalance(updated)

                        if readTrait(updated, characterId) == rolledId
                            and updatedBalance ~= nil
                            and updatedBalance <= balance - 1
                        then
                            synced = true
                            break
                        end

                        task.wait(0.1)
                    until os.clock() >= syncDeadline

                    if not synced then
                        error("Trait account sync timeout: " .. characterId)
                    end

                    state.Pending = nil

                    print(
                        "[AutoTrait] Rolled:",
                        characterId,
                        "| Trait:",
                        rolledId,
                        "| Rarity:",
                        rolledTrait.Rarity
                    )

                    if state.KeepTraitIds[rolledId] then
                        break
                    end
                end
            end
        end)

        state.CurrentCharacter = nil
        state.Busy = false

        if not ok then
            state.Halted = true
            state.Pending = nil

            warn(
                "[AutoTrait] Stopped until script restart:",
                runError
            )
        end

        return RuntimeFix.isTraitReadyForJoin()
    end

    RuntimeFix.BathCraftRecipes = {
        RuntimeFix.runtimeAccessory("Capsule Scarf"),
        RuntimeFix.runtimeAccessory("SunGlasses"),
    }

    -- อ่านอย่างเดียว ใช้ทั้งใน Lobby และระบบ Retry
    function RuntimeFix.getBathCraftNeeds(data)
        if type(data) ~= "table"
            or type(data.accessory) ~= "table"
            or type(data.material) ~= "table"
        then
            error("BathTub accessory/material data unavailable")
        end

        for _, recipe in ipairs(RuntimeFix.BathCraftRecipes) do
            if not isAccessoryOwned(data, recipe.Id) then
                local enough = hasCraftMaterials(data, recipe.Materials)

                return recipe, enough
            end
        end

        return nil, true
    end

    -- true = มีทั้งสองชิ้นแล้ว เข้า BathTub ต่อได้
    -- false = กำลังคราฟต์/ฟาร์ม/รอยืนยัน ห้ามเข้า BathTub
    function RuntimeFix.ensureBathAccessories()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        if RuntimeFix.Crafting or ActiveLobbyQueue then
            return false
        end

        if os.clock() < (RuntimeFix.BathCraftRetryAt or 0) then
            return false
        end

        if not RuntimeFix.craftReadyAccessories() then
            return false
        end

        -- มากที่สุดสองสูตร และอ่าน Account ใหม่หลังคราฟต์แต่ละชิ้น
        for _ = 1, 2 do
            local data, readError = RuntimeFix.readAccount()

            if not data then
                error("Bath craft account unavailable: " .. tostring(readError))
            end

            local recipe, enough = RuntimeFix.getBathCraftNeeds(data)

            if not recipe then
                return true
            end

            if enough then
                RuntimeFix.Crafting = true

                local ok, crafted = pcall(function()
                    return craftAccessoryByIndex(
                        recipe.Index,
                        recipe.Id,
                        recipe.Name,
                        recipe.Materials
                    )
                end)

                RuntimeFix.Crafting = false

                if not ok or not crafted then
                    RuntimeFix.BathCraftRetryAt = os.clock() + 5
                    warn(
                        "[BathCraft] Craft not confirmed:",
                        recipe.Name,
                        ok and "Waiting for ownership" or tostring(crafted)
                    )
                    return false
                end
            else
                if not prepareTeam() or AutoFarmSession.Cancelled then
                    return false
                end

                -- ทุกตัวใช้ Medium ขึ้นไป เพราะ Eyeball ไม่ดรอป Easy
                local difficulty = math.max(
                    2,
                    RuntimeFix.getStoryDifficulty(4, true)
                )

                local packets = RuntimeFix.getPackets()

                if not packets.createQuque
                    or type(packets.createQuque.fire) ~= "function"
                then
                    error("createQuque packet unavailable")
                end

                queueScriptOnTeleport()

                local target = RuntimeFix.getBathFarmTarget(data)

                assert(
                    target and target.Map == "hxh",
                    "Bath craft Story target unavailable"
                )

                local queueKey = "BathCraft_Hxh" .. target.Chapter
                ActiveLobbyQueue = queueKey
                LastLobbyJoinAction = autoJoinBestAvailableStory
                LastLobbyJoinAttemptClock = os.clock()

                local ok, err = pcall(function()
                    RuntimeFix.createQueue({
                        gamemode = "Story",
                        map = "Hxh",
                        chapter = target.Chapter,
                        difficulty = difficulty,
                        maxPlayers = 4,
                        friendsOnly = false,
                        roomNumber = CurrentLobbyRoomNumber,
                    })
                end)

                if not ok then
                    if ActiveLobbyQueue == queueKey then
                        ActiveLobbyQueue = nil
                    end

                    RuntimeFix.BathCraftRetryAt = os.clock() + 5
                    error(err)
                end

                print(string.format(
                    "[BathCraft] Need %s -> Hxh Chapter 1 | Difficulty %d",
                    recipe.Name,
                    difficulty
                ))

                return false
            end
        end

        local fresh, readError = RuntimeFix.readAccount()

        if not fresh then
            error("Bath craft confirmation unavailable: " .. tostring(readError))
        end

        local remaining = RuntimeFix.getBathCraftNeeds(fresh)
        return remaining == nil
    end

    function RuntimeFix.getBathFarmTarget(data)
        local recipe, enough = RuntimeFix.getBathCraftNeeds(data)

        if recipe then
            if enough then
                return nil, recipe.Name .. " materials complete -> Lobby to craft"
            end

            local missing = {}

            for _, material in ipairs(recipe.Materials) do
                if getMaterialAmount(data, material[1]) < material[2] then
                    missing[material[1]] = true
                end
            end

            local difficulty = math.max(
                2,
                RuntimeFix.getStoryDifficulty(4, true)
            )

            return RuntimeFix.runtimeMaterialTarget(
                missing,
                difficulty,
                {hxh = true}
            ), "BathTub accessory materials"
        end

        return {
            Map = "spiritedawayraid",
            Chapter = 1,
            Difficulty = 4,
        }, "Hu Tao BathTub resources"
    end

    -- คืน nil = ให้เส้นทางเดิมทำงานต่อ
    -- คืน boolean = เส้นทางนี้เป็นผู้จัดการรอบปัจจุบัน
    function RuntimeFix.routeSukunaProgression()
        if AutoFarmSession.Cancelled
            or game.PlaceId ~= AUTO_JOIN_PLACE_ID
        then
            return false
        end

        local data, readError = RuntimeFix.readAccount()
        if not data then
            error("Cannot read progression: " .. tostring(readError))
        end

        local carrySlot, carryName =
            RuntimeFix.findCraftCarrySlot(data)

        local hasRaidCarry = carrySlot ~= nil

        if not RuntimeFix.canFarmRaid() then
            return nil
        end

        if RuntimeFix.StoredPending or RuntimeFix.Crafting then
            return false
        end

        -- ให้ watchdog เดิมจัดการคิวที่ส่งไปแล้ว
        if ActiveLobbyQueue or AutoJoinStarted then
            return true
        end

        local craftStatus = getBlastArcherCraftNeeds()
        if not craftStatus then
            return false
        end

        -- ขั้น 1: คราฟต์ Crown และ Wings ก่อน
        if not craftStatus.crownOwned or not craftStatus.wingsOwned then
            if next(craftStatus.missing) == nil then
                print("[Progression] Materials ready -> Craft Crown/Wings")
                StartAutoCraftBlastArcher()
                return true
            end

            print("[Progression] Farm Crown/Wings materials")
            return joinBlastArcherMaterialFarm()
        end

        local sukuna = type(data.CharactersData) == "table"
            and data.CharactersData.sukuna

        local evolved = type(sukuna) == "table"
            and sukuna.IsUltimateUnlocked == true

        local gamemode
        local map
        local chapter
        local queueKey

        if RuntimeFix.canFarmRaid() then
            if isHutaoEvolved() then
                return nil
            end

            -- Crown/Wings ผ่านการตรวจด้านบนแล้ว
            -- ตรวจ Scarf/Glasses ให้ครบก่อนเริ่มงาน Hu Tao
            if not RuntimeFix.ensureBathAccessories() then
                return true
            end

            local status = getHutaoEvoStatus()

            if status.waitingForStorage then
                -- watcher Storage เดิมจะนำ Hu Tao ลงช่องที่แทนที่ได้
                return false
            end

            if status.acquiringCharacter then
                print("[Progression] Find Hu Tao -> BathTub Nightmare")
            end

            if status.isReady then
                evolveHutaoIfReady()
                return true
            end

            if status.RuntimeTarget then
                local target = status.RuntimeTarget

                gamemode = target.Map == "hxh" and "Story" or "Raid"

                map = target.Map == "hxh" and "Hxh"
                    or (
                        target.Map == "spiritedawayraid"
                        and "BathTub"
                        or "ShadowGate"
                    )

                chapter = target.Map == "hxh" and target.Chapter or 0

                queueKey =
                    "HuTao_Runtime_" .. target.Map .. "_" .. target.Chapter

            elseif status.missingStage == "Story_Hxh_Nightmare" then
                gamemode = "Story"
                map = "Hxh"
                chapter = 1
                queueKey = "HuTao_Pendant_Hxh1"
            elseif status.missingStage == "Story_Hxh_Chapter3" then
                gamemode = "Story"
                map = "Hxh"
                chapter = 3
                queueKey = "HuTao_Cloth_Hxh3"
            elseif status.missingStage == "Raid_BathTub"
                or status.needCurrency
            then
                if not RuntimeFix.ensureBathAccessories() then
                    return true
                end

                gamemode = "Raid"
                map = "BathTub"
                chapter = 1

                if hasRaidCarry then
                    if carryName == "Mochi Commander" then
                        queueKey = "Katakuri_Ready_BathTub"
                    else
                        queueKey = "Miyabi_Ready_BathTub"
                    end
                else
                    queueKey = "Sukuna_Ready_BathTub"
                end
            else
                return false
            end
        end

        if not prepareTeam() or AutoFarmSession.Cancelled then
            return false
        end

        local packets = RuntimeFix.getPackets()
        if not packets.createQuque
            or type(packets.createQuque.fire) ~= "function"
        then
            error("createQuque packet unavailable")
        end

        queueScriptOnTeleport()

        ActiveLobbyQueue = queueKey
        LastLobbyJoinAction = autoJoinBestAvailableStory
        LastLobbyJoinAttemptClock = os.clock()

        RuntimeFix.createQueue({
            gamemode = gamemode,
            map = map,
            chapter = chapter,
            difficulty = 4, -- เส้นทางนี้ฟาร์ม Evo ด้วย Nightmare
            maxPlayers = 4,
            friendsOnly = false,
            roomNumber = CurrentLobbyRoomNumber,
        })

        print(string.format(
            "[Progression] %s | %s Chapter %d | Nightmare | Room %d",
            gamemode,
            map,
            chapter,
            CurrentLobbyRoomNumber
        ))

        return true
    end

    -- อ่านอย่างเดียว: ไม่สร้างคิว ไม่คราฟต์ และไม่ส่ง Evo
    function RuntimeFix.getNextFarmStage()
        local data, readError = RuntimeFix.readAccount()
        if not data then
            error("Account unavailable: " .. tostring(readError))
        end

        if type(data.material) ~= "table"
            or type(data.currencies) ~= "table"
            or type(data.CharactersData) ~= "table"
        then
            error("Account resources unavailable")
        end

        local function stage(map, chapter, difficulty)
            return {
                Map = map,
                Chapter = chapter,
                Difficulty = difficulty,
            }
        end

        local function story(chapter, difficulty)
            return stage(
                "hxh",
                chapter,
                RuntimeFix.getStoryDifficulty(difficulty)
            )
        end

        local function evolved(character)
            local entry = data.CharactersData[character]
            return type(entry) == "table"
                and entry.IsUltimateUnlocked == true
        end

        if RuntimeFix.trialsEvolutionComplete(data) then
            return {
                Map = "sololevelingraid",
                Chapter = 1,
                Difficulty = 4,
            }, "Endless Shadow Gate"
        end

        local readyCraft = RuntimeFix.getReadyAccessoryCraft(data)

        if readyCraft then
            return nil,
                readyCraft.Name .. " ready -> Lobby to craft"
        end

        -- ทำอุปกรณ์ให้ครบก่อนเริ่มงาน Hu Tao / Monarch
        if RuntimeFix.canFarmRaid() then
            local craftRecipe = nil

            if not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
            ) then
                craftRecipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Crown
            elseif not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            ) then
                craftRecipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Wings
            end

            if craftRecipe then
                local missing = {}

                for id, required in pairs(craftRecipe.materials) do
                    if getMaterialAmount(data, id) < required then
                        missing[id] = true
                    end
                end

                if next(missing) == nil then
                    return nil, "Craft materials complete -> Lobby to craft"
                end

                local target = getBlastArcherFarmStage({
                    missing = missing,
                })

                if not target then
                    error("No craft stage for missing materials")
                end

                return stage(
                    "hxh",
                    target.chapter,
                    RuntimeFix.getStoryDifficulty(
                        target.difficulty,
                        true
                    )
                ), "Crown/Wings materials"
            end

            if not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Capsule Scarf").Id
            )
                or not isAccessoryOwned(
                    data,
                    RuntimeFix.runtimeAccessory("SunGlasses").Id
                )
            then
                return RuntimeFix.getBathFarmTarget(data)
            end
        end

        local allAccessoriesOwned =
            isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
            ) -- Crown
            and isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            ) -- Wings
            and isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Capsule Scarf").Id
            ) -- Capsule Scarf
            and isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("SunGlasses").Id
            ) -- Sun Glasses

        if allAccessoriesOwned
            and RuntimeFix.canFarmRaid()
            and not evolved("hutao")
        then
            local status = getHutaoEvoStatus()

            if status.RuntimeTarget then
                return status.RuntimeTarget, "Hu Tao runtime resources"
            end

            if status.waitingForStorage then
                return nil, "Hu Tao in Storage -> Lobby to retrieve"
            end

            if status.acquiringCharacter then
                return stage("spiritedawayraid", 1, 4),
                    "Find Hu Tao in BathTub"
            end

            if status.isReady then
                return nil, "Hu Tao resources complete -> Lobby for Evo"
            end

            if status.missingStage == "Raid_BathTub"
                or status.needCurrency
            then
                return stage("spiritedawayraid", 1, 4),
                    "Hu Tao BathTub resources"
            elseif status.missingStage == "Story_Hxh_Nightmare" then
                return stage("hxh", 1, 4), "Hu Tao Magic Pendant"
            elseif status.missingStage == "Story_Hxh_Chapter3" then
                return stage("hxh", 3, 4), "Hu Tao Fine Cloth"
            end

            -- ข้อมูลไม่พร้อม: ไม่เดาเป้าหมายแล้วส่ง Leave
            error("Hu Tao progression data unavailable")
        end

        -- Jinwoo: ใช้ลำดับสูตร Monarch เดิม
        if RuntimeFix.findOwnedSlot(data, "sung_jinwoo") then
            local currentStage = RuntimeFix.monarchStage(data)
            if currentStage >= 3 then
                local plan = RuntimeFix.getPostMonarchPlan(data)

                if plan then
                    return plan.Target, plan.Reason
                end

                local igrisPlan = RuntimeFix.getIgrisPlan(data)

                if igrisPlan then
                    -- Target มีค่า: ฟาร์ม Shadow Gate ต่อ
                    -- Target เป็น nil: กลับ Lobby เพื่อ Upgrade
                    return igrisPlan.Target, igrisPlan.Reason
                end

                local trialsTask, needsStorage =
                    RuntimeFix.getTrialsTask(data)

                if trialsTask then
                    return nil,
                        needsStorage
                            and (trialsTask.Name .. " -> Lobby for Storage")
                            or (trialsTask.Name .. " -> Lobby for Trials")
                end

                local evolution =
                    RuntimeFix.getTrialsEvolutionPlan(data)

                if evolution then
                    return evolution.Target, evolution.Reason
                end

                return nil, "Trials characters and Evolution complete"
            end

            local recipe = RuntimeFix.MonarchRecipes[currentStage + 1]
            if type(recipe) ~= "table" then
                error("Monarch recipe unavailable")
            end

            local missingMaterials = {}

            for id, required in pairs(recipe.Materials) do
                if getMaterialAmount(data, id) < required then
                    missingMaterials[id] = true
                end
            end

            local runtimeTarget =
                RuntimeFix.runtimeMaterialTarget(missingMaterials, 4)

            local needStory =
                runtimeTarget ~= nil and runtimeTarget.Map == "hxh"

            local needRaid =
                runtimeTarget ~= nil and runtimeTarget.Map ~= "hxh"

            local money = tonumber(data.currencies.money)
            local gems = tonumber(data.currencies.gems)
            if not money or not gems then
                error("Money/Gems unavailable")
            end

            if money < recipe.Money or gems < recipe.Gems then
                needRaid = true
            end

            if not needStory and not needRaid then
                return nil, "Monarch resources complete -> Lobby for Evo"
            end

            if runtimeTarget and RuntimeFix.canFarmRaid() then
                return runtimeTarget, "Monarch runtime materials"
            end

            if needStory or not RuntimeFix.canFarmRaid() then
                return stage(
                    "hxh",
                    runtimeTarget and runtimeTarget.Chapter or 1,
                    4
                ),
                    "Monarch Story resources"
            end

            return stage("sololevelingraid", 1, 4),
                "Monarch Raid resources"
        end

        local carrySlot = RuntimeFix.findCraftCarrySlot(data)
        local hasSukuna = RuntimeFix.findOwnedSlot(data, "sukuna") ~= nil
        local hutaoEvolved = evolved("hutao")

        -- Crown ก่อน Wings ตามระบบคราฟต์เดิม
        if carrySlot or hasSukuna or hutaoEvolved then
            local recipe

            if not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
            ) then
                recipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Crown
            elseif not isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            ) then
                recipe = BLAST_ARCHER_CRAFT_REQUIREMENTS.Wings
            end

            if recipe then
                local missing = {}

                for id, required in pairs(recipe.materials) do
                    if getMaterialAmount(data, id) < required then
                        missing[id] = true
                    end
                end

                if next(missing) == nil then
                    return nil, "Craft materials complete -> Lobby to craft"
                end

                local target = getBlastArcherFarmStage({missing = missing})
                if not target then
                    error("No craft stage for missing materials")
                end

                return stage(
                    "hxh",
                    target.chapter,
                    RuntimeFix.getStoryDifficulty(target.difficulty, true)
                ), "Crown/Wings materials"
            end
        end

        -- ฟาร์มของ Evo Hu Tao ตามของที่ยังขาด
        if not hutaoEvolved
            and (
                hasSukuna
                or carrySlot
                or RuntimeFix.findOwnedSlot(data, "hutao")
            )
        then
            local status = getHutaoEvoStatus()

            if status.RuntimeTarget then
                return status.RuntimeTarget, "Hu Tao runtime resources"
            end

            if status.isReady then
                return nil, "Hu Tao resources complete -> Lobby for Evo"
            end

            if status.missingStage == "Raid_BathTub" then
                if RuntimeFix.canFarmRaid() then
                    return RuntimeFix.getBathFarmTarget(data)
                end

                return nil, "No raid character equipped -> Lobby"
            elseif status.missingStage == "Story_Hxh_Nightmare" then
                return stage("hxh", 1, 4), "Hu Tao Magic Pendant"
            elseif status.missingStage == "Story_Hxh_Chapter3" then
                return stage("hxh", 3, 4), "Hu Tao Fine Cloth"
            elseif status.needCurrency then
                if RuntimeFix.canFarmRaid() then
                    return RuntimeFix.getBathFarmTarget(data)
                end
            end

            return nil, "Return to Lobby to select next task"
        end

        -- หา Jinwoo หลังอุปกรณ์ครบ ตามสิทธิ์ Shadow Gate เดิม
        if isAccessoryOwned(
            data,
            RuntimeFix.runtimeAccessory("Blast Archer Crown").Id
        )
            and isAccessoryOwned(
                data,
                RuntimeFix.runtimeAccessory("Blast Archer Wings").Id
            )
            and RuntimeFix.canFarmRaid()
        then
            if RuntimeFix.storageCount(data, "sung_jinwoo") > 0 then
                return nil, "Jinwoo in Storage -> Lobby"
            end

            return stage("sololevelingraid", 1, RuntimeFix.getStoryDifficulty(4)),
                "Farm Sung Jinwoo"
        end

        return nil, "No active craft/Evo farming target"
    end

